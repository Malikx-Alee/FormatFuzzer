int PlantStr( int64 p, string v ) {
    local int evil_st = SetEvilBit(false);  PTY[0] = v;  ReadBytes(PBUF, p, 4, PTY);  SetEvilBit(evil_st);  return 0; }
// Every container's children, planted one at a time so each child's own size is
// known before its header is written. structure[10] puts mvhd first, structure[2]
int PlanChild( string ct, int64 i ) {
    local int64 t = G_trk;  local int64 p = FTell();  local int64 j = 0;  local int64 c = 0;
    local int64 n = 0;  local string cb = "free";  if( ct == "moov" ) {
        if( i == 0 ) { PlantBox("mvhd", 100);  PutU8(p + 8, 0);  return 0; }
        if( i <= G_ntrk ) { G_trk = i - 1;  PlantBox("trak", TrakSize(i - 1));  return 0; }  PlantBox("mvex", MvexSize());  return 0; }
    if( ct == "trak" ) {
        if( i == 0 ) {
            PlantBox("tkhd", 84);  PutU8(p + 8, 0);  T_tid[t] = ReadUInt(p + 20);   // a free draw that also tells the fragment
            return 0; }  // headers which track_id to reference
        if( i == 1 && T_ed[t] > 0 ) { PlantBox("edts", 16 + 12 * T_ed[t]);  return 0; }  PlantBox("mdia", MdiaSize(t));  return 0; }
    if( ct == "edts" ) {
        PlantBox("elst", 8 + 12 * T_ed[t]);  PutU8(p + 8, T_ver[t]);  PutU32(p + 12, T_ed[t]);  return 0; }   // num_entries, Tier A
    if( ct == "mdia" ) {
        if( i == 0 ) { PlantBox("mdhd", 24);  PutU8(p + 8, 0);  return 0; }  if( i == 1 ) {
            PlantBox("hdlr", 20 + G_hdlrRest);  PutU8(p + 8, T_ver[t]);  ReadBytes(PBUF, p + 12, 4, HTYPE);   // constraints.mp4box.type
            PlantStr(p + 16, HDLR[T_sub[t]]);  return 0; }   // constraints.mp4box.subtype
        PlantBox("minf", MinfSize(t));  return 0; }
    if( ct == "minf" ) {
        if( i == 0 ) {
            if( T_sub[t] == 0 ) PlantBox("vmhd", 12);            // dependencies[10]
            else if( T_sub[t] == 1 ) PlantBox("smhd", 8);        // dependencies[11]
            else PlantBox("nmhd", 4);  PutU8(p + 8, T_ver[t]);  if( T_sub[t] != 0 ) PutU8(p + 11, 1);   // vmhd's flags byte is a bitfield and
            return 0; }  // cannot carry a lookahead
        if( i == 1 ) { PlantBox("dinf", 28);  return 0; }  PlantBox("stbl", StblSize(t));  return 0; }   // structure[12]
    if( ct == "stbl" ) {
        cb = StblChild(t, i);  PlantBox(cb, StblChildSize(t, i));  PutU8(p + 8, T_ver[t]);   // Tier B: both versions
        if( cb == "stsd" ) { PutU32(p + 12, T_nsd[t]);  return 0; }  if( cb == "stts" ) { PutU32(p + 12, T_runs[t]);  return 0; }
        if( cb == "stss" ) { PutU32(p + 12, T_kf[t]);  return 0; }  if( cb == "stsc" ) {
            PutU32(p + 12, T_nsc[t]);
            if( T_nsc[t] > 0 )                                // str_stsc.first_chunk is 1,
            {                                                 // then strictly increasing
                PutU32(p + 16, 1);  PutU32(p + 20, T_spc[t]);  if( T_sdi[t] ) PutU32(p + 24, T_sdi[t]); }   // dependencies[15]
            if( T_nsc[t] > 1 ) {
                PutU32(p + 28, T_nch[t]);  PutU32(p + 32, T_ns[t] - T_spc[t] * (T_nch[t] - 1));
                if( T_sdi[t] ) PutU32(p + 36, T_sdi[t]); }  // dependencies[15]
            return 0; }
        if( cb == "stsz" ) {
            PutU32(p + 12, T_cst[t]);  PutU32(p + 16, T_ns[t]);        // dependencies[8]
            if( T_cst[t] == 0 )
                for( j = 0; j < T_ns[t]; j++ ) PutU32(p + 20 + 4 * j, SampSize(t, j));
            return 0; }
        if( cb == "stco" ) {
            PutU32(p + 12, T_nch[t]);  for( c = 0; c < T_nch[t]; c++ ) PutU32(p + 16 + 4 * c, ChunkOff(t, c));  return 0; }   // dependencies[19]
        if( cb == "co64" ) {
            PutU32(p + 12, T_nch[t]);  for( c = 0; c < T_nch[t]; c++ ) PutU64(p + 16 + 8 * c, ChunkOff(t, c));  return 0; }
        if( cb == "saiz" ) {
