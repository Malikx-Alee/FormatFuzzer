// constraints.mp4box.entries (Tier A, payload_wellformedness). The framing that
// MEASURED as the difference between a stream and no stream at all: six zero
int PlanEntry( int64 t, int64 i ) {
    local int64 p = FTell();  local int64 k = T_kind[t];  if( i > 0 && k >= 12 && k <= 13 ) { PlantBox("enca", 28); return 0; }
    PlantBox(CodecName(t), EntrySize(t) - 8);  PutU8(p + 8, 0);   PutU8(p + 9, 0);   PutU8(p + 10, 0);
    PutU8(p + 11, 0);  PutU8(p + 12, 0);  PutU8(p + 13, 0);  PutU16(p + 14, 1);  if( k == 14 ) return 0;  if( k >= 12 ) {
        PutU16(p + 24, T_ch[t]);  PutU16(p + 26, 16);  PutU32(p + 32, (T_mts[t] % 65536) * 65536);  return 0; }
    PutU16(p + 32, T_w[t]);  PutU16(p + 34, T_h[t]);  PutU16(p + 48, 1);   // derives_from width/height frame_count
    PutU16(p + 82, T_dep[t]);  return 0; }   // depth picks the pixel format
int PlanCfg( int64 t ) {
    local int64 p = FTell();  local int64 i = 0;  local int64 k = T_kind[t];
    if( k == 11 ) { PlantBox("sinf", 72 + 9 * T_aux[t]);  return 0; }  if( k == 7 ) {
        PlantBox("avcC", 38);  PutU8(p + 8, 1);   // configurationVersion, ISO 14496-15
        PutU8(p + 12, 255);  PutU8(p + 13, 225);   // lengthSizeMinusOne = 3 one sequence parameter set
        PutU16(p + 14, 22);  PutU8(p + 38, 1);  PutU16(p + 39, 5);  if( T_cfg[t] ) {
            for( i = 0; i < 22; i++ ) PutU8(p + 16 + i, SPSB[i]);  for( i = 0; i < 5; i++ )  PutU8(p + 41 + i, PPSB[i]); }
        return 0; }
    if( k == 8 ) {
