    PlantBox("esds", 31);  if( T_cfg[t] ) { for( i = 0; i < 27; i++ ) PutU8(p + 12 + i, ESDA[i]); }  return 0; }
// meta.unnamed_payloads: mdat has no field in this template, so its framing is
// written here. For an AVC track that is a run of (4-byte big-endian length,
int WriteMedia() {
    local int64 t = 0;  local int64 i = 0;  local int64 p = 0;  local int64 sz = 0;  for( t = 0; t < G_ntrk; t++ ) {
        if( T_kind[t] == 7 )
