        if( T_ss[t] ) for( j = 0; j < T_ns[t]; j++ ) PutU16(p + 24 + 16 * j, 1);  return 0; }
    if( ct == "udta" ) { PlantBox("free", 8);  return 0; }
    if( ct == "dinf" ) { PlantBox("dref", 20);  PutU8(p + 8, 0);  PutU32(p + 12, 1);  return 0; }
    if( ct == "dref" ) { PlantBox("url ", 4);  PutU8(p + 8, 0);  PutU8(p + 11, 1);  return 0; }  if( ct == "mvex" ) {
        if( i == 0 ) { PlantBox("mehd", 8);  PutU8(p + 8, 0);  return 0; }  PlantBox("trex", 24);  PutU8(p + 8, 0);
        if( i <= G_ntrk ) PutU32(p + 12, T_tid[i - 1]);    // dependencies[16]: each trex
        else PutU32(p + 12, T_tid[0]);  PutU32(p + 16, 1);   // names a real track dependencies[15] again: the
        PutU32(p + 24, G_fsz);  return 0; }   // fragment defaults must resolve
    if( ct == "moof" ) {
        if( i == 0 ) { PlantBox("mfhd", 8);  PutU8(p + 8, 0);  PutU32(p + 12, G_fragSeq);  return 0; }  PlantBox("traf", TrafSize());  return 0; }
    if( ct == "traf" ) {
        if( i == 0 ) {
            PlantBox("tfhd", TfhdSize());                        // constraints.mp4box.flag
            PutU8(p + 8, 0);  PutU8(p + 9, G_tfhd0);  PutU8(p + 10, 0);  PutU8(p + 11, G_tfhdF);
            PutU32(p + 12, T_tid[0]);  if( G_tfhdF & 1 ) PutU64(p + 16, G_moofPos);   // dependencies[16]: matching the run's samples are
            j = p + 16 + 8 * Bits(G_tfhdF, 1);  if( G_tfhdF & 2 ) { PutU32(j, 1);  j += 4; }  if( G_tfhdF & 8 ) j += 4;   // addressed from the moof
            if( G_tfhdF & 16 ) PutU32(j, G_fsz);  return 0; }   // a zero-length fragment sample aborts the parse
        PlantBox("trun", TrunSize());  PutU8(p + 8, T_ver[0]);
        PutU8(p + 9, G_trunF / 65536);  PutU8(p + 10, (G_trunF / 256) % 256);  PutU8(p + 11, G_trunF % 256);
        PutU32(p + 12, G_fsn);                                   // sample_count, Tier A
        if( G_trunF & 1 ) PutU32(p + 16, MoofSize() + 16);  if( G_trunF & 512 ) {   // data_offset sample-size-present
            c = p + 16 + 4 * Bits(G_trunF, 1) + 4 * Bits(G_trunF, 4) + 4 * Bits(G_trunF, 256);
            j = 4 * (Bits(G_trunF, 256) + Bits(G_trunF, 512)
