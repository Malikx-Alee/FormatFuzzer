        else { T_runs[t] = 0;  T_kf[t] = 0; }  if( T_runs[t] > T_ns[t] ) T_runs[t] = T_ns[t];
        if( T_kf[t] > T_ns[t] ) T_kf[t] = T_ns[t];  T_cst[t] = 0;   // dependencies[8]
