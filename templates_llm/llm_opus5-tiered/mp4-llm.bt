    G_fsz = T_base[0];  if( G_fsz < 1 ) G_fsz = 16;   // a fragment sample is the same shape as the track's own samples
    if( G_nfrag * (MoofSize() + 8 + G_fsn * G_fsz) > B_MOOF ) G_nfrag = 0;  G_moovLen = MoovSize();
