		// parse-only here - see structure[21] in the report.
		byte extension_code = { 0x11, 0x13 } <format=hex>;
		switch (extension_code) {
			case 0x10:
				local quad JpegFileEnd2 = JpegFileEnd;
				JpegFileEnd = FTell() + szSection - 8;
				struct JPGFILE thumbnail;
				JpegFileEnd = JpegFileEnd2;
				break;
			case 0x11:
				ubyte xThumbnail;               // Tier C
				ubyte yThumbnail;               // Tier C
				struct {
					uchar r, g, b;
				} palette[256];
				local int64 px = Room( 64 );
				uchar pixel[px];                // Tier C: free bytes
				break;
			case 0x13:
				ubyte xThumbnail;               // Tier C
				ubyte yThumbnail;               // Tier C
				local int64 qx = xThumbnail;  local int64 qy = yThumbnail;
				if( 3 * qx * qy > Room( 3 * qx * qy ) ) {
					local int evil_qt = SetEvilBit(false);
					FSeek( FTell() - 2 );  ubyte xThumbnail = { 0 };  ubyte yThumbnail = { 0 };
					SetEvilBit(evil_qt);  qx = 0;  qy = 0;
				}
				struct {
					uchar r, g, b;
				} pixel[qx * qy];
				break;
			default:
				//Warning("Unknown JFXX");
				char unknown[szSection - 8];
		}
