		//Warning("Unknown APP14");
		local int64 ue = Room( (szSection - 2) & 0x03FF );
		if( ue < 5 ) ue = 5;   // the branch lookahead committed 5 bytes
		char unknown[ue];               // Tier C: free bytes, free length
	}
} APP14;

// ------------------------------------------------------------
// ------------------------------------------------------------
// JPEG segments
typedef struct tagSOS {
	local int evil_so = SetEvilBit(false);
	M_ID marker = { M_SOS };
	SetEvilBit(evil_so);
	WORD szSection;                 // Tier A: 6 + 2*nr_comp, written back by the caller
	// dependencies[15]/[16]: at most 4, and at most the frame's component count. When the
	// scan is interleaved the sum of Hi*Vi over its components may not exceed 10 - taking
	// a single-component scan is how that is satisfied without narrowing any sampling
	// factor, and a non-interleaved scan is a large decoder path in its own right.
	local ubyte sn1[] = { 1 };
	local ubyte sn2[] = { 1, 1, 2 };
	local ubyte sn3[] = { 1, 1, 2, 3 };
	local ubyte sn4[] = { 1, 1, 2, 3, 4 };
	local int evil_sn = SetEvilBit(false);
	if( g_units > 10 || g_nf < 2 ) g_sn = ReadUByte( FTell(), sn1 );
	else if( g_nf == 2 )           g_sn = ReadUByte( FTell(), sn2 );
	else if( g_nf == 3 )           g_sn = ReadUByte( FTell(), sn3 );
	else                           g_sn = ReadUByte( FTell(), sn4 );
	SetEvilBit(evil_sn);
	ubyte nr_comp;                  // Tier A, bare - takes the value committed above
	ChangeColor(0);
	local int si = 0;
	local ubyte cid1[1];
	// dependencies[13]: naming a table that was never defined raises JERR_NO_HUFF_TABLE.
	// With no DHT at all libjpeg substitutes its standard tables, which cover 0 and 1.
	hdv[0]=0; hdv[1]=0; hdv[2]=0; hdv[3]=0; hdv[4]=0; hdv[5]=0;
	if( g_ndht >= 2 ) { hdv[2]=1; hdv[3]=1; }
	if( g_ndht >= 3 ) hdv[4]=2;
	if( g_ndht >= 4 ) hdv[5]=3;
	struct COMPSOS {
        // dependencies[14]: the frame must declare a component with this id - libjpeg
        // refuses the file outright for a mismatch - so it is taken from the frame.
        // COMPSOS.AC and COMPSOS.DC are the two nibbles of one byte and are Tier A: an
        // undefined destination raises JERR_NO_HUFF_TABLE.
        cid1[0] = (ubyte)g_cid[si];
        local int evil_cs = SetEvilBit(false);
        ReadUByte( FTell(), cid1 );
        SetEvilBit(evil_cs);
        ubyte compId;
		ubyte AC:4 <values=hdv>;
		ubyte DC:4 <values=hdv>;
		si++;
	} comp[nr_comp];
	// dependencies[2]-[9]: the spectral selection and successive approximation are fixed
	// by the frame type. SOF0/SOF1 demand Ss=0 Se=63 Ah=Al=0; SOF2 with a multi-component
	// scan demands Ss=Se=0 (the DC scan); SOF2 with one component may take an AC band;
	// SOF3 takes a predictor 1..7 in Ss and refuses 0 and 8.
	local ubyte ss_seq[] = { 0 };
	local ubyte se_seq[] = { 63 };
	local ubyte ss_dc[]  = { 0 };
	local ubyte se_dc[]  = { 0 };
	local ubyte ss_ac[]  = { 0, 0, 0, 1, 1, 2, 3, 5, 8, 16, 32 };
	local ubyte ss_ls[]  = { 1, 1, 1, 2, 3, 4, 5, 6, 7 };
	// dependencies[4]/[5]: a sequential scan demands Ah = Al = 0; a progressive or
	// lossless first scan may carry a point transform.
	alv[0]=0; alv[1]=0; alv[2]=0;
	if( g_sofm >= 0xFFC2 && g_sofm != 0xFFC9 ) { alv[3]=1; alv[4]=2; alv[5]=3; }
	else { alv[3]=0; alv[4]=0; alv[5]=0; }
	local int evil_sp = SetEvilBit(false);
	local int64 pss = 0;
	if( g_sofm == 0xFFC2 || g_sofm == 0xFFCA ) {
		if( g_sn > 1 ) { ReadUByte( FTell(), ss_dc );  ReadUByte( FTell()+1, se_dc ); }
		else {
			pss = ReadUByte( FTell(), ss_ac );
			if( pss == 0 ) ReadUByte( FTell()+1, se_dc );
			else           ReadUByte( FTell()+1, se_seq );
		}
	} else if( g_sofm == 0xFFC3 || g_sofm == 0xFFCB ) {
		ReadUByte( FTell(), ss_ls );  ReadUByte( FTell()+1, se_dc );
	} else {
		ReadUByte( FTell(), ss_seq );  ReadUByte( FTell()+1, se_seq );
	}
	SetEvilBit(evil_sp);
	uchar Ss;                       // bare - both take the values committed above
	uchar Se;
	uchar Ah : 4 <values=ah0>;
	uchar Al : 4 <values=alv>;
} SOS;

typedef struct tagUNK {
	M_ID UnknownMarker;             // Tier B, pinned by the marker lookahead in the loop
	//Warning("Unknown Section 0x%08x %s", UnknownMarker, EnumToString(UnknownMarker));
	WORD szSection;                 // Tier A: written back from the body actually emitted
	// local copy: comparing the FIELD to a constant would mine that constant into the
	// class every marker in this template shares.
	local int64 um = UnknownMarker;
	// payload_wellformedness: for three marker values libjpeg parses these bytes as a
	// real segment body. 0xFFC9-0xFFCB are arithmetic frame headers, and because the
	// dispatch switch routes only SOF0-SOF3 to SOFx this branch is the ONLY route to
	// libjpeg's arithmetic decoder; 0xFFCC is the conditioning table, range-checked;
	// 0xFFDC is a two-byte line count. Every other marker takes free bytes.
	if (um >= 0xFFC9 && um <= 0xFFCB) {
		local int64 ay = ReadUShort( FTell() + 1 );     // free draw: the frame geometry,
		local int64 ax = ReadUShort( FTell() + 3 );     // the same axes SOFx exposes
		local int64 ac = ReadUByte( FTell() + 6 );
		local int evil_ah = SetEvilBit(false);
		ubyte unknown = { 8 };                          // P = 8
		SetEvilBit(evil_ah);
		ubyte unknown;  ubyte unknown;                  // Y, big-endian
		ubyte unknown;  ubyte unknown;                  // X, big-endian
		local int evil_an = SetEvilBit(false);
		ubyte unknown = { 1 };                          // Nf = 1
		SetEvilBit(evil_an);
		ubyte unknown;                                  // Ci: Tier C, free
		local int evil_ag = SetEvilBit(false);
		ubyte unknown = { 0x11 };                       // H = 1, V = 1
		ubyte unknown = { 0 };                          // Tq = 0
		SetEvilBit(evil_ag);
		g_W = ax;  g_H = ay;  g_nf = 1;  g_units = 1;
		g_h[0] = 1;  g_v[0] = 1;  g_cid[0] = ac;  g_hmax = 1;  g_vmax = 1;
		g_sofm = um;  g_arith = 1;  g_state = 2;
	} else if (um == 0xFFCC) {
		// Tc is the high nibble and Tb the low; for a DC table the low nibble of Cs must
		// not exceed its high nibble, and for an AC table Cs must be 1..63.
		local int evil_ad2 = SetEvilBit(false);
		ubyte unknown = { 0x00, 0x01, 0x02, 0x03 };
		ubyte unknown = { 0x00, 0x40, 0x51, 0x10 };
		ubyte unknown = { 0x10, 0x11, 0x12, 0x13 };
		ubyte unknown = { 1, 5, 32, 63 };
		SetEvilBit(evil_ad2);
	} else if (um == 0xFFDC) {
		ubyte unknown;  ubyte unknown;                  // DNL: number of lines, free
	} else if (FTell() + szSection - 2 >= JpegFileEnd) {
		Warning("unknown section length pass the end of jpeg file");
		ubyte unknown[JpegFileEnd - FTell()];
	} else {
		local int64 uk = Room( (szSection - 2) & 0x03FF );
		ubyte unknown[uk];              // Tier C: free bytes, free length
	}
} UNKNOWN;

typedef struct tagDHT {
	local int evil_dh = SetEvilBit(false);
	M_ID marker = { M_DHT };
	SetEvilBit(evil_dh);
	WORD szSection;                 // Tier A: written back from the tables actually emitted
	local WORD huffsz = szSection - 2;
	// structure[7]: one segment carries one or more tables back to back. Both classes of
	// all four destinations are defined here so that COMPSOS.DC and COMPSOS.AC stay free
	// across their whole Tier A range without ever naming a table that does not exist.
	local int ht = 0;
	local ubyte hti[1];
	local ubyte hz[] = { 0 };
	local ubyte hb[] = { 0, 0, 0, 1, 1, 2, 3, 4, 5 };
	local ubyte hs[] = { 0, 0, 1 };
	local ubyte hv0[] = { 0 };
	while(ht < 8) {
		ChangeColor(0);
		struct Huffmann_Table {
			// Tier A: class<<4 | destination. Anything outside the eight legal values
			// gives 'Bogus DHT index N'.
			hti[0] = (ubyte)(((ht & 1) * 16) + (ht >> 1));
			local int evil_hi = SetEvilBit(false);
			ReadUByte( FTell(), hti );
			SetEvilBit(evil_hi);
			ubyte htInfo;
			local int64 hcls = hti[0];
			// payload_wellformedness: length[] is a canonical Huffman code specification,
			// not data. With c_0 = 0 and c_l = (c_{l-1} << 1) + n_l, every c_l must stay
			// STRICTLY below 2^l - a code that exactly fills the space is rejected - or
			// libjpeg refuses the whole file with 'Bogus Huffman table definition' and
			// writes no output at all. The count at each length is therefore drawn from
			// the set the code space still allows, which keeps the shape free and legal.
			local int64 hc = 0;  local int64 hl = 0;  local int64 hn = 0;
			local int64 hsum = 0;  local int64 hfirst = 0;  local int64 hp = FTell();
			local int evil_hn = SetEvilBit(false);
			for( hl = 1; hl <= 16; hl++ ) {
				if( 2*hc + 1 >= (1 << hl) || hsum >= 250 ) hn = ReadUByte( hp + hl - 1, hz );
				else if( (1 << hl) - 2*hc > 8 )            hn = ReadUByte( hp + hl - 1, hb );
				else                                       hn = ReadUByte( hp + hl - 1, hs );
				if( hn > 0 && hfirst == 0 ) hfirst = hl;
				hsum += hn;  hc = 2*hc + hn;
			}
			SetEvilBit(evil_hn);
			ubyte length[16];       // bare - takes the sixteen counts committed above
			local int sumLen = 0;
			local int i = 0;
			for(;i<16;i++) {
				sumLen += length[i];
			}
			// Tier A: exactly sum(length) symbols, and dependencies[29] - every symbol in
			// a DC table must be 0..15 or the file is refused. Symbol 0 takes the shortest
			// codeword: DC category 0 means a difference of exactly zero and AC 0x00 is
			// EOB, which is what the all-zeros scan below decodes as.
			local int64 vp = FTell();  local int64 hsym0 = 0;
			local int evil_hv = SetEvilBit(false);
			for( i = 0; i < sumLen; i++ ) {
				if( hcls < 16 ) {
					// dependencies[29]: a DC symbol is a magnitude category 0..15, and it
					// says how many raw bits follow the codeword. Leaving it free is what
					// makes the decoded coefficient non-zero, so libjpeg dequantizes and
					// runs a real IDCT rather than its all-zero shortcut.
					if( i == 0 ) hsym0 = ReadUByte( vp + i, dcv );
					else         ReadUByte( vp + i, dcv );
				}
				else if( i == 0 ) ReadUByte( vp + i, hv0 );   // AC symbol 0 is EOB
			}
			SetEvilBit(evil_hv);
			ubyte HTV[sumLen];      // bare - takes the symbols committed above
			if( hfirst < 1 ) hfirst = 2;
			if( hcls < 16 ) { g_dcl[hcls & 3] = hfirst;  g_dcx[hcls & 3] = hsym0; }
			else            g_acl[hcls & 3] = hfirst;
		} huff_table;
		huffsz -= sizeof(huff_table);
		ht++;
		if( ht >= 4 && Room(320) < 320 ) break;
	}
	g_ndht = ht >> 1;   // destination pairs actually defined
} DHT;

typedef struct tagDQT {
	local int evil_dq = SetEvilBit(false);
	M_ID marker = { M_DQT };
	SetEvilBit(evil_dq);
	WORD szSection;                 // Tier A: written back from the tables actually emitted
	local WORD qtsz = szSection - 2;
	// structure[8] / dependencies[12]: every destination a frame component names must be
	// defined before the scan and an undefined one is FATAL - 'Quantization table 0x01
	// was not defined', no output - so one segment defines all four.
	local int qi = 0;
	local ubyte tqv[1];
	while(qi < 4) {
		ChangeColor(0);
		struct QuanTable {
			// Pq is Tier B {0,1} and Tq is Tier A {0..3}; they are the two nibbles of one
			// byte, so both are committed together here and declared bare.
			tqv[0] = (ubyte)qi;
			uchar Pq : 4 <values=q1>;
			uchar Tq : 4 <values=tqv>;
			// local copy: `Pq == 0` would mine 0 into Pq and delete the 16-bit table.
			local int64 pq = Pq;
			if (pq == 0)
				byte qTable[64];        // Tier C: free coefficients
			else
				uint16 qTable[64];      // Tier C, dependencies[30]: read big-endian
		} qtable;
		qtsz -= sizeof(qtable);
		qi++;
	}
} DQT;

typedef struct tagDRI {
	local int evil_dr = SetEvilBit(false);
	M_ID marker = { M_DRI };
	SetEvilBit(evil_dr);
	WORD szSection;                 // Tier A: the constant 4
	WORD Ri;                        // Tier C - DO NOT NARROW
	g_ri = (int)Ri;
} DRI;
typedef struct tagDHP {
	local int evil_dp = SetEvilBit(false);
	M_ID marker = { M_DHP };
	SetEvilBit(evil_dp);
	WORD szSection;                 // Tier A: 8 + 3*Nf, written back by the caller
	uchar P <values=prec3>;         // Tier B: the whole precision set
	uint16 Y;                       // Tier C
	uint16 X;                       // Tier C
	local ubyte nf1[] = { 1, 1, 2, 3 };
	local int evil_dn = SetEvilBit(false);
	ReadUByte( FTell(), nf1 );
	SetEvilBit(evil_dn);
	uchar Nf;                       // Tier C, bare - takes the value committed above
	struct {
		uchar id;                   // Tier C
		uchar h_factor : 4 <values=hv>;   // Tier B, whole set
		uchar v_factor : 4 <values=hv>;   // Tier B, whole set
		local int evil_dt = SetEvilBit(false);
		uchar Tq = { 0 };           // Tier A: fixed
		SetEvilBit(evil_dt);
	} component_param[Nf];
} DHP;

typedef struct tgSOFx {
	// Tier A: only SOF0-SOF3 reach this struct, and the marker is pinned by the lookahead
	// that chose this segment in the loop below.
	M_ID marker;
	WORD szSection;                 // Tier A: 8 + 3*nr_comp, written back by the caller
	// dependencies[0]/[1]: SOF0, SOF1 and SOF2 accept precision 8 and 12 only; SOF3 is
	// the only route to the other thirteen, and libjpeg really does decode them.
	local int evil_pr = SetEvilBit(false);
	if( g_sofm == 0xFFC3 ) ReadUByte( FTell(), prec3 );
	else                   ReadUByte( FTell(), prec );
	SetEvilBit(evil_pr);
	ubyte precision;                // Tier A, bare - takes the value committed above
	WORD Y_image;                   // Tier C - DO NOT NARROW (the scan derives from it)
	WORD X_image;                   // Tier C - DO NOT NARROW
	// Tier A: 1..10; eleven or more is refused with 'Too many color components'.
	local ubyte nfs[] = { 1,1,1, 3,3,3,3, 4,4, 2, 5, 6, 7, 8, 9, 10 };
	local int evil_nc = SetEvilBit(false);
	ReadUByte( FTell(), nfs );
	SetEvilBit(evil_nc);
	ubyte nr_comp;                  // Tier A, bare - takes the value committed above
	ChangeColor(0);
	local int ci = 0;
	g_units = 0;  g_hmax = 1;  g_vmax = 1;
	// Tier A: sampling factors 1..4; 0 and 5 give 'Bogus sampling factors'. Measured, a
	// libjpeg frame additionally needs every Hmax/Hi to be an integer, and a second
	// component with a different non-unit factor gives 'Fractional sampling not
	// implemented yet' - so the whole 1..4 range rides on the first component, where all
	// sixteen combinations decode, and the rest are unit.
	hnx[0]=1; hnx[1]=1; hnx[2]=1; hnx[3]=2; hnx[4]=2; hnx[5]=3; hnx[6]=4;
	vnx[0]=1; vnx[1]=1; vnx[2]=1; vnx[3]=2; vnx[4]=2; vnx[5]=3; vnx[6]=4;
	struct COMPS {
		ubyte compId;               // Tier C - free; the identifiers themselves are free
		ubyte Horz:4 <values=hnx>;
		ubyte Vert:4 <values=vnx>;
		// Tier A: a quantization destination, all four of which the DQT above defined.
		ubyte compNr <values=td>;
		// every component after the first must be unit, or Hmax/Hi is fractional
		hnx[3]=1; hnx[4]=1; hnx[5]=1; hnx[6]=1;
		vnx[3]=1; vnx[4]=1; vnx[5]=1; vnx[6]=1;
	} comp[nr_comp];
	// the scan is derived from this geometry, so it is recorded as the frame declares it
	g_W = (int64)X_image;  g_H = (int64)Y_image;  g_nf = (int)nr_comp;
	if( g_nf > 10 ) g_nf = 10;
	for( ci = 0; ci < g_nf; ci++ ) {
		g_h[ci] = (int)comp[ci].Horz;  g_v[ci] = (int)comp[ci].Vert;
		g_cid[ci] = (int)comp[ci].compId;
		g_units += g_h[ci] * g_v[ci];
		if( g_h[ci] > g_hmax ) g_hmax = g_h[ci];
		if( g_v[ci] > g_vmax ) g_vmax = g_v[ci];
	}
} SOFx;

typedef struct tagCOMMENT {
	local int evil_cm = SetEvilBit(false);
	M_ID CommentMarker = { M_COMM };
	SetEvilBit(evil_cm);
	WORD szSection;                 // Tier A: written back from the text actually emitted
	local int64 cl = Room( (szSection - 2) & 0x03FF );
	char comment[cl];               // Tier C - free bytes, free length
} COMMENT<read=ReadComment>;

typedef struct tagJPGLS {
	local int evil_jl = SetEvilBit(false);
    M_ID marker = { M_JPGLS };
	SetEvilBit(evil_jl);
    WORD szSection;                 // Tier A: 8 + 3*Nf, written back by the caller

    uchar precision <values=prec3, comment="bits per sample">;   // Tier B, whole set
    WORD Y_numlines;                // Tier C
    WORD X_numcols;                 // Tier C
    uchar Nf <comment="number of components in frame">;           // Tier C
    uchar C_compID;                 // Tier C
    uchar sub_sampling;             // Tier B bitmask
	local int evil_jt = SetEvilBit(false);
    uchar Tq = { 0 } <comment="always 0">;                        // Tier A: fixed
	SetEvilBit(evil_jt);
} JPGLS;

string ReadComment( COMMENT &com )
{
	return com.comment;
}

// ------------------------------------------------------------
// JPEG file

SetBackColor(jetMap[0]);
typedef struct tgJPGFile {
	local int was_bigendian = IsBigEndian();
	BigEndian();
	local WORD NextMarker;
	local quad fpos2;
    local quad endpos;
	local byte bEOI = 0;
	local int64 g_sp = 0;
	local int   g_haslen = 1;
	// structure[0]: FF D8 is the very first thing in the file, with nothing before it -
	// libjpeg refuses anything else, even though the template tolerates leading garbage.
	local int evil_si = SetEvilBit(false);
	M_ID SOIMarker = { M_SOI };
	SetEvilBit(evil_si);
	while(FTell() < JpegFileEnd && !bEOI) {
		// structure[5]/[6]: the marker set the current region of the layout allows. This
		// lookahead commits the two marker bytes, so it is also what chooses the segment
		// - and because 0xFFFF is never in the set, the fill-byte loop below never fires
		// in the generation direction.
		local int evil_mk = SetEvilBit(false);
		if( g_state == 0 )           ReadUShort( FTell(), t_dqt );   // structure[3]
		else if( g_state >= 2 )      ReadUShort( FTell(), t_sos );
		else if( Room(2600) < 2600 ) ReadUShort( FTell(), t_sof );
		else                         ReadUShort( FTell(), t_hdr );
		SetEvilBit(evil_mk);
		// skip optional 0xff before marker
		while (ReadUShort(FTell()) == 0xffff) FSkip(1);

		NextMarker  = ReadUShort(FTell());
		g_sp = FTell();  g_haslen = 1;
		switch(NextMarker) {
		case M_SOI:
			M_ID SOIMarker;
			Printf("Start of Image Marker\n");
			g_haslen = 0;
			break;
		case M_SOS:
			g_haslen = 0;
			SOS  scanStart;
			// Tier A: szSection is 6 + 2*nr_comp - written back from the header actually
			// emitted, before the scan that follows it.
			endpos = FTell();
			local int evil_s2 = SetEvilBit(false);
			FSeek( g_sp + 2 );  WORD szSection = { (WORD)(endpos - g_sp - 2) };
			SetEvilBit(evil_s2);  FSeek( endpos );
			Printf("Start of Scan Marker\n");
			// structure[16]: omitting the EOI is worth generating - it costs only a
			// warning and reaches libjpeg's synthetic-EOI path. The choice is read from
			// a free component identifier so that both directions agree on it.
			g_noeoi = 0;
			if( (g_cid[0] & 7) == 3 ) g_noeoi = 1;
			// payload_wellformedness: the entropy-coded segment. Its extent is the MCU
			// count derived from the frame geometry, the sampling factors, the scan's
			// component count and the restart interval - four free diversity axes - times
			// the codeword lengths the Huffman tables gave symbol 0. When the budget
			// cannot hold the whole scan it is TRUNCATED; no dimension, component count
			// or sampling factor is ever narrowed so that a precomputed scan fits, and
			// libjpeg conceals the missing MCUs and still produces the image.
			g_scan = ScanLen( g_sn );
			if( g_scan > Room( g_scan ) ) g_scan = Room( g_scan );
			if( g_scan < 1 ) g_scan = 1;
			// The extent is the derived scan length in BOTH directions. The original's
			// FindFirst(M_EOI) cannot be used here: in the GENERATION direction it does
			// not search, it MATERIALISES the marker it is looking for - it appended a
			// second FF D9 and a run of padding past the end of every file - and the
			// spurious hit then sent the scan down the random-bytes branch.
			if( g_noeoi ) Printf("Missing End of File marker\n");
			// The scan itself: every DC codeword and every EOB is the all-zero codeword
			// in its table, so the stream is zero bytes and no 0xFF ever appears to break
			// the stuffing rule. dependencies[17]: when Ri is non-zero an RSTn marker
			// follows every Ri MCUs, byte-aligned and NOT stuffed, cycling 0xFFD0..0xFFD7.
			local int64 sj = 0;  local int64 sd = 0;  local int64 sk = 0;
			local int64 sb = 0;  local int64 sr = 0;  local int64 sc = 0;
			local int64 sp2 = FTell();
			local ubyte z0[] = { 0 };  local ubyte zf[] = { 255 };  local ubyte zr[1];
			// decoder_gate: a correct stream drives decode_mcu, the coefficient and EOB
			// loops, dequantization and a full IDCT; a garbage one drives the error
			// concealment path and the warning emitter. Both are coverage and the JSON
			// asks for both, so a share of scans is left as free bytes - the content of
			// this field is free either way. The choice is read from a free component
			// identifier so that both directions agree on it.
			local int evil_sc = SetEvilBit(false);
			if( (g_cid[0] & 7) == 5 ) {
			    // free bytes: no commit, the array below draws its own
			} else if( g_ri <= 0 || g_nmcu <= g_ri ) {
			    for( sj = 0; sj < g_scan; sj++ ) ReadUByte( sp2 + sj, z0 );
			} else {
			    while( sd < g_nmcu && sc < g_scan ) {
			        sk = g_ri;  if( sk > g_nmcu - sd ) sk = g_nmcu - sd;
			        sb = (sk * g_per + 7) / 8;
			        for( sj = 0; sj < sb; sj++ ) {
			            if( sc >= g_scan ) break;
			            ReadUByte( sp2 + sc, z0 );  sc++;
			        }
			        sd += sk;
			        if( sd < g_nmcu && sc + 2 <= g_scan ) {
			            zr[0] = (ubyte)(208 + (sr % 8));
			            ReadUByte( sp2 + sc, zf );  ReadUByte( sp2 + sc + 1, zr );
			            sr++;  sc += 2;
			        }
			    }
			    while( sc < g_scan ) { ReadUByte( sp2 + sc, z0 );  sc++; }
			}
			SetEvilBit(evil_sc);
			// structure[16]: omitting the EOI costs only a warning and reaches libjpeg's
			// synthetic-EOI path, so it is worth generating - the choice is read from a
			// free component identifier so that both directions agree on it.
			if( g_noeoi )
			{
			    char unterminatedScanData[g_scan];
			}
			else
			{
			    char scanData[g_scan];
			    ChangeColor(1);
			    local int evil_eo = SetEvilBit(false);
			    M_ID EOIMarker = { M_EOI };
			    SetEvilBit(evil_eo);
			    Printf("End of File Image\n");
			}
			bEOI = 1;
			break;
		case M_APP0:
			APP0 app0;
			break;
		case M_DHT:
			DHT dht;
			break;
		case M_DQT:
			DQT dqt;
			g_state = 1;                    // structure[3]: the tables now exist
			break;
		case M_DRI:
			DRI dri;
			break;
		case M_DHP:
			DHP dhp;
			break;
		case M_SOF0:
			g_sofm = NextMarker;        // dependencies[2]-[9] key the scan on the frame type
			SOFx sof0;
			g_state = 2;
			break;
		case M_SOF1:
			g_sofm = NextMarker;        // dependencies[2]-[9] key the scan on the frame type
			SOFx sof1;
			g_state = 2;
			break;
		case M_SOF2:
			g_sofm = NextMarker;        // dependencies[2]-[9] key the scan on the frame type
			SOFx sof2;
			g_state = 2;
			break;
		case M_SOF3:
			g_sofm = NextMarker;        // dependencies[2]-[9] key the scan on the frame type
			SOFx sof3;
			g_state = 2;
			break;
		case M_APP1:
			APP1 app1;
			break;
		case M_APP2:
			APP2 app2;
			break;
		case M_APP12:
			APP12 app12;
			break;
		case M_APP13:
			APP13 app13;
			break;
		case M_APP14:
			APP14 app14;
			break;
		case M_COMM:
			COMMENT comment;
			break;
        case M_JPGLS:
            JPGLS jpgls;
            break;
		default:
			if (ReadUByte(FTell()) == 0xff) {
				UNKNOWN unknownSection;
			} else {
				char garbage;               // Tier C
				g_haslen = 0;
			}
			break;
		}
		// Tier A: every marker segment's szSection is the byte count of what its struct
		// actually emitted - written back from the bytes rather than computed up front.
		// structure[6]: the run stops when the budget is spent and the frame is forced.
		if( g_haslen && !bEOI )
		{
			endpos = FTell();
			if( endpos > g_sp + 4 )
			{
				local int evil_sz = SetEvilBit(false);
				FSeek( g_sp + 2 );  WORD szSection = { (WORD)(endpos - g_sp - 2) };
				SetEvilBit(evil_sz);  FSeek( endpos );
			}
		}
		ChangeColor(!bEOI);
	}
	if (!was_bigendian)
		LittleEndian();
} JPGFILE;

JPGFILE jpgfile <open=true>;