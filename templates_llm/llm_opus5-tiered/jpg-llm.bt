	// structure[19]: Adobe / unrecognised. The Adobe branch is the only way to make
	// libjpeg take a colour transform other than its 3-component YCbCr assumption.
	local string aesig[] = { "Adobe", "Adobe", "Adobe", "ZZZZZ" };
