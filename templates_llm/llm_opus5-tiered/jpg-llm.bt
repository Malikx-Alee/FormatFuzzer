	local int evil_aes = SetEvilBit(false);
	ReadBytes( aesel, FTell(), 5, aesig, aesig );
	SetEvilBit(evil_aes);

	if (ReadStringN(FTell(), 5) == "Adobe") {
		// http://partners.adobe.com/public/developer/en/ps/sdk/5116.DCT_Filter.pdf
		char adobe[5];                  // Tier A, pinned by the lookahead above
		uint16 version;                 // Tier C
		uint16 flag0;                   // Tier C
		uint16 flag1;                   // Tier C
		// Tier B: dependencies[33] - 0 is the only way to make libjpeg decode a
		// 3-component frame as raw RGB and take the null colour-conversion path.
		uchar color_transform_code = { 0, 1, 2 };
