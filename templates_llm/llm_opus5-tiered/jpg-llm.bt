		//Warning("Unknown APP0");
		local int64 u0 = Room( (szSection - 2) & 0x03FF );
		if( u0 < 5 ) u0 = 5;   // the branch lookahead committed 5 bytes
		char unknown[u0];               // Tier C: free bytes, free length
	}
