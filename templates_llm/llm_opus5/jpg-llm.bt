// Casio tag
typedef enum <WORD> tagCasioTag2 {
	PreviewThumbnailDimensions	=	0x0002,//Numeric 	 2 values - x,y dimensions in pixels
	PreviewThumbnailSize		=	0x0003,//Numeric 	Size in bytes
	PreviewThumbnailOffset 		=	0x0004,//Numeric 	Offset of Preview Thumbnail
	CSQualityMode			=	0x0008,//Numeric Lookup	1 = Fine 2 = Super Fine
	CsImageSize			=	0x0009,//Numeric Lookup 	0 = 640 x 480 pixels 4 = 1600 x 1200 pixels 5 = 2048 x 1536 pixels 20 = 2288 x 1712 pixels 21 = 2592 x 1944 pixels 22 = 2304 x 1728 pixels 36 = 3008 x 2008 pixels
	CSFocusMode 			=	0x000D,//Numeric Lookup 	0 = Normal 1 = Macro
	CsIsoSensitivity 		=	0x0014,//Numeric Lookup 	3 = 50 4 = 64 6 = 100 9 = 200
	CsWhiteBalance 			=	0x0019,//Numeric Lookup 	0 = Auto 1 = Daylight 2 = Shade 3 = Tungsten 4 = Fluorescent 5 = Manual
	CsFocalLength			=	0x001D,//Numeric 	Units are tenths of a millimetre
	CsSaturation			=	0x001F,//Numeric Lookup 	0 = -1 1 = Normal 2 = +1
	CsContrast			=	0x0020,//Numeric Lookup 	0 = -1 1 = Normal 2 = +1
	CsSharpness 			=	0x0021,//Numeric Lookup 	0 = -1 1 = Normal 2 = +1
	CsPrintImageMatchingInfo 	=	0x0E00,//PIM 	See Print Image Matching for specification
	CasioPreviewThumbnail 		=	0x2000,//Numeric 	Alternate thumbnail offset
	CsWhiteBalanceBias 		=	0x2011,//Numeric
	CsFlashMode 			=	0x2012,//Numeric Lookup 	12 = Flash 0 = Manual 1 = Auto? 4 = Flash?
	CsObjectDistance 		=	0x2022,//Numeric 	Units are millimetres
	CsFlashDistance 		=	0x2034,//Numeric 	0 = Off
	CsRecordMode 			=	0x3000,//Numeric Lookup 	2 = Normal Mode
	CsSelfTimer			=	0x3001,//Numeric Lookup 	1 = Off?
	CsQuality 			=	0x3002,//Numeric Lookup 	3 = Fine
	CsMeteringMode2			=	0x3003,//Numeric Lookup 	1 = Fixation 6 = Multi-Area Auto Focus
	CsTimeZone 			=	0x3006,//String
	CsBestshotMode 			=	0x3007,//Numeric Lookup 	0 = Off 1 = On?
	CsCCDISOSensitivity 		=	0x3014,//Numeric
	CsColourMode 			=	0x3015,//Numeric Lookup 	0 = Off
	CsEnhancement 			=	0x3016,//Numeric Lookup 	0 = Off
	CsFilter 			=	0x3017,//Numeric Lookup 	0 = Off
} CasioTag2;


// ------------------------------------------------------------
// Canon CIFF
typedef uint32 DC_UINT32;
typedef int32 DC_SINT32;
typedef float DC_FLOAT32;

typedef struct tgCifDirEntry {
	uint16 storage_method : 2; // 00 in heap, 01 in entry
	uint16 data_type : 3;
	uint16 id_code : 11 <format=hex>;
	// D55: kStg_InHeapSpace makes the eight value bytes a size/offset pair
	// pointing into the directory heap.  Both are fed straight into an array
	// bound and an FSeek with no check of any kind, so a uniform 32-bit value
	// asks the parser for up to 4 GB from one field, or seeks anywhere in a
	// 4 GB address space.
	if (storage_method == kStg_InHeapSpace) {
		DWORD sData <min=0, max=256>;   // Data Size (Bytes); spec 0..2^32-1
		DWORD oData <min=0, max=4096>;  // Data Offset; spec 0..2^32-1
	} else {
		switch (data_type << 11 | id_code) {
			case kTC_ImageFormat:
				DC_UINT32 fileFormat;
				DC_FLOAT32 targetCompressionRatio;
				break;
			default:
				byte data[8];
				break;
		}
	}
} CifDirEntry <read=ReadCifDirEntry>;

enum CIFFTagStg {
	kStg_InHeapSpace,
	kStg_InRecordEntry,
	kStg_reversed2,
	kStg_reversed3,
};

enum CIFFTagDataType {
	kDT_BYTE	= 0x0000,
	kDT_ASCII	= 0x0800,
	kDT_WORD	= 0x1000,
	kDT_DWORD	= 0x1800,
	kDT_BYTE2	= 0x2000,
	kDT_HeapTypeProperty1 = 0x2800,
	kDT_HeapTypeProperty2 = 0x3000,
};

enum <uint16> CIFFTagType {
	kTC_Null = 0,
	kTC_Free,
	kTC_ExFree,

	kTC_Description =	0x0805,//kDT_ASCII | 0x0005,
	kTC_ModelName =		0x080a,//kDT_ASCII | 0x000a,
	kTC_FirmwareVersion =	0x080b,//kDT_ASCII | 0x000b,
	kTC_ComponentVersion =	0x080c,//kDT_ASCII | 0x000c,
	kTC_ROMOperationMode =	0x080d,//kDT_ASCII | 0x000d,
	kTC_OwnerName =		0x0810,//kDT_ASCII | 0x0010,
	kTC_ImageFileName =	0x0816,//kDT_ASCII | 0x0016,
	kTC_ThumbnailFileName =	0x0817,//kDT_ASCII | 0x0017,

	kTC_TargetImageType =	0x100a,//kDT_WORD | 0x000a,
	kTC_SR_ReleaseMethod =	0x1010,//kDT_WORD | 0x0010,
	kTC_SR_ReleaseTiming =	0x1011,//kDT_WORD | 0x0011,
	kTC_ReleaseSetting =	0x1016,//kDT_WORD | 0x0016,
	kTC_BodySensitivity =	0x101c,//kDT_WORD | 0x001c,

	kTC_ImageFormat =	0x1803,//kDT_DWORD | 0x0003,
	kTC_RecordID =		0x1804,//kDT_DWORD | 0x0004,
	kTC_SelfTimerTime =	0x1806,//kDT_DWORD | 0x0006,
	kTC_SR_TargetDistanceSetting = 0x1807,//kDT_DWORD | 0x0007,
	kTC_BodyID =		0x180b,//kDT_DWORD | 0x000b,
	kTC_CapturedTime =	0x180e,//kDT_DWORD | 0x000e,
	kTC_ImageSpec =		0x1810,//kDT_DWORD | 0x0010,
	kTC_SR_EF =		0x1813,//kDT_DWORD | 0x0013,
	kTC_MI_EV =		0x1814,//kDT_DWORD | 0x0014,
	kTC_SerialNumber =	0x1817,//kDT_DWORD | 0x0017,

	kTC_CameraObject =	0x2807,//0x0007 | kDT_HeapTypeProperty1,
	kTC_ShootingRecord =	0x3002,//0x0002 | kDT_HeapTypeProperty2,
	kTC_MeasuredInfo =	0x3003,//0x0003 | kDT_HeapTypeProperty2,
	kTC_CameraSpecification = 0x3004,//0x0004 | kDT_HeapTypeProperty2,
};

string ReadCifDirEntry(CifDirEntry &e)
{
	local string s;
	local uint16 tc = e.data_type << 11 | e.id_code;
	local CIFFTagType x = (CIFFTagType) tc;
	local CIFFTagStg stg = (CIFFTagStg)e.storage_method;
	local CIFFTagDataType dt = (CIFFTagDataType)(e.data_type << 11);
	if (EnumToString(x) != "") {
		SPrintf(s, "%s, %s",
				EnumToString(stg),
				EnumToString(x));
	} else {
		SPrintf(s, "%s, %s, 0x%x",
				EnumToString(stg),
				EnumToString(dt),
				e.id_code);
	}

	return s;
}

typedef struct tgCDir {
	ChangeColor(0);
	//Printf("off %#Lx doff %#Lx dsz %#Lx\n",cifOffset , cDirOffset ,cDirSize);
	local quad myOffset = cDirOffset;
	local DWORD S = ReadInt(myOffset + cDirSize - 4);
	FSeek(cDirOffset + S);
	//Printf("S @ %#x = %#x FTell %#Lx",S,myOffset + cDirSize - 4,FTell());
	// S28/S29: each entry is ten bytes and may point at up to sData bytes of
	// heap, so a 16-bit count of 65535 is 640 KB of records plus unbounded
	// heap from one 2-byte field.
	WORD nDirEntry <min=0, max=16>;
	//Printf(" nEntry %#x\n",nDirEntry);
	ChangeColor(0);
	CifDirEntry dirEntries[nDirEntry]<optimize=false>;
	DWORD szValues; // = S
	local int i;
	for(i=0;i<nDirEntry;i++) {
		//Printf("%d. Entry %#x = [ %#x  %#x %#x]\n",i,dirEntries[i].Tag,dirEntries[i].Tag & 0xC000,dirEntries[i].Tag & 0x3800,dirEntries[i].Tag & 0x07FF);
		if (dirEntries[i].storage_method == kStg_InHeapSpace) {
			// Values are stored at a different location
			FSeek(myOffset + dirEntries[i].oData);
			ChangeColor(0);
			//Printf("%d size %#x offset %#x clrIdx = [%d %d]\n",i,dirEntries[i].sData,dirEntries[i].oData,colorSelect,colorId);
			switch(dirEntries[i].data_type << 11 | dirEntries[i].id_code) {
				case kTC_ImageSpec:
					struct {
						DC_UINT32 imageWidth;
						DC_UINT32 imageHeight;
						DC_FLOAT32 pixelAspectRatio;
						DC_SINT32 rotationAngle;
						DC_UINT32 componentBitDepth;
						DC_UINT32 colorBitDepth;
						DC_UINT32 colorBW;
					} DC_IMAGESPEC;
					break;
				default:
					switch(dirEntries[i].data_type << 11) {
						case kDT_BYTE:
							struct {
								byte bData[dirEntries[i].sData];
							} strBytes;
							break;
						case kDT_ASCII:
							struct {
								char sData[dirEntries[i].sData];
							} strStrings;
							break;
						case kDT_WORD:
							struct {
								WORD wData[dirEntries[i].sData>>1];
							} str2Bytes;
							break;
						case kDT_DWORD:
							union {
								DWORD dwData[dirEntries[i].sData>>2];
								DWORD flData[dirEntries[i].sData>>2];
							} str4Bytes;
							break;
						case kDT_HeapTypeProperty1:
						case kDT_HeapTypeProperty2:
							cDirOffset = dirEntries[i].oData + myOffset;
							cDirSize = dirEntries[i].sData;
							struct CDIR subDir;
							break;
						default:
							struct {
								char uData[dirEntries[i].sData];
							} strUnknown;
							break;
					}
					break;
			}
		}
		//else value is samaller than 8 byte so it is stored in sData and oData of CifDirEntry struct
	}

} CDIR;

// ------------------------------------------------------------
// JPEG APPx segments
const local int dataFormatLength[13] = {0,1,1,2,4,8,1,1,2,4,8,4,8};

typedef enum <WORD> tagDataFormat {
	uByte = 1,
	ascString,
	uShort,
	uLong1,
	uRatio,
	sByte,
	undefined = 7,
	sShort,
	sLong = 9,
	sRatio,
	sFloat,
	dFloat,
} DataFormat;


typedef struct tgDIRENTRY {
	ChangeColor(0);
	switch (Stack_top(stack_IFD_dirtype)) {
		case IFD_TYPE_EXIF:
			ExifTag tagNumber;
			break;
		case IFD_TYPE_GEOTAG:
			GeoTag tagNumber;
			break;
		case IFD_TYPE_CASIO_QV_R62:
			CasioTag2 tagNumber;
			break;
	}
	DataFormat dataFormat;
	// D35/D37: dataFormatLength[dataFormat] * nComponent is the value's byte
	// length, and it becomes an array bound at every branch below with no
	// upper check.  The spec allows the full 32 bits; 0-64 elements keeps an
	// out-of-line value inside the segment that declared it.
	DWORD nComponent <min=0, max=64>;
	local unsigned int j = 0;
	local int length = -1;

	if (1 <= dataFormat && dataFormat < 13)
		length = dataFormatLength[dataFormat] * nComponent;
	else {
		//Warning("unknown dataFormat = %x", dataFormat);
	}

	if (1 <= dataFormat && dataFormat < 13 && 0 <= length && length <= 4) {
		switch (tagNumber) {
			case ExposureProgram:
				enum <short> {
					EP_Not_defined,
					EP_Manual,
					EP_Normal_program,
					EP_Aperture_priority,
					EP_Shutter_priority,
					EP_Creative_program,
					EP_Action_program,
					EP_Portrait_mode,
					EP_Landscape_mode,
				} ExposureProgram;
				break;
			case MeteringMode:
				enum <short> {
					MM_unknown,
					MM_Average,
					MM_CenterWeightedAverage,
					MM_Spot,
					MM_MultiSpot,
					MM_Pattern,
					MM_Partial,
					MM_other = 255,
				} MeteringMode;
				break;
			case LightSource:
				enum <short> {
					LS_unknown,
					LS_Daylight,
					LS_Fluorescent,
					LS_Tungsten,
					LS_Flash,
					LS_Fine_weather = 9,
					LS_Cloudy_weather,
					LS_Shade,
					LS_Daylight_fluorescent,
					LS_Day_white_fluorescent,
					LS_Cool_white_fluorescent,
					LS_White_fluorescent,
					LS_Standard_light_A,
					LS_Standard_light_B,
					LS_Standard_light_C,
					LS_D55,
					LS_D65,
					LS_D75,
					LS_D50,
					LS_ISO_studio_tungsten,
					LS_other_light_scoure = 255,
				} LightSource;
				break;
			case Flash:
				short unused : 9;
				short red_eye_mode : 1;
				short flash_function : 1;
				short flash_mode : 2;
				short flash_return : 2;
				short flash_fired : 1;
				break;
			case ExposureMode:
				enum <short> {
					EM_Auto_exposure,
					EM_Manual_exposure,
					EM_Auto_bracket,
				} ExposureMode;
				break;
			case WhiteBalance:
				enum <short> {
					WB_Auto_white_balance,
					WB_Manual_white_balance,
				} WhiteBalance;
				break;
			case SceneCaptureType:
				enum <short> {
					SCT_Standard,
					SCT_Landscape,
					SCT_Portrait,
					SCT_Night_scene,
				} SceneCaptureType;
				break;
			case SubjectDistanceRange:
				enum <short> {
					SDR_unknown,
					SDR_Macro,
					SDR_Close_view,
					SDR_Distant_view,
				} SubjectDistanceRange;
				break;
			default:
				switch (dataFormat) {
					case uByte:
						struct {
							uchar oneByteData[nComponent];
						} strAscii;
						break;
					case ascString:
						struct StrAscii1 {
							char oneByteData[nComponent];
						} strAscii <read=ReadAscString1>;
						break;
					case undefined:
						struct {
							uchar oneByteData[nComponent];
						} strAscii;
						break;
					case uShort:
						for (j = 0; j < nComponent; j++)
							ushort usValue;
						break;
					case uLong1:
						if (nComponent == 1)
							ulong ulValue;
						break;
					case sByte:
						struct {
							char sBValue[nComponent];
						} strSByte;
						break;
					case sShort:
						struct {
							short sisValue[nComponent];
						} strSShort;
						break;
					case sLong:
						if (nComponent == 1)
							ulong siLValue;
						break;
					case sFloat:
						if (nComponent == 1)
							float flValue;
						break;
				}
				break;
		}
		if (length != 4)
			uchar padding[4 - length];
	} else {
			DWORD offsetData;
	}
} DIRENTRY<read=ReadDirEntry>;

string ReadDirEntry(DIRENTRY &entry) {
	local char no[50];
	SPrintf(no,"Tag# = 0x%x (%s)",entry.tagNumber, EnumToString(entry.tagNumber));
	return no;
}


typedef struct tgIFD {
	// S24: an IFD is exactly 2 + 12*nDirEntry + 4 bytes.  An empty directory
	// is the only shape whose out-of-line values need no offsets and no seeks,
	// which is what keeps the generated Exif block self-consistent; a real
	// file's count is parsed through the evil escape.
	WORD nDirEntry = { 0 };
	DIRENTRY dirEntry[nDirEntry]<optimize=false>;
	// S26/D42: the chain is singly linked and 0 terminates it.  A non-zero
	// value promises a second IFD, and a backward or self-referential offset
	// is a decoder hang.
	DWORD nextIFDoffset = { 0 };
	local int i = 0;
	local int pos = FTell();
	for(i=0;i<nDirEntry;i++) {
		ChangeColor(0);
		switch(dirEntry[i].tagNumber) {
			case Make:
				ReadBytes(CameraMake,offset + dirEntry[i].offsetData,dirEntry[i].nComponent);
				Printf("Maker: %s\n",CameraMake);
				break;
			case Model:
				ReadBytes(CameraModel,offset + dirEntry[i].offsetData,dirEntry[i].nComponent);
				Printf("Model: %s\n",CameraModel);
				break;
		}


		if (!(1 <= dirEntry[i].dataFormat && dirEntry[i].dataFormat < 13))
			continue;
		if (dataFormatLength[dirEntry[i].dataFormat] * dirEntry[i].nComponent <= 4) {
			continue;
		}

		FSeek(offset + dirEntry[i].offsetData);
		switch(dirEntry[i].tagNumber) {
			default:
				switch(dirEntry[i].dataFormat) {
					case ascString:
						struct StrAscii {
							char oneByteData[dirEntry[i].nComponent];
						} strAscii <read=ReadAscString>;
						break;
					case undefined:
						struct {
							uchar oneByteData[dirEntry[i].nComponent];
						} strAscii;
						break;
					case uShort:
						struct {
							ushort usValue[dirEntry[i].nComponent];
						} strUShort;
						break;
					case uLong1:
						struct {
							ulong ulValue[dirEntry[i].nComponent];
						} strULong;
						break;
					case uRatio:
						struct URatio {
							struct {
								DWORD num;
								DWORD den;
							} uRValue[dirEntry[i].nComponent];
						} strURatio <read=ReadURatio>;
						break;
					case sByte:
						struct {
							char sBValue[dirEntry[i].nComponent];
						} strSByte;
						break;
					case sShort:
						struct {
							short sisValue[dirEntry[i].nComponent];
						} strSShort;
						break;
					case sLong:
						struct {
							ulong siLValue[dirEntry[i].nComponent];
						} strSLong;
						break;
					case sRatio:
						struct {
							struct {
								int num;
								int den;
							} siRValue[dirEntry[i].nComponent];
						} strSRatio;
						break;
					case sFloat:
						struct {
							float flValue[dirEntry[i].nComponent];
						} strsFloat;
						break;
					case dFloat:
						struct {
							double dFValue[dirEntry[i].nComponent];
						} strdFloat;
						break;
				}
		}
	}

	for(i=0;i<nDirEntry;i++) {
		ChangeColor(0);
		switch(dirEntry[i].tagNumber) {
			case ExifOffset:
				FSeek(offset + dirEntry[i].ulValue);
				Stack_push(stack_IFD_dirtype, IFD_TYPE_EXIF);
				struct IFD subDir;
				Stack_pop(stack_IFD_dirtype);
				break;
			case GPSInfo:
				FSeek(offset + dirEntry[i].ulValue);
				Stack_push(stack_IFD_dirtype, IFD_TYPE_GEOTAG);
				struct IFD subDir;
				Stack_pop(stack_IFD_dirtype);
				break;
			case InteropOffset:
				FSeek(offset + dirEntry[i].ulValue);
				Stack_push(stack_IFD_dirtype, IFD_TYPE_EXIF);
				struct IFD subDir;
				Stack_pop(stack_IFD_dirtype);
				break;
			case MakerNote:
				if(!Strncmp("CASIO COMPUTER CO.,LTD",CameraMake,22) &&
						!Strncmp("QV-R62",CameraModel,6)) {
					FSeek(offset + dirEntry[i].ulValue);
					//struct {
						char Header[6];
						Stack_push(stack_IFD_dirtype, IFD_TYPE_CASIO_QV_R62);
						struct IFD CasioIFD;
						Stack_pop(stack_IFD_dirtype);
					//} CasioMake;
				}
				break;
			case CasioPreviewThumbnail:
				// D41/S22: the third self-recursion site, capped the same way.
				if (jpgNest < 2) {
					FSeek(offset + dirEntry[i].ulValue);
					Printf("Casio Thumbnail Offset = %#Lx\n",offset + dirEntry[i].ulValue);
					local quad JpegFileEnd2 = JpegFileEnd;
					JpegFileEnd = FTell() + dirEntry[i].nComponent;
					struct JPGFILE CasioMakerThumbnail;
					JpegFileEnd = JpegFileEnd2;
				}
				break;
		}
	}

	FSeek(pos);
} IFD;

string ReadAscString1(StrAscii1 &s)
{
	return s.oneByteData;
}
string ReadAscString(StrAscii &s)
{
	return s.oneByteData;
}

string ReadURatio(URatio &ur)
{
	local int i;
	local string s;
	local string result = "";
	for (i = 0; exists(ur.uRValue[i]); i++) {
		SPrintf(s, "%d/%d", ur.uRValue[i].num, ur.uRValue[i].den);
		result += s + " ";
	}
	return result;
}


typedef struct tagApp0 {
	M_ID marker;
	// S09/D23: pin the identifier before the length field is written, so the
	// length can be derived from the segment shape the identifier selects
	// rather than guessed and then contradicted by the payload.  The five
	// identifier bytes sit two past the length field.
	ReadBytes(jpgIdPeek, FTell() + 2, 5, app0Pref, app0Poss, 1.0);
	if (jpgIdPeek == "JFIF\0")
		WORD szSection = { 16 };        // D23/D25: 16 bytes with no thumbnail
	else
		WORD szSection = { 16, 24, 32 };

	if (ReadStringN(FTell(), 5) == "JFIF\0") {
		// JFIF Main
		char  App0Type[5];
		// Declared `short versionHigh:8` in the original.  A bitfield cannot be
		// pinned - file_integer asserts "bitfield lookahead not implemented"
		// the moment the bitmap covers it - so the two version bytes are
		// declared as the plain bytes they already are on disk, which lets the
		// lookahead below hold them to a real JFIF revision.
		ReadBytes(jpgIdPeek, FTell(), 2, jfifVerPref, jfifVerPoss, 1.0);
		local int evilVer = SetEvilBit(false);
		ubyte versionHigh = { 1 };
		ubyte versionLow = { 1, 2 };
		SetEvilBit(evilVer);
		ubyte units = { 0, 1, 2 };      // 0 aspect ratio, 1 dpi, 2 dpcm
		// D26: unit code 0 makes the pair an aspect ratio rather than a
		// physical density, but neither value may be zero either way.
		WORD Xdensity <min=1, max=300>;
		WORD Ydensity <min=1, max=300>;
		// D25: a zero dimension suppresses the thumbnail array entirely and
		// fixes the segment at 16 bytes, which is what D23 then requires.
		ubyte xThumbnail = { 0 };
		ubyte yThumbnail = { 0 };
		if (xThumbnail != 0 && yThumbnail != 0) {
			struct {
				uchar r, g, b;
			} rgb[(ushort)xThumbnail * yThumbnail];
		}
	} else if(ReadStringN(FTell(), 5) == "JFXX\0") {
		// JFIF Extension
		char  App0Type[5];
		byte extension_code <format=hex>;
		switch (extension_code) {
			case 0x10:
				// S22/S23: a JFXX code 0x10 thumbnail is itself a complete
				// JPEG datastream.  Unbounded self-recursion is the fastest
				// way for this format to produce a non-terminating generation,
				// since each level multiplies the segment budget, so the
				// nesting depth is capped at one.
				local quad JpegFileEnd2 = JpegFileEnd;
				JpegFileEnd = FTell() + szSection - 8;
				if (jpgNest < 2)
					struct JPGFILE thumbnail;
				JpegFileEnd = JpegFileEnd2;
				break;
			case 0x11:
				ubyte xThumbnail;
				ubyte yThumbnail;
				struct {
					uchar r, g, b;
				} palette[256];
				uchar pixel[szSection - 8];
				break;
			case 0x13:
				// D30: a JFXX code 0x13 thumbnail is direct 24-bit RGB sized
				// by the two dimension bytes, so szSection must equal
				// 10 + 3*x*y; 255x255 would be a 195 KB thumbnail.
				ubyte xThumbnail <min=0, max=8>;
				ubyte yThumbnail <min=0, max=8>;
				struct {
					uchar r, g, b;
				} pixel[(ushort)xThumbnail * yThumbnail];
				break;
			default:
				//Warning("Unknown JFXX");
				char unknown[szSection - 8];
		}
	} else if((ReadStringN(FTell(), 2) == "II" || ReadStringN(FTell(), 2) == "MM")
			&& ReadStringN(FTell() + 6, 8) == "HEAPJPGM") {
		// Canon CIFF
		local quad cDirSize  = 0;
		local quad cDirOffset = 0;
		local quad cifOffset = FTell();
		//CIFF Header
		char ByteOrder[2];
		if(!Strncmp(ByteOrder,"II",2)) LittleEndian();
		DWORD HeaderLength;
		char type[4]; // "HEAP"
		char subtype[4]; // "JPGM"

		//Ciff Directory
		cDirOffset  = HeaderLength + cifOffset;
		cDirSize    = szSection - 2 - HeaderLength;
		CDIR  APP0_Ciff;
		BigEndian();
		FSeek(cifOffset + szSection - 2);
	}
	else {
		//Warning("Unknown APP0");
		char unknown[szSection - 2];
	}
} APP0;

typedef struct tgAPP1 {
	M_ID marker;
	// S10/S27: same identifier-before-length treatment as APP0.  An Exif APP1
	// is six identifier bytes, the eight-byte TIFF header and one IFD; with an
	// empty directory that is 2 + 6 + 8 + 6 = 22 bytes.
	ReadBytes(jpgIdPeek, FTell() + 2, 6, app1Pref, app1Poss, 1.0);
	if (jpgIdPeek == "Exif\0\0")
		WORD szSection = { 22 };
	else
		WORD szSection = { 32, 48 };    // must exceed the 29-byte XMP lookahead

	if (ReadStringN(FTell(), 5) == "Exif\0") {
		char EXIF[6];
		local quad offset = FTell();
		// D33: the TIFF byte-order mark decides the endianness of every
		// multi-byte field in the segment, and the template switches on it two
		// lines below.  Declared `byte` in the original, which cannot carry a
		// known value - a byte array maps to std::vector<byte> - so it is
		// declared as the character pair it actually is.
		char align[2] = { "MM", "II" };
		if(align[0]=='I') { LittleEndian(); }
		WORD tagMark = { 42 };          // D34: the TIFF magic, in align's order
		// S27: 8 puts the first IFD immediately after the TIFF header, which
		// is the only value that needs no seek.
		DWORD offsetFirstIFD = { 8 };
		if(offsetFirstIFD!=8)
			FSeek(offset + offsetFirstIFD);
		ChangeColor(0);
		Stack_push(stack_IFD_dirtype, IFD_TYPE_EXIF);
		IFD ifdMainImage;
		Stack_pop(stack_IFD_dirtype);
		if(ifdMainImage.nextIFDoffset) {
			FSeek(offset + ifdMainImage.nextIFDoffset);
			ChangeColor(0);
			Stack_push(stack_IFD_dirtype, IFD_TYPE_EXIF);
			IFD ifdThumbnailImage;
			Stack_pop(stack_IFD_dirtype);
			local int i = 0;
			local int thumbOffset = 0;
			local int thumbLength = 0;
			local int compression = 10;
			for(;i<ifdThumbnailImage.nDirEntry;i++) {
				switch(ifdThumbnailImage.dirEntry[i].tagNumber) {
					case Compression:
						compression = ifdThumbnailImage.dirEntry[i].usValue;
						break;
					case ThumbnailOffset:
					case StripOffsets:
						thumbOffset = ifdThumbnailImage.dirEntry[i].ulValue;
						break;
					case ThumbnailLength:
					case StripByteCounts:
						thumbLength = ifdThumbnailImage.dirEntry[i].ulValue;
						break;
				}
			}
			if(thumbLength && thumbOffset) {
				FSeek(offset + thumbOffset);
				Printf("Thumbnail Offset = %#Lx\n",offset + thumbOffset);
				// D43/S22/S23: a Compression value of 6 makes the thumbnail a
				// nested JPEG datastream; the depth cap applies here too.
				if(compression == 6 && jpgNest < 2) {
					local quad JpegFileEnd2 = JpegFileEnd;
					JpegFileEnd = FTell() + thumbLength;
					struct JPGFILE thumbnail;
					JpegFileEnd = JpegFileEnd2;
				}
				else
					char imageData[thumbLength];
			}
		}
		FSeek(offset + szSection - 8);
		if(align[0]=='I') { BigEndian(); }
	} else if (ReadStringN(FTell(), 29) == "http://ns.adobe.com/xap/1.0/\0") {
		// http://www.adobe.com/products/xmp/
		char XAP[29];
		char remain[szSection - 31];
	} else {
		//Warning("Unknown APP1");
		char unknown[szSection - 2];
	}
} APP1;

typedef struct tgAPP2 {
	M_ID marker;
	// D60: the length must leave room for the twelve-byte ICC_PROFILE
	// identifier the branch below looks ahead at, or the lookahead pins bytes
	// that belong to the next segment.
	WORD szSection = { 16, 32, 64 };

	if (ReadStringN(FTell(), 5) == "FPXR\0") {
			char FPXR[5];
			uchar version;
			char remain[szSection - 8];
			//Warning("Unknown FPXR");
	} else if (ReadStringN(FTell(), 12) == "ICC_PROFILE\0") {
			char ICC_PROFILE[12];
			// D47/S12: the chunks are numbered 1..block_total with no gaps or
			// repeats, so the sequence number is meaningless unless it stays
			// inside the declared total.  One chunk of one is the only shape a
			// single segment can be self-consistent in.
			uchar block_num = { 1 };
			uchar block_total = { 1 };
			char data[szSection - 16];
	} else {
		//Warning("Unknown APP2");
		char unknown[szSection - 2];
	}
} APP2;

typedef struct tagAPP12 {
	M_ID marker;
	WORD szSection = { 16, 32 };   // past the five-byte Ducky lookahead

	if (ReadStringN(FTell(), 5) == "Ducky") {
		// refer to ExifTool APP12.pm
		char Ducky[5];
		local WORD s = szSection;
		while (s > 0) {
			struct {
				enum <uint16> {
					DK_End,
					DK_Quality,
					DK_Comment,
					DK_Copyright,
				} tag;
				if (tag == DK_End)
					break;

				// D51: the template computes comment[len - 4], so a length
				// below 4 makes the array size negative; D50 fixes a quality
				// record at exactly 4.
				uint16 len <min=4, max=256>;

				switch (tag) {
					case DK_End:
						break;
					case DK_Quality:
						uint32 value;
						break;
					case DK_Comment:
						uint32 count;
						char comment[len - 4];
						break;
					case DK_Copyright:
						uint32 count;
						char comment[len - 4];
						break;
					default:
						char unknown[len];
						break;
				}
			} entry;
			if (entry.tag == DK_End)
				break;
			s -= sizeof(entry);
		}
	} else {
		//Warning("Unknown APP12");
		char unknown[szSection - 2];
	}
} APP12;

typedef struct tagAPP13 {
	M_ID marker;
	WORD szSection = { 16, 32, 64 };   // past the 14-byte Photoshop lookahead

	if (ReadStringN(FTell(), 14) == "Photoshop 3.0\0") {
		// refer to ExifTool Photoshop.pm
		char photoshop30[14];
		local int remainsize = szSection - 16;
		while (remainsize > 0) {
			struct {
				char type[4];
				if (type == "8BIM") {
				} else if (type == "PHUT" || type == "DCSR" || type == "AgHg") {
				} else {
					char unknown[remainsize - 4];
					break;
				}
				enum <uint16> {
					PS_IPTCData = 0x0404,
					PS_JPEG_Quality = 0x0406,
					PS_PhotoshopBGRThumbnail = 0x0409,
					PS_CopyrightFlag = 0x040a,
					PS_URL = 0x040b,
					PS_PhotoshopThumbnail = 0x040c,
					PS_ICC_Profile = 0x040f,
					PS_GlobalAltitude = 0x0419,
					PS_EXIFInfo = 0x0422,
					PS_XMP = 0x0424,
					PS_IPTCDigest = 0x0425,
					PS_ClippingPathName = 0x0bb7,
				} tag;
				// S31/D52: the resource name is a Pascal string padded to an
				// even total; both the name and the data below are unbounded
				// byte counts in the original.
				uchar namelen <min=0, max=32>;
				if (namelen)
					char name[namelen];
				if (namelen % 2 != 1)
					char padding;
				uint32 size <min=0, max=1024>;   // D53/S31; spec 0..2^32-1
				if (size)
					char data[size];
				if (size % 2 != 0)
					char padding;
			} block;
			remainsize -= sizeof(block);
		}
	} else if (ReadStringN(FTell(), 9) == "Adobe_CM\0") {
		char adobe_cm[9];
		uchar AdobeCMType;
		if (szSection != 12)
			char unknown[szSection - 12];
	} else {
		//Warning("Unknown APP13");
		char unknown[szSection - 2];
	}
} APP13;

typedef struct tagAPP14 {
	M_ID marker;
	// Same identifier-before-length treatment: an Adobe APP14 is 2 + 5 + 2 +
	// 2 + 2 + 1 = 14 bytes, which leaves the trailing `unknown` array empty.
	ReadBytes(jpgIdPeek, FTell() + 2, 5, app14Pref, app14Poss, 1.0);
	if (jpgIdPeek == "Adobe")
		WORD szSection = { 14 };
	else
		WORD szSection = { 16, 32 };

	if (ReadStringN(FTell(), 5) == "Adobe") {
		// http://partners.adobe.com/public/developer/en/ps/sdk/5116.DCT_Filter.pdf
		char adobe[5];
		uint16 version = { 100 };
		uint16 flag0 = { 0 };
		uint16 flag1 = { 0 };
		// 0 unknown (RGB or CMYK), 1 YCbCr, 2 YCCK.  0 lets a decoder infer
		// the colour space from the frame's component identifiers instead,
		// which is what keeps it consistent with any nr_comp the frame chose.
		uchar color_transform_code = { 0 };
		if (FTell() < szSection + startof(szSection)) char unknown[szSection + startof(szSection) - FTell()];
	} else {
		//Warning("Unknown APP14");
		char unknown[szSection - 2];
	}
} APP14;

// ------------------------------------------------------------
// JPEG segments
typedef struct tagSOS {
	M_ID marker;
	local int64 sosLenPos = FTell();
	WORD szSection;
	local int64 sosStart = FTell();
	// D04: a scan may only name components the frame header declared, and
	// T.81 caps Ns at 4.  Taking the count straight from the frame makes the
	// two agree by construction instead of by luck.
	if (jpgNrComp == 1)
		ReadBytes(jpgIdPeek, FTell(), 1, nc1, nc1, 1.0);
	else
		ReadBytes(jpgIdPeek, FTell(), 1, nc3, nc3, 1.0);
	local int evilNs = SetEvilBit(false);
	ubyte nr_comp = { (ubyte)jpgNrComp };
	SetEvilBit(evilNs);
	ChangeColor(0);
	jpgCompId = 1;
	struct COMPSOS {
        // D05: the scan selects components by identifier, so an identifier
        // with no matching frame component makes the scan undecodable.  The
        // frame numbers its components 1..Nf and this counter repeats them.
        if (jpgCompId == 1)
            ReadBytes(jpgIdPeek, FTell(), 1, cid1, cid1, 1.0);
        else if (jpgCompId == 2)
            ReadBytes(jpgIdPeek, FTell(), 1, cid2, cid2, 1.0);
        else
            ReadBytes(jpgIdPeek, FTell(), 1, cid3, cid3, 1.0);
        local int evilCid = SetEvilBit(false);
        ubyte compId = { (ubyte)jpgCompId };
        SetEvilBit(evilCid);
        jpgCompId++;
		ubyte AC:4 <values=tblSel>;   // D09/D18: baseline allows 0-1; only
		ubyte DC:4 <values=tblSel>;   // destination 0 is actually installed
	} comp[nr_comp];
	// D10/D12: the spectral-selection bytes mean different things per process.
	if (jpgSofMarker == M_SOF3) {
		uchar Ss = { 1, 2, 3, 4, 5, 6, 7 };   // lossless: predictor selector
		uchar Se = { 0 };
	} else {
		uchar Ss = { 0 };                     // sequential: the full 0-63 band
		uchar Se = { 63 };                    // D13: Se is never below Ss
	}
	uchar Ah : 4 <values=zeroNib>;            // D10: no successive approximation
	uchar Al : 4 <values=zeroNib>;
	// D01/S34: the scan header length is 6 + 2*nr_comp and counts its own two
	// bytes.  Generate the payload, then rewrite the length with what was
	// actually written; for a real file the two already agree.
	local int64 sosEnd = FTell();
	local WORD sosSz = sosEnd - sosStart + 2;
	if (szSection != sosSz) {
		FSeek(sosLenPos);
		local int evilSos = SetEvilBit(false);
		WORD szSection = { sosSz };
		SetEvilBit(evilSos);
		FSeek(sosEnd);
	}
} SOS;

typedef struct tagUNK {
	M_ID UnknownMarker;
	//Warning("Unknown Section 0x%08x %s", UnknownMarker, EnumToString(UnknownMarker));
	// D60/S34: every length-carrying segment counts its own two length bytes,
	// so 2 is the floor.  This is the one length in the template with an
	// overrun guard, which is exactly why an unbounded value here is the
	// cheapest way to make a 64 KB file out of one 2-byte field.
	WORD szSection = { 4, 8, 16, 32 };
	// JpegFileEnd is zero for the top-level datastream now that its length is
	// no longer invented up front (see the JPGFILE comment); the guard applies
	// only to a nested thumbnail, whose end really is known.
	if (JpegFileEnd && FTell() + szSection - 2 >= JpegFileEnd) {
		Warning("unknown section length pass the end of jpeg file");
		ubyte unknown[JpegFileEnd - FTell()];
	} else {
		ubyte unknown[szSection-2];
	}
} UNKNOWN;

typedef struct tagDHT {
	M_ID marker;
	// D62/S32: szSection - 2 must decompose exactly into whole tables of
	// 17 + sum(BITS) bytes, or the loop below overshoots into the following
	// segment.  Each generated table is 33 bytes, and two of them - one DC and
	// one AC, the minimum a baseline scan needs (S06/D18) - make the segment
	// exactly 68.  A real file's length falls outside this set and is parsed
	// through the evil escape, after which the loop follows its own tables.
	ReadBytes(jpgIdPeek, FTell(), 2, dhtLenPref, dhtLenPref, 1.0);
	local int evilDht = SetEvilBit(false);
	WORD szSection = { 68 };
	SetEvilBit(evilDht);
	local int huffsz = szSection - 2;   // signed, for the same underflow reason
	                                    // as DQT's counter
	jpgHtIdx = 0;
	while(huffsz > 0) {
		ChangeColor(0);
		struct Huffmann_Table {
			// D64: the class in the packed info byte bounds the table; emit
			// destination 0 of class 0 (DC) then class 1 (AC).
			if (jpgHtIdx == 0)
				ReadBytes(jpgIdPeek, FTell(), 1, htDcPref, htDcPref, 1.0);
			else
				ReadBytes(jpgIdPeek, FTell(), 1, htAcPref, htAcPref, 1.0);
			local int evilHt = SetEvilBit(false);
			ubyte htInfo = { (ubyte)(jpgHtIdx * 16) };
			SetEvilBit(evilHt);
			jpgHtIdx++;
			// A native array cannot carry known values, so the sixteen code
			// counts are pinned through the bitmap instead.
			ReadBytes(jpgFixedPeek, FTell(), 16, htBitsVal, htBitsVal, 1.0);
			ubyte length[16];
			local int sumLen = 0;
			local int i = 0;
			for(;i<16;i++) {
				sumLen += length[i];
			}
			// Only pin the symbols when the counts really are the generated
			// ones; a real file reaches here with its own sum.
			if (sumLen == 16)
				ReadBytes(jpgFixedPeek, FTell(), 16, htValVal, htValVal, 1.0);
			ubyte HTV[sumLen];
		} huff_table;
		huffsz -= sizeof(huff_table);
	}
} DHT;

typedef struct tagDQT {
	M_ID marker;
	// D63/S33: szSection - 2 must decompose exactly into whole tables of
	// 1 + 64*(1 + Pq) bytes.  One 8-bit table is 65, so the segment is 67.
	ReadBytes(jpgIdPeek, FTell(), 2, dqtLenPref, dqtLenPref, 1.0);
	local int evilDqt = SetEvilBit(false);
	WORD szSection = { 67 };
	SetEvilBit(evilDqt);
	// Declared `local WORD` in the original, which is unsigned: one table
	// bigger than the remaining count - a 16-bit table where Pq said 8-bit -
	// makes the subtraction below wrap to 65472 and the loop writes a further
	// sixty-four kilobytes of quantization tables.  A signed counter ends the
	// loop instead, which is what the length was describing all along.
	local int qtsz = szSection - 2;
	while(qtsz > 0) {
		ChangeColor(0);
		struct QuanTable {
			uchar Pq : 4 <values=zeroNib>;   // D14: 8-bit samples, 8-bit table
			uchar Tq : 4 <values=zeroNib>;   // D17/S05: destination 0
			if (Pq == 0) {
				// D15: sixty-four coefficients, each 1-255 and non-zero
				// because a decoder divides by them.  Pinned through the
				// bitmap, since a native array takes no known values.
				ReadBytes(jpgFixedPeek, FTell(), 64, qtVal, qtVal, 1.0);
				byte qTable[64];
			}
			else
				uint16 qTable[64];           // D16: 16-bit precision, 128 bytes
		} qtable;
		qtsz -= sizeof(qtable);
	}
} DQT;

typedef struct tagDRI {
	M_ID marker;
	WORD szSection = { 4 };   // fixed_result: two length bytes plus Ri
	// D21/S15/S16: a non-zero restart interval obliges the entropy-coded data
	// to carry an RSTn marker after exactly every Ri MCUs, cycling through the
	// eight codes.  A generator that does not synthesise real entropy-coded
	// output cannot satisfy that, so the interval is disabled instead.
	WORD Ri = { 0 };
} DRI;

typedef struct tagDHP {
	M_ID marker;
	// D02: the DHP segment uses the frame header syntax, so its length is
	// 8 + 3*Nf.  DHP is not proposed by the marker sets, so this branch is
	// reached only when parsing a hierarchical datastream.
	WORD szSection = { 11 };
	uchar P = { 8, 12, 16 };
	uint16 Y <min=1, max=64>;                // spec 0..65535; a decoder
	uint16 X <min=1, max=64>;                // allocates Y*X*Nf on sight
	uchar Nf = { 1 };
	struct {
		uchar id = { 1 };
		uchar h_factor : 4 <values=oneNib>;  // D19: MCU capped at ten units
		uchar v_factor : 4 <values=oneNib>;
		uchar Tq = { 0 };
	} component_param[Nf];
} DHP;

typedef struct tgSOFx {
	M_ID marker;
	local int64 sofLenPos = FTell();
	WORD szSection;
	local int64 sofStart = FTell();
	// D06/D07/D08: the sample precision the process allows depends on which
	// SOF marker introduced the frame.
	if (marker == M_SOF0)
		ReadBytes(jpgIdPeek, FTell(), 1, precB, precB, 1.0);
	else if (marker == M_SOF3)
		ReadBytes(jpgIdPeek, FTell(), 1, precL, precL, 1.0);
	else
		ReadBytes(jpgIdPeek, FTell(), 1, precE, precE, 1.0);
	local int evilPrec = SetEvilBit(false);
	if (marker == M_SOF0)
		ubyte precision = { 8 };                       // baseline: 8-bit only
	else if (marker == M_SOF3)
		ubyte precision = { 2, 4, 8, 12, 16 };         // lossless: 2..16
	else
		ubyte precision = { 8, 12 };                   // extended/progressive
	SetEvilBit(evilPrec);
	// D20/S17: a zero line count defers the height to a DNL segment at the end
	// of the first scan, which this template has no branch for - so never emit
	// one.  The spec bound is 0..65535, but a decoder allocates
	// Y_image * X_image * nr_comp sample bytes the moment it reads the frame
	// header, which at the spec maximum is a 12 GB allocation from four bytes.
	// FindFirst places the scan terminator 0-15 bytes ahead when generating,
	// so the entropy-coded data is at most fifteen bytes and the frame has to
	// be small enough for that to fill its MCUs; 1-8 keeps a single-MCU image
	// in every case.  The JSON's generation bound of 64 assumes a generator
	// that synthesises its own scan data.
	WORD Y_image <min=1, max=8>;
	WORD X_image <min=1, max=8>;
	// T.81 allows 1..255 but no real image exceeds 4, and 255 components is
	// 765 bytes of phantom records that desynchronise the segment.  Greyscale
	// is weighted ahead of YCbCr because each extra component is three more
	// bytes of frame header and three more nibbles the evil bit can reach.
	ReadBytes(jpgIdPeek, FTell(), 1, nc13, nc13, 1.0);
	local int evilNc = SetEvilBit(false);
	ubyte nr_comp = { 1, 3 };
	SetEvilBit(evilNc);
	jpgSofMarker = marker;
	jpgNrComp = nr_comp;
	jpgCompId = 1;
	ChangeColor(0);
	struct COMPS {
		// D05: the scan header echoes this identifier exactly; numbering the
		// components 1..Nf is what real encoders do.
		if (jpgCompId == 1)
			ReadBytes(jpgIdPeek, FTell(), 1, cid1, cid1, 1.0);
		else if (jpgCompId == 2)
			ReadBytes(jpgIdPeek, FTell(), 1, cid2, cid2, 1.0);
		else
			ReadBytes(jpgIdPeek, FTell(), 1, cid3, cid3, 1.0);
		local int evilCid = SetEvilBit(false);
		ubyte compId = { (ubyte)jpgCompId };
		SetEvilBit(evilCid);
		jpgCompId++;
		ubyte Horz:4 <values=oneNib>;   // D19: sum of Horz*Vert over the frame
		ubyte Vert:4 <values=oneNib>;   // must not exceed ten data units
		ubyte compNr = { 0 };           // D17/S05: quantization destination 0
	} comp[nr_comp];
	// D00/S34: the frame header length is 8 + 3*nr_comp, counting itself.
	local int64 sofEnd = FTell();
	local WORD sofSz = sofEnd - sofStart + 2;
	if (szSection != sofSz) {
		FSeek(sofLenPos);
		local int evilSof = SetEvilBit(false);
		WORD szSection = { sofSz };
		SetEvilBit(evilSof);
		FSeek(sofEnd);
	}
} SOFx;

typedef struct tagCOMMENT {
	M_ID CommentMarker;
	// S14/D60: a comment may be any length, but the template also allocates a
	// local buffer of szSection - 1 bytes and walks it, so an unbounded value
	// here is both a big file and a long loop.
	WORD szSection = { 4, 8, 16, 32 };
	char comment[szSection-2];


	local char comments[szSection-1] = {0};
	local int i = 0;
	Memcpy(comments,comment,szSection-2);
	for(i=0;i<szSection-1;i++) {
		if(comments[i]==0) comments[i] = 'x';
	}
	comments[szSection-2] = 0;
	Printf("\nCOMMENT :\n%s\n\n",comments);

} COMMENT<read=ReadComment>;

typedef struct tagJPGLS {
    M_ID marker;
    // D03: the JPEG-LS frame header follows the T.81 frame syntax, so its
    // length is 8 + 3*Nf; the template reads only the first component record
    // and dumps the rest into uknown[].  JPGLS is not proposed by the marker
    // sets, so this branch is reached only when parsing.
    WORD szSection = { 11 };

    uchar precision <min=2, max=16, comment="bits per sample">;
    WORD Y_numlines <min=1, max=64>;      // spec 0..65535; same allocation
    WORD X_numcols <min=1, max=64>;       // blow-up as SOFx
    uchar Nf = { 1 } <comment="number of components in frame">;
    uchar C_compID = { 1 };
    uchar sub_sampling = { 0x11 };        // JPEG-LS allows only Hi = Vi = 1
    uchar Tq = { 0 } <comment="always 0">;

    if (11 < szSection)
		uchar uknown[szSection - 11];
} JPGLS;

string ReadComment( COMMENT &com )
{
	return com.comment;
}

// The original set JpegFileEnd = FileSize() here.  In the generation
// direction FileSize() invents a random target length of up to 64 KB and pads
// the output to it before a single byte of JPEG is written, which is why the
// unmodified template emits 3-65 KB files that are mostly 0xFF filler.  The
// top-level datastream therefore leaves JpegFileEnd at 0, meaning "not known
// in advance"; a nested thumbnail still sets it to the computed end of the
// region that contains it, and every use below is guarded on it being set.
JpegFileEnd = 0;

// ------------------------------------------------------------
// JPEG file

SetBackColor(jetMap[0]);
typedef struct tgJPGFile {
	local int was_bigendian = IsBigEndian();
	BigEndian();
	local WORD NextMarker;
	local quad fpos2;
    local quad endpos;
	local byte bEOI = 0;
	// S21: the original walks markers until end of file, which in the
	// generation direction means walking until a randomly invented one.  The
	// walk is replaced by the ordering state machine of T.81 Annex B: a fixed
	// SOI, a bounded header run, the quantization and Huffman tables the frame
	// and scan actually reference (S05/S06/D17/D18), one frame header
	// (S02/S04), one scan header, bounded scan data and a fixed EOI.
	// These four are struct-local so a nested thumbnail parse gets its own.
	local int jpgPhase = 0;   // 0 SOI, 1 headers, 2 DQT seen, 3 DHT seen, 4 frame seen
	local int jpgSeg = 0;     // segments emitted at this nesting level
	jpgNest++;
	while(!bEOI && jpgSeg < 40 && (JpegFileEnd == 0 || FTell() < JpegFileEnd)) {
		// Steer the marker about to be written.  ReadBytes() pins the two
		// bytes at FTell(), so both the switch below and the segment struct it
		// dispatches to see the marker before a byte of it is written.
		if (jpgPhase == 0)
			ReadBytes(jpgMarkerPeek, FTell(), 2, mkSOI, mkSOI, 1.0);
		else if (jpgPhase == 1) {
			if (jpgSeg >= 10)
				ReadBytes(jpgMarkerPeek, FTell(), 2, mkDQT, mkAny, 1.0);
			else
				ReadBytes(jpgMarkerPeek, FTell(), 2, mkHdr, mkAny, 1.0);
		} else if (jpgPhase == 2)
			ReadBytes(jpgMarkerPeek, FTell(), 2, mkDHT, mkAny, 1.0);
		else if (jpgPhase == 3)
			ReadBytes(jpgMarkerPeek, FTell(), 2, mkSOF, mkAny, 1.0);
		else {
			if (jpgSeg >= 16)
				ReadBytes(jpgMarkerPeek, FTell(), 2, mkSOS, mkAny, 1.0);
			else
				ReadBytes(jpgMarkerPeek, FTell(), 2, mkHdr2, mkAny, 1.0);
		}

		// skip optional 0xff before marker (S20).  The peek carries the marker
		// value set so that in the generation direction it reproduces the
		// steered marker instead of planting a random word over it.
		while (ReadUShort(FTell(), mkValues) == 0xffff) FSkip(1);

		// The marker itself is evil_bit_safe=false.  Reading it back with the
		// evil bit off is safe in both directions: on generation the bitmap
		// already holds a value from the set, and on parsing a marker outside
		// the set leaves no compatible candidate, which returns the raw value
		// without consulting the evil bit at all.
		local int evilMk = SetEvilBit(false);
		NextMarker  = ReadUShort(FTell(), mkValues);
		SetEvilBit(evilMk);
		switch(NextMarker) {
		case M_SOI:
			M_ID SOIMarker;
			Printf("Start of Image Marker\n");
			break;
		case M_SOS:
			SOS  scanStart;
			Printf("Start of Scan Marker\n");
			// FindFirst places the terminator only 0-15 bytes ahead when
			// generating, which is sometimes not enough to fill even one MCU,
			// so a short fixed run of entropy-coded data is emitted first
			// (D22: printable ASCII, so no byte of it can be mistaken for a
			// marker).  On the parse side these are simply the first bytes of
			// the real scan, which is why the run is four bytes and not the
			// thirty-two that would suit generation better: a solid-colour
			// JPEG can have an entropy-coded segment only seven bytes long,
			// and reading past it fails the parse outright.
			ReadBytes(jpgFixedPeek, FTell(), 4, scanLeadVal, scanLeadVal, 1.0);
			char scanLead[4];
			// S08: the scan header is followed by entropy-coded data that runs
			// unbroken to the terminator.  FindFirst plants the EOI 0-15 bytes
			// ahead when generating and locates the real one when parsing, so
			// the same expression bounds the scan in both directions.
			fpos2 = FindFirst(M_EOI, true, false, FINDMETHOD_NORMAL, 0.0, 1, FTell());
            if( fpos2 < 0 )
            {
			    // S01: the datastream must end with EOI.  On generation this is
			    // the one-in-128 case where FindFirst declines to plant one; on
			    // parsing it is a truncated file.  Emit a short scan and the
			    // terminator rather than swallowing the rest of the file, which
			    // at top level no longer has a known end.
			    char unterminatedScanData[8];
			    Printf("Missing End of File marker\n");
			    local int evilE1 = SetEvilBit(false);
			    M_ID EOIMarker = { M_EOI };
			    SetEvilBit(evilE1);
            }
            else
            {
			    char scanData[fpos2 - FTell()];
			    ChangeColor(1);
			    // S01: the terminator is a marker and must never receive an
			    // evil value.  FindFirst already pinned 0xFFD9 at this
			    // position, so the parse direction never needs an escape here.
			    local int evilE2 = SetEvilBit(false);
			    M_ID EOIMarker = { M_EOI };
			    SetEvilBit(evilE2);
			    Printf("End of File Image\n");
			    if (JpegFileEnd) {
			        if(JpegFileEnd - FTell()) char unknownPadding[JpegFileEnd - FTell()] <bgcolor=cSilver>;
			    } else {
			        // S18: a conforming datastream ends at EOI.  Consuming the
			        // tail one byte at a time asks FEof() instead of FileSize()
			        // - exact in the parse direction, and on generation it says
			        // "end of file" 253 times in 256 so almost nothing trails
			        // the terminator.
			        local int padCount = 0;
			        while (!FEof(0.99) && padCount < 4096) {
			            char unknownPadding <bgcolor=cSilver>;
			            padCount++;
			        }
			    }
            }
			bEOI = 1;
			break;
		case M_APP0:
			APP0 app0;
			break;
		case M_DHT:
			DHT dht;
			break;
		case M_DQT:
			DQT dqt;
			break;
		case M_DRI:
			DRI dri;
			break;
		case M_DHP:
			DHP dhp;
			break;
		case M_SOF0:
			SOFx sof0;
			break;
		case M_SOF1:
			SOFx sof1;
			break;
		case M_SOF2:
			SOFx sof2;
			break;
		case M_SOF3:
			SOFx sof3;
			break;
		case M_APP1:
			APP1 app1;
			break;
		case M_APP2:
			APP2 app2;
			break;
		case M_APP12:
			APP12 app12;
			break;
		case M_APP13:
			APP13 app13;
			break;
		case M_APP14:
			APP14 app14;
			break;
		case M_COMM:
			COMMENT comment;
			break;
        case M_JPGLS:
            JPGLS jpgls;
            break;
		default:
			if (ReadUByte(FTell()) == 0xff) {
				UNKNOWN unknownSection;
			} else {
				// S19: a conforming datastream has no bytes between segments.
				// This byte is only reachable when the peek above produced a
				// value whose high byte is not 0xFF, which the marker sets
				// above never propose.
				char garbage;
			}
			break;
		}
		// advance the state machine (S00, S04, S05, S06)
		if (NextMarker == M_SOI)
			jpgPhase = 1;
		else if (NextMarker == M_DQT && jpgPhase == 1)
			jpgPhase = 2;
		else if (NextMarker == M_DHT && jpgPhase == 2)
			jpgPhase = 3;
		else if (NextMarker >= M_SOF0 && NextMarker <= M_SOF3 && jpgPhase == 3)
			jpgPhase = 4;
		jpgSeg++;
		ChangeColor(!bEOI);
	}
	jpgNest--;
	if (!was_bigendian)
		LittleEndian();
} JPGFILE;

JPGFILE jpgfile <open=true>;
