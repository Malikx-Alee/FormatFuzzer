//------------------------------------------------
//--- 010 Editor v2.0 Binary Template
//
//      File: JPG.bt
//   Authors: Ibrahim Onaran
//    E-mail: onaran AT gmail DOT com
//   Version: 1.6.4
//   Purpose: Template for JPG image files. 
//  Category: Image
// File Mask: *.jpg,*.jpeg
//  ID Bytes: FF D8 FF
//   History: 
//   1.6.4 2018-12-20 Denis Anisimov: COMPSOS bug fixed.
//   1.6.3 2018-01-04 I Onaran: Changed author information.
//   1.6.2 2016-11-29 Bartosz Dziewonski: Search for end of file marker forwards rather than backwards.
//                    Data after the marker may contain bytes that look just like the marker itself.
//                    Also, use FindFirst() for better performance.
//   1.6.1 2016-10-18 Bartosz Dziewonski: Don't fail when garbage bytes are present
//                    between JPEG sections.
//   1.6   2016-10-18 SweetScape: Handle when end of file marker is not found.
//   1.5   2016-01-28 Pergamon: Added Sof3 support and set padded bytes color to silver.
//   1.4.1 2016-06-14 Bartosz Dziewonski: Don't fail when parsing IFD where the offset of data for
//                    final entry is before the structure offset.
//   1.4   2016-01-28 SweetScape: Updated header for repository submission, added open attribute.
//   1.3   2014-11-03 SweetScape: Fixed using FTell instead of Ftell. 
//   1.2   2012-10-04 dxp: Added JPEG-LS marker structure.
//   1.1   2009-03-14 Kuang-che Wu: Fix parse fail if encounter unknown APP1,
//                    fix uShort typo,
//                    parse inlined EXIF data correctly,
//                    recognize more sections and fields, especially EXIF tags, GPS tags, and CIFF tags
//                    and many improvements.
//   1.0   Mor FTP:   Initial release.
//
// This is a detailed JPEG File analysis.
// Features
//  1. Huffmann and quantization tables.
//  2. Exif (APP1) information including jpeg and other thubnail images
//  3. SOS, SOF0, JIFF and APP0 sections
//
// Note : This code doesn't parse all known sections. The reson is the application sections
//  contain camera specific information and this information sometimes is not public or
//  related to the camera and not important for image display softwares.
//
// New Features: Parses MakerNote for casio qv-r62
//
// references:
// JPEG		http://www.w3.org/Graphics/JPEG/itu-t81.pdf
// JFIF		http://www.w3.org/Graphics/JPEG/jfif3.pdf
// EXIF		http://www.exif.org/Exif2-2.PDF
// CIFF		http://xyrion.org/ciff/CIFFspecV1R04.pdf
// exiftool	http://www.sno.phy.queensu.ca/~phil/exiftool/
// JPEG-LS	http://www.itu.int/rec/T-REC-T.87-199806-I/en
//
//--- GENERATIVE VARIANT ------------------------------------------------------
// Rewritten for FormatFuzzer from templates_originals/jpg-orig.bt, driven by
// llm_learned_specification/llm_reterived_constraints_jpg-llm_opus5.json.
// Edits are confined to: declared value sets, declared numeric ranges,
// lookahead-steered marker and identifier dispatch, back-patched segment
// lengths, and the replacement of the original's `while(FTell() < JpegFileEnd)`
// marker walk with the ordering state machine T.81 Annex B actually mandates
// (structure rules S00-S35).  Every parser-side check of the original is
// retained.  References of the form Dnn / Snn point at the `dependencies` and
// `structure` entries of the constraints JSON.
//
// Two properties of the template language shaped these edits.  A native
// (non-char) array cannot carry known values, because ffcompile emits no
// generate(size, values) overload for one, so the fixed-shape tables are
// pinned through a ReadBytes lookahead that writes them into the bitmap
// instead.  And pfp's lexer is exponential in the number of escape sequences
// in one string literal - sixteen is instant, twenty-eight never finishes -
// which is why the quantization constant below is spelled with a printable
// character rather than \x41.
//--------------------------------------

// set left to right for both endian
LittleEndian(); BitfieldLeftToRight();
BigEndian(); BitfieldLeftToRight();

local quad JpegFileEnd = 0;
local int colorId = 0;
local int colorSelect = 0;
local DWORD clr = 0;
local DWORD jetMap[6*3] = { // blue, red green
	0x0000cc,0x0000ff,0x0033ff,0x0066ff,0x0099ff,0x00ccff,
	0x00ffff,0x33ffcc,0x66ff99,0x99ff66,0xccff33,0xffff00,
	0xffcc00,0xff9900,0xff6600,0xff3300,0xff0000,0xcc0000
};
local char CameraMake[32];
local char CameraModel[40];

local string stack_IFD_dirtype = "";

// ------------------------------------------------------------
// Generation state and the value sets that drive it.
//
// ffcompile mines one global set of lookahead values per Read* function and
// lets it override the per-call-site sets; clearing them makes the sets below
// the only markers and identifiers the generator will ever propose.
const local string ReadBytesInitValues[0];
const local ushort ReadUShortInitValues[0];

local int  jpgNest = 0;       // nested-thumbnail recursion depth (S22)
local WORD jpgSofMarker = 0;  // the frame header actually chosen, for D06-D12
local int  jpgNrComp = 1;     // that frame's component count, for D04
local int  jpgCompId = 1;     // running component identifier, for D05
local int  jpgHtIdx = 0;      // running Huffman table class, for D64
local char jpgMarkerPeek[2];  // the marker about to be written
local char jpgIdPeek[32];     // the segment identifier about to be written
local char jpgFixedPeek[64];  // fixed-shape table contents

// Every marker is 0xFF plus a code (S34).  ReadBytes() disables the evil bit
// for its *preferred* set and restores it for its *possible* set, so passing
// p=1.0 with the phase's own list as `preferred` and a broad list as
// `possible` buys both properties at once: generation draws a legal marker
// from the phase's list 255 times in 256 with no evil escape at all, while the
// parse direction still resolves any marker a real JPEG carries.  A code
// repeated in a preferred set is drawn proportionally more often, which is how
// the phase-advancing marker outweighs the optional ones and keeps the header
// run inside S21's budget.
local string mkSOI[]  = { "\xff\xd8" };                                    // S00
local string mkSOS[]  = { "\xff\xda" };                                    // S03
local string mkDQT[]  = { "\xff\xdb" };                                    // S05
local string mkDHT[]  = { "\xff\xc4" };                                    // S06
// S07/S13/S14: APPn, COM and the tables are header segments and must precede
// the scan they affect.
local string mkHdr[]  = { "\xff\xdb", "\xff\xdb", "\xff\xdb", "\xff\xdb",
                          "\xff\xe0", "\xff\xe1", "\xff\xe2", "\xff\xec",
                          "\xff\xed", "\xff\xee", "\xff\xfe" };
// S02/S04: exactly one frame header, before the scan.  SOF2 (progressive) is
// excluded from generation: a progressive frame needs a sequence of scans with
// matching successive-approximation parameters (D11), which a single-scan
// generator cannot satisfy.
local string mkSOF[]  = { "\xff\xc0", "\xff\xc0", "\xff\xc0", "\xff\xc1" };
// S15: at most one DRI; S14: comments may go anywhere before EOI.
local string mkHdr2[] = { "\xff\xda", "\xff\xda", "\xff\xda", "\xff\xda",
                          "\xff\xdd", "\xff\xfe", "\xff\xc4" };
// The markers a real JPEG carries *between* segments, used as the `possible`
// set so the parse direction rarely needs an evil decision on an ordinary
// file.  SOI, EOI, the RST markers and the hierarchical and JPEG-LS frame
// codes are deliberately absent: they never appear here in a real datastream,
// and leaving them in means the one-in-256 draw that reaches this set can put
// a second SOI or an unsupported frame code in the middle of the stream.  A
// file that really does carry one still parses, through the evil escape.
// SOF9-SOF11 and DAC are arithmetic-coding codes that no common decoder
// implements, so they are out too: drawing one puts a frame header in the
// stream that is individually legal and universally rejected.
local string mkAny[]  = { "\xff\xc0", "\xff\xc1", "\xff\xc2", "\xff\xc3",
                          "\xff\xc4", "\xff\xda", "\xff\xdb", "\xff\xdd",
                          "\xff\xe0", "\xff\xe1", "\xff\xe2", "\xff\xe3",
                          "\xff\xe4", "\xff\xe5", "\xff\xe6", "\xff\xe7",
                          "\xff\xe8", "\xff\xe9", "\xff\xea", "\xff\xeb",
                          "\xff\xec", "\xff\xed", "\xff\xee", "\xff\xef",
                          "\xff\xfe" };
// Every value M_ID can hold, so the switch below can read the pinned marker
// back as an integer without needing an evil decision in either direction.
local ushort mkValues[] = {
	0xFFC0, 0xFFC1, 0xFFC2, 0xFFC3, 0xFFC4, 0xFFC5, 0xFFC6, 0xFFC7,
	0xFFC8, 0xFFC9, 0xFFCA, 0xFFCB, 0xFFCC, 0xFFCD, 0xFFCE, 0xFFCF,
	0xFFD0, 0xFFD1, 0xFFD2, 0xFFD3, 0xFFD4, 0xFFD5, 0xFFD6, 0xFFD7,
	0xFFD8, 0xFFD9, 0xFFDA, 0xFFDB, 0xFFDC, 0xFFDD, 0xFFDE, 0xFFDF,
	0xFFE0, 0xFFE1, 0xFFE2, 0xFFE3, 0xFFE4, 0xFFE5, 0xFFE6, 0xFFE7,
	0xFFE8, 0xFFE9, 0xFFEA, 0xFFEB, 0xFFEC, 0xFFED, 0xFFEE, 0xFFEF,
	0xFFF0, 0xFFF1, 0xFFF2, 0xFFF3, 0xFFF4, 0xFFF5, 0xFFF6, 0xFFF7,
	0xFFF8, 0xFFF9, 0xFFFA, 0xFFFB, 0xFFFC, 0xFFFD, 0xFFFE, 0xFFFF };

// Nibble-wide value sets.  A bitfield takes its values through <values=...>,
// and the array must be `ubyte` rather than `uchar`: ffcompile maps a uchar
// array to std::string and only a ubyte array to the std::vector<ubyte> the
// bitfield's generate() expects.
local ubyte zeroNib[] = { 0 };    // D10/D14/D17: table 0, no approximation
local ubyte oneNib[]  = { 1 };    // D19: sampling factors of 1, MCU of Nf units
local ubyte tblSel[]  = { 0 };    // D09/D18: entropy table destination 0

// Fixed-shape table contents, pinned through the bitmap.
// BITS = sixteen counts of one symbol each.  T.81 B.2.4.2 forbids an
// over-subscribed code; this assignment is always valid, because the running
// code after n lengths is 2^n - 2 and never reaches 2^n.
local string htBitsVal[] = { "\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01" };
// HUFFVAL: sixteen symbols, every one <= 15, so the table is legal as a DC
// table as well as an AC one (D64).
local string htValVal[] = { "\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x0f" };
// Sixty-four quantization coefficients of 65 ('A'), inside D15's 1-255 and
// non-zero, which matters because a decoder divides by them.  Spelled as
// printable characters because sixty-four \x escapes do not finish parsing.
local string qtVal[] = { "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" };

// Segment identifiers.  Pinning these before the length field is what lets the
// length be derived from the segment shape the identifier selects.
local string app0Pref[] = { "JFIF\0" };                                     // S09
local string app0Poss[] = { "JFIF\0", "JFXX\0" };
local string app1Pref[] = { "Exif\0\0" };                                    // S10/S27
local string app1Poss[] = { "Exif\0\0" };
local string app14Pref[] = { "Adobe" };
local string app14Poss[] = { "Adobe" };
local string tiffAlign[] = { "MM", "II" };                                  // D33
local short jfifVerHi[] = { 1 };                                            // JFIF 1.x
local short jfifVerLo[] = { 1, 2 };
// D22/S35: byte stuffing is what keeps entropy-coded data distinguishable
// from markers.  A printable-ASCII run contains no 0xFF at all, which is the
// cheapest way to honour that rule without synthesising real Huffman output.
local string scanLeadVal[] = { "0123" };
// The two table segments are the only ones whose length drives a loop, so an
// out-of-set value there does not merely mislabel the segment - it makes the
// loop consume a different number of bytes than the length declares and every
// following marker lands inside table data.  Pinning the length through a
// lookahead and then declaring it with the evil bit off is exact in both
// directions: on generation the bitmap already holds the value, and on parsing
// a real file's length leaves no compatible candidate, which returns the raw
// value without consulting the evil bit at all.
// The `possible` set is passed the same list as `preferred` on purpose.  A
// wider set buys nothing in the parse direction - a length outside it resolves
// through the evil escape either way - while in the generation direction the
// one-in-256 draw that reaches it writes a length the loop below cannot
// decompose, and every later marker lands inside table data.
local string dqtLenPref[] = { "\x00\x43" };                        // 67 = 2 + 65
local string dhtLenPref[] = { "\x00\x44" };                        // 68 = 2 + 33 + 33
// D64: class 0 destination 0, then class 1 destination 0 - the DC and AC pair
// a baseline scan needs.  Pinned for the same reason as the segment lengths:
// an out-of-set class or destination names a table nothing ever defines.
local string htDcPref[] = { "\x00" };
local string htAcPref[] = { "\x10" };
// JFIF is version 1.x; an out-of-set major or minor makes every reader reject
// the segment outright, so both bytes get the same treatment.
local string jfifVerPref[] = { "\x01\x01" };
local string jfifVerPoss[] = { "\x01\x00", "\x01\x01", "\x01\x02" };
// D05: the frame numbers its components 1..Nf and the scan header echoes those
// identifiers exactly.  Pinned, because an out-of-set identifier names a
// component the frame never declared and the scan becomes undecodable.
local string cid1[]    = { "\x01" };
local string cid2[]    = { "\x02" };
local string cid3[]    = { "\x03" };
// D06/D07/D08: the precision a process allows depends on the SOF marker.
// D00/D01/D04: the component count sets both segment lengths and is echoed by
// the scan header.  An out-of-set value there does not merely add phantom
// records - it makes the scan name components the frame never declared, and a
// decoder rejects the segment on its length alone.
local string nc13[]    = { "\x01", "\x03" };
local string nc1[]     = { "\x01" };
local string nc3[]     = { "\x03" };
local string precB[]   = { "\x08" };          // baseline: 8-bit only
local string precE[]   = { "\x08", "\x0c" };  // extended: 8 or 12
local string precL[]   = { "\x08", "\x0c", "\x10", "\x02" };  // lossless: 2..16

enum IFD_dirtype {
	IFD_TYPE_EXIF = 1,
	IFD_TYPE_GEOTAG,
	IFD_TYPE_CASIO_QV_R62,
};

// ------------------------------------------------------------
// helper functions
void Stack_push(string &s, int x)
{
	s += (char)x;
}

void Stack_pop(string &s)
{
	s = SubStr(s, 0, Strlen(s) - 1);
}

int Stack_top(string &s)
{
	return s[Strlen(s) - 1];
}

string ReadStringN(int64 pos, int n)
{
	local uchar s[n];
	ReadBytes(s, pos, n);
	return s;
}

// ------------------------------------------------------------

void ChangeColor(byte bChangeColor) {
	if(bChangeColor == 1) {colorSelect++; colorId = 0;}
	clr = jetMap[(colorSelect%3)*6+(colorId%6)];
	SetBackColor(clr);
	//Printf("clrIdx = [%d %d], RGB(%d,%d,%d)\n",colorSelect,colorId,(clr>>16),(clr>>8)&0x00FF,clr&0x0000FF);
	colorId++;
}

// ------------------------------------------------------------
// JPEG
typedef enum <WORD> tagID
{
	M_SOF0  = 0xFFC0, // Start Of Frame N
	M_SOF1,// N indicates which compression process
	M_SOF2,// Only SOF0-SOF2 are now in common use
	M_SOF3,
	M_DHT, //Huffman Table
	M_SOF5,
	M_SOF6,
	M_SOF7,
	M_JPG,
	M_SOF9,
	M_SOF10,
	M_SOF11,
	M_DAC = 0xffcc,
	M_SOF13,
	M_SOF14,
	M_SOF15,
	M_RST0 = 0xffd0,
	M_RST1, M_RST2, M_RST3, M_RST4, M_RST5, M_RST6, M_RST7,
	M_SOI = 0xFFD8, // Start Of Image
	M_EOI,// End Of Image
	M_SOS,// Start Of Scan (begins compressed data)
	M_DQT,
	M_DNL,
	M_DRI,
	M_DHP,
	M_EXP,
	M_APP0 = 0xFFE0, // Jfif marker
	M_APP1,// Exif marker
	M_APP2,
	M_APP3,
	M_APP4,
	M_APP5,
	M_APP6,
	M_APP7,
	M_APP8,
	M_APP9,
	M_APP10,
	M_APP11,
	M_APP12,
	M_APP13,
	M_APP14,
	M_APP15,
	M_JPG0 = 0xfff0,
	M_JPG1, M_JPG2, M_JPG3, M_JPG4, M_JPG5, M_JPG6, M_JPGLS,
	M_JPG8, M_JPG9, M_JPG10, M_JPG11, M_JPG12, M_JPG13, M_JPG14, M_JPG15,
	M_COMM = 0xFFFE  // Comment
} M_ID <format=hex>;


