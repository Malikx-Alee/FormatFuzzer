//------------------------------------------------
//--- 010 Editor v2.0 Binary Template
//
//      File: ZIPAdv.bt
//    Author: SweetScape Software
//   Version: 2.7 (FormatFuzzer generation-optimized)
//   Purpose: Parse and generate ZIP archive files. Handles more
//            complex ZIP data such as ZIP64
//            that the base ZIP.bt cannot read.
//  Category: Archive
// File Mask: *.zip
//  ID Bytes: 50 4B //PK
//
// FormatFuzzer modifications (derived from
// results_ai/zip-orig/llm_reterived_constraints_zip-orig_opus4.7.json):
//  - Every record's own signature field (frSignature, ddSignature,
//    deSignature, dsSignature, elr64Signature, elSignature) is a
//    fixed_value: each is pinned via `= { S_XXX }` to its required
//    SignatureTYPE constant.
//  - COMPTYPE/HOSTOSTYPE/ALGFLAG/AESMODE/PRCFLAG were already the correct
//    enum types for their JSON enumerated_values sets (the JSON's
//    valid_values lists match the existing named enumerators exactly), so
//    FormatFuzzer's default enum-field generation already respects them;
//    no further change needed there.
//  - The imperative `while(!FEof())` main-loop tag dispatch (a raw ReadUInt
//    peek with an if/else-if chain and no ordering guarantees) is replaced
//    by a declarative, fixed-count `for` loop that emits exactly MAX_FILES
//    ZIPFILERECORDs followed by MAX_FILES matching ZIPDIRENTRYs (a local
//    file record and its central-directory entry no longer need to "agree"
//    by chance -- deHeaderOffset/deCrc/deCompressedSize/deUncompressedSize
//    are copied straight from the matching ZIPFILERECORD instance), then a
//    single mandatory ZIPENDLOCATOR. The optional trailer records (digital
//    signature, ZIP64 EOCD record + locator) are deliberately never
//    generated: real-world readers (Python's zipfile, notably) compute the
//    central directory's start as "EOCD offset - size_cd - offset_cd" and
//    treat any nonzero gap as leftover self-extracting-archive-stub bytes
//    prepended to the file, not as legitimate records between the central
//    directory and the EOCD -- so emitting them would silently break every
//    generated archive for those readers. Their struct definitions are
//    kept as-is so real-world files that do use them still parse
//    correctly.
//  - ZIPFILERECORD/ZIPDIRENTRY's frFileNameLength/frCompressedSize and
//    ZIPDIGITALSIG.dsDataLength/ZIPENDLOCATOR.elCommentLength are
//    calculated_value fields that already precede the data they size, so
//    each is simply generated as a real, range-constrained field and used
//    directly as the following array's bound -- self-consistent by
//    construction, no patch-back required. frFlags is pinned away from the
//    Encrypted/StrongEncrypted/DescriptorUsedMask bits so every generated
//    record takes ZIPFILERECORD's simple "plain compressed data follows"
//    branch (the strong-encryption and streaming-data-descriptor branches
//    have their own multi-field sub-shapes that the JSON does not
//    constrain and are out of scope for this pass); frExtraFieldLength is
//    likewise pinned to 0 (an empty, and therefore trivially
//    self-consistent, extra-field list) rather than driving EXTRAFIELD's
//    own deeply-nested per-header-ID sub-shapes (Zip64/NTFS/
//    StrongEncryption/WzAES), which the JSON also leaves unconstrained;
//    both fields, and the EXTRAFIELD/EXTRA64FIELD struct definitions
//    themselves, are left untouched so real-world files that do use them
//    still parse correctly.
//  - frCrc (a calculated_value CRC in spirit, per the JSON's "must match"
//    note on the adjacent size fields, and explicitly called out by the
//    task as a calculated_value example) is computed declaratively via
//    Checksum(CHECKSUM_CRC32, ...) over the actual compressed-data bytes
//    once they are written, and patched back into its placeholder slot.
//    frCompression/deCompression are pinned to COMP_STORED and
//    frUncompressedSize is set equal to frCompressedSize: no real codec is
//    implemented here, so frData is always written verbatim, and STORED is
//    the one COMPTYPE where a real reader (which decompresses the data and
//    compares CRC/size against the declared codec) accepts that directly.
//    VERECORD.Version is pinned to 20 ("2.0") since real readers reject
//    implausible version numbers and the JSON leaves it unconstrained.
//    frFlags/deFlags are pinned to 0 (also dropping FLAG_Utf8, since
//    frFileName's bytes are arbitrary fuzzed data that generally isn't
//    valid UTF-8) and, since real readers verify that a local header's
//    filename matches its central-directory entry byte-for-byte,
//    ZIPDIRENTRY's deFileNameLength/deFileName are copied straight from
//    the matching ZIPFILERECORD's frFileNameLength/frFileName rather than
//    generated independently (frFileNameLength's range is also [1, 32],
//    not [0, 32]: some real unzip implementations warn spuriously on a
//    genuinely empty, though otherwise-matching, entry name).
//  - ZIP64ENDLOCATORRECORD.elr64DirectoryRecordSize is pinned to 44 (the
//    full fixed-field record) instead of driving the original's
//    increasing-threshold conditional chain, so the record is always
//    completely and unambiguously populated.
//  - ZIPENDLOCATOR.elDirectoryOffset/elDirectorySize/elEntriesOnDisk/
//    elEntriesInDirectory are calculated_value fields: the offset where
//    the central directory begins and its total size are captured/derived
//    via FTell() as the central directory is written and referenced
//    directly (no patch-back needed, since ZIPENDLOCATOR is emitted after
//    the central directory), and the entry counts are simply MAX_FILES.
//   History:
//   2.7   2026-07-26 FormatFuzzer generation-optimization pass.
//   2.6   2015-07-18  SweetScape: Updated header for repository submission.
//   2.5   G Woods:    Handle zero compressed size in header with ZIPDATADESCR header
//                     after compressed data.
//   2.3   DCeres:     Added write function for VERECORD structure.
//                     Added write function for ZIP64ENDLOCATORRECORD structure.
//                     Added write function for ZIP64ENDLOCATOR structure.
//                     Added write function for EXTRAFIELD structure.
//   2.2   S.Gibson    Fix for entry comment field
//                     Fix for parsing data descriptors
//   2.1   SweetScape  Added write function for ZIPFILERECORD structure
//   2.0   SweetScape  Added read functions
//   1.0   SweetScape  Initial release
//
// More information available at:
//  https://en.wikipedia.org/wiki/Zip_%28file_format%29
//------------------------------------------------

// Define structures used in ZIP files

typedef enum <uint> {
	S_ZIPFILERECORD 		= 0x04034b50,
	S_ZIPDATADESCR 			= 0x08074b50,
	S_ZIPDIRENTRY 			= 0x02014b50,
	S_ZIPDIGITALSIG 		= 0x05054b50,
	S_ZIP64ENDLOCATORRECORD = 0x06064b50,
	S_ZIP64ENDLOCATOR 		= 0x07064b50,
	S_ZIPENDLOCATOR 		= 0x06054b50
} SignatureTYPE <format=hex>;

typedef enum <byte> {
	OS_FAT      = 0,
	OS_AMIGA    = 1,
	OS_VMS      = 2,  // VAX/VMS
	OS_Unix     = 3,
	OS_VM_CMS   = 4,
	OS_Atari    = 5,  // what if it's a minix filesystem? [cjh]
	OS_HPFS     = 6,  // filesystem used by OS/2 (and NT 3.x)
	OS_Mac      = 7,
	OS_Z_System = 8,
	OS_CPM      = 9,
	OS_TOPS20   = 10, // pkzip 2.50 NTFS
	OS_NTFS     = 11, // filesystem used by Windows NT
	OS_QDOS     = 12, // SMS/QDOS
	OS_Acorn    = 13, // Archimedes Acorn RISC OS
	OS_VFAT     = 14, // filesystem used by Windows 95, NT
	OS_MVS      = 15,
	OS_BeOS     = 16, // hybrid POSIX/database filesystem
	OS_Tandem   = 17,
	OS_OS400    = 18,
	OS_OSX      = 19
} HOSTOSTYPE;

typedef byte VERSIONTYPE <read=read_VERSIONTYPE>;

string read_VERSIONTYPE (local VERSIONTYPE &af) {
	local string s = "";
	SPrintf (s, "%1.1f", (float)af / 10);
	return s;
}

typedef struct{
	// Pinned to 20 (real "version 2.0"): common real-world archive readers
	// (e.g. Python's zipfile) reject implausibly large version numbers, and
	// the JSON does not otherwise constrain this field.
	VERSIONTYPE Version = { 20 };
	HOSTOSTYPE HostOS;
} VERECORD <read=read_VERECORD>;

string read_VERECORD (local VERECORD &af) {
	local string s = "";
	SPrintf (s, "Ver %1.1f, ", (float)af.Version / 10);
	s +=  EnumToString(  af.HostOS);
	return s;
}

//enum used for compression format
typedef enum <short> {
	COMP_STORED    		= 0,
	COMP_SHRUNK    		= 1,
	COMP_REDUCED1  		= 2,
	COMP_REDUCED2  		= 3,
	COMP_REDUCED3  		= 4,
	COMP_REDUCED4  		= 5,
	COMP_IMPLODED  		= 6,
	COMP_TOKEN     		= 7,
	COMP_DEFLATE   		= 8, // Deflate - standard ZIP codec, used from the start, also found in regular ZIP files
	COMP_DEFLATE64 		= 9,
	COMP_PKImploding 	= 10,

	COMP_BZip2			= 12, // BZIP2 - Newer than deflate, with better compression and slightly slower speed.
	COMP_LZMA 			= 14, // LZMA - advanced ZIPX codec, taken from open source 7-zip format
	COMP_Terse 			= 18,
	COMP_Lz77 			= 19,

	COMP_Jpeg 			= 0x60, // Jpeg - Codec added by WinZip for specific support of jpeg images ( http://www.winzip.com/wz_jpg_comp.pdf )
	COMP_WavPack		= 0x61, // WavPack - Codec for compressing specifically wav files. ( http://www.wavpack.com )
	COMP_PPMd 			= 0x62, // PPMd - context modeling based codec, also featured in new ZIP standard. We use it in our Optimized method for text file compression. ( http://www.compression.ru/ds/ )
	COMP_WzAES 			= 0x63  // WZAES encryption methods
} COMPTYPE;

typedef enum <ushort>{
	FLAG_Encrypted             = 0x0001, //Bit 0: If set, indicates that the file is encrypted.
	FLAG_CompressionFlagBit1   = 0x0002,
	FLAG_CompressionFlagBit2   = 0x0004,
	FLAG_DescriptorUsedMask    = 0x0008,
	FLAG_Reserved1             = 0x0010,
	FLAG_Reserved2             = 0x0020,
	FLAG_StrongEncrypted       = 0x0040, //Bit 6: Strong encryption
	FLAG_CurrentlyUnused1      = 0x0080,
	FLAG_CurrentlyUnused2      = 0x0100,
	FLAG_CurrentlyUnused3      = 0x0200,
	FLAG_CurrentlyUnused4      = 0x0400,
	FLAG_Utf8                  = 0x0800, // Bit 11: filename and comment encoded using UTF-8
	FLAG_ReservedPKWARE1       = 0x1000,
	FLAG_CDEncrypted           = 0x2000, // Bit 13: Used when encrypting the Central Directory to indicate selected data values in the Local Header are masked to hide their actual values.
	FLAG_ReservedPKWARE2       = 0x4000,
	FLAG_ReservedPKWARE3       = 0x8000,

} FLAGTYPE <read=read_FLAGTYPE>;

string read_FLAGTYPE (local FLAGTYPE &af) {
	local string s = "";
	local int commaNeeded = 0;
	local FLAGTYPE i = 1;

	SPrintf (s, "%d: ", af);
	while (i < FLAG_ReservedPKWARE3)
	{
		if (af & i)
		{
			if (commaNeeded)
			{ s += ", "; }
			s +=  EnumToString(i);
			commaNeeded = 1;
		}
		i = i << 1;
	}
	return s;
}

typedef enum <ushort>{
	EH_Zip64 = 					0x0001,		//Zip64 extended information extra field
	EH_AVInfo = 				0x0007,		//AV Info
	EH_ExtLanguage = 			0x0008,		//Reserved for extended language encoding data (PFS)
	EH_OS2 = 					0x0009,		//OS/2
	EH_NTFS = 					0x000a,		//NTFS
	EH_OpenVMS = 				0x000c,		//OpenVMS
	EH_UNIX = 					0x000d,		//UNIX
	EH_fileStream = 			0x000e,		//Reserved for file stream and fork descriptors
	EH_PatchDescriptor = 		0x000f,		//Patch Descriptor
	EH_PKCS7X509 = 				0x0014,		//PKCS#7 Store for X.509 Certificates
	EH_X509IDSignature = 		0x0015,		//X.509 Certificate ID and Signature for individual file
	EH_X509IDCD = 				0x0016,		//X.509 Certificate ID for Central Directory
	EH_StrongEncryption = 		0x0017,		//Strong Encryption Header
	EH_RecordManagement = 		0x0018,		//Record Management Controls
	EH_PKCS7List = 				0x0019,		//PKCS#7 Encryption Recipient Certificate List
	EH_Attributes = 			0x0065,		//IBM S/390 (Z390), AS/400 (I400) attributes uncompressed
	EH_ReservedAttributes = 	0x0066,		//Reserved for IBM S/390 (Z390), AS/400 (I400) attributes - compressed
	EH_POSZIP4690 = 			0x4690,		//POSZIP 4690 (reserved)
	EH_Mac = 					0x07c8,		//Macintosh
	EH_ZipItMac1 = 				0x2605,		//ZipIt Macintosh
	EH_ZipItMac2 = 				0x2705,		//ZipIt Macintosh 1.3.5+
	EH_ZipItMac3 = 				0x2805,		//ZipIt Macintosh 1.3.5+
	EH_InfoZIPMac = 			0x334d,		//Info-ZIP Macintosh
	EH_Acorn = 					0x4341,		//Acorn/SparkFS
	EH_WinNTSecurity = 			0x4453,		//Windows NT security descriptor (binary ACL)
	EH_VM_CMS = 				0x4704,		//VM/CMS
	EH_MVS = 					0x470f,		//MVS
	EH_FWKCS = 					0x4b46,		//FWKCS MD5 (see below)
	EH_OS2AccessList = 			0x4c41,		//OS/2 access control list (text ACL)
	EH_InfoZIPOpenVMS = 		0x4d49,		//Info-ZIP OpenVMS
	EH_Xceed = 					0x4f4c,		//Xceed original location extra field
	EH_AOSVS = 					0x5356,		//AOS/VS (ACL)
	EH_extTimestamp = 			0x5455,		//extended timestamp
	EH_XceedUnicode = 			0x554e,		//Xceed unicode extra field
	EH_InfoZIPUNIX = 			0x5855,		//Info-ZIP UNIX (original, also OS/2, NT, etc)
	EH_InfoZIPUnicodeComment = 	0x6375,		//Info-ZIP Unicode Comment Extra Field
	EH_BeOS = 					0x6542,		//BeOS/BeBox
	EH_InfoZIPUnicodePath = 	0x7075,		//Info-ZIP Unicode Path Extra Field
	EH_ASiUNIX = 				0x756e,		//ASi UNIX
	EH_InfoZIPUNIXNew = 		0x7855,		//Info-ZIP UNIX (16-bit UID/GID info)
	EH_InfoZIPUNIXNew3rd = 		0x7875,     //Info-ZIP UNIX 3rd generation (generic UID/GID, ...)
	EH_WinGrowth = 				0xa220,		//Microsoft Open Packaging Growth Hint
	EH_SMSQDOS = 				0xfd4a, 	//SMS/QDOS
    EH_WzAES                =   0x9901,      //
} HEADERFLAG;

typedef enum <ushort>{
    AlgID_DES       = 0x6601, //- DES
    AlgID_RC2OLD    = 0x6602, //- RC2 (version needed to extract < 5.2)
    AlgID_3DES168   = 0x6603, //- 3DES 168
    AlgID_3DES112   = 0x6609, //- 3DES 112
    AlgID_AES128    = 0x660E, //- AES 128
    AlgID_AES192    = 0x660F, //- AES 192
    AlgID_AES256    = 0x6610, //- AES 256
    AlgID_RC2       = 0x6702, //- RC2 (version needed to extract >= 5.2)
    AlgID_Blowfish  = 0x6720, //- Blowfish
    AlgID_Twofish   = 0x6721, //- Twofish
    AlgID_RC4       = 0x6801, //- RC4
    AlgID_Unknown   = 0xFFFF, //- Unknown algorithm
} ALGFLAG;

typedef enum <byte>{
    AES128 = 0x01, 	//128-bit encryption key
    AES192 = 0x02, 	//192-bit encryption key
    AES256 = 0x03, 	//256-bit encryption key
} AESMODE;

typedef enum <ushort>{
    pfPassword  = 0x0001, //- Password is required to decrypt
    pfCertificates = 0x0002, //- Certificates only
    pfPasswordCertificates = 0x0003, //- Password or certificate required to decrypt
}   PRCFLAG;

typedef struct {
	HEADERFLAG  efHeaderID;
	ushort  efDataSize;

	Printf("%d", efHeaderID);
	switch (efHeaderID)
	{
	case EH_Zip64:
		uint64 efOriginalSize;
		uint64 efCompressedSize;
		//uint64 efHeaderOffset;
		//uint   efDiskNumberStart;
		break;
	case EH_InfoZIPUnicodePath:
		byte efVersion;
		uint efNameCRC32;
		if(efDataSize > 0 )
		    char efUnicodeName[efDataSize - 5];
		break;
    case EH_NTFS:
        int Reserved;   //4 bytes    Reserved for future use
	    local int len = efDataSize - 4;
	    while (len > 0)
        {
            ushort Tag;        //2 bytes    NTFS attribute tag value #1
            ushort Size;       //2 bytes    Size of attribute #1, in bytes
            if (Tag == 0x001)
            {
                FILETIME Mtime;      //8 bytes    File last modification time
                FILETIME Atime;      //8 bytes    File last access time
                FILETIME Ctime;     //8 bytes    File creation time
            }
            else
                byte Data[Size]; //(var.)     Size1      Attribute #1 data
    		len -= Size + 4;
        }
        break;
    case EH_StrongEncryption:
        ushort  Format;    //2 bytes  Format definition for this record
        ALGFLAG AlgID;     //2 bytes  Encryption algorithm identifier
        ushort  Bitlen;    //2 bytes  Bit length of encryption key
        PRCFLAG Flags;     //2 bytes  Processing flags
        if (efDataSize > 8)
            byte    CertData[efDataSize - 8];  //TSize-8  Certificate decryption extra field data
        break;
    case EH_WzAES:
        ushort version;         //2 bytes   Integer version number specific to the zip vendor
        char VendorID[2] = { "AE" };  // fixed_value per JSON: WinZip AES vendor id
        AESMODE Strength;       //1 bytes   Integer mode value indicating AES encryption strength
        COMPTYPE deCompression; //2 bytes The actual compression method used to compress the file
        break;
	default:
		if(efDataSize > 0 )
		    char efData[ efDataSize ];
        break;
	}
} EXTRAFIELD <read=read_EXTRAFIELD>;

string read_EXTRAFIELD (local EXTRAFIELD &af)
{
	return EnumToString(af.efHeaderID);
}

typedef struct {
	HEADERFLAG  efHeaderID;
	uint  efDataSize;

	Printf("%d", efHeaderID);
	switch (efHeaderID)
	{
	case EH_Zip64:
		uint64 efOriginalSize;
		uint64 efCompressedSize;
		//uint64 efHeaderOffset;
		//uint   efDiskNumberStart;
		break;
	case EH_InfoZIPUnicodePath:
		byte efVersion;
		uint efNameCRC32;
		if(efDataSize > 0 )
		    char efUnicodeName[efDataSize - 5];
		break;
	default:
		if(efDataSize > 0 )
		    char efData[ efDataSize ];
        break;
	}
} EXTRA64FIELD;

typedef enum <uint>{
	FA_READONLY             = 0x00000001,
	FA_HIDDEN               = 0x00000002,
	FA_SYSTEM               = 0x00000004,
	FA_DIRECTORY            = 0x00000010,
	FA_ARCHIVE              = 0x00000020,
	FA_DEVICE               = 0x00000040,
	FA_NORMAL               = 0x00000080,
	FA_TEMPORARY            = 0x00000100,
	FA_SPARSE_FILE          = 0x00000200,
	FA_REPARSE_POINT        = 0x00000400,
	FA_COMPRESSED           = 0x00000800,
	FA_OFFLINE              = 0x00001000,
	FA_NOT_CONTENT_INDEXED  = 0x00002000,
	FA_ENCRYPTED            = 0x00004000,
	FA_VIRTUAL              = 0x00010000,

    kIFMT   =   0170000 << 16,     /* Unix file type mask */

    kIFDIR  =   0040000 << 16,     /* Unix directory */
    kIFREG  =   0100000 << 16,     /* Unix regular file */
    kIFSOCK =   0140000 << 16,     /* Unix socket (BSD, not SysV or Amiga) */
    kIFLNK  =   0120000 << 16,     /* Unix symbolic link (not SysV, Amiga) */
    kIFBLK  =   0060000 << 16,     /* Unix block special       (not Amiga) */
    kIFCHR  =   0020000 << 16,     /* Unix character special   (not Amiga) */
    kIFIFO  =   0010000 << 16,     /* Unix fifo    (BCC, not MSC or Amiga) */

    kISUID  =   04000 << 16,       /* Unix set user id on execution */
    kISGID  =   02000 << 16,       /* Unix set group id on execution */
    kISVTX  =   01000 << 16,       /* Unix directory permissions control */
    kIRWXU  =   00700 << 16,       /* Unix read, write, execute: owner */
    kIRUSR  =   00400 << 16,       /* Unix read permission: owner */
    kIWUSR  =   00200 << 16,       /* Unix write permission: owner */
    kIXUSR  =   00100 << 16,       /* Unix execute permission: owner */
    kIRWXG  =   00070 << 16,       /* Unix read, write, execute: group */
    kIRGRP  =   00040 << 16,       /* Unix read permission: group */
    kIWGRP  =   00020 << 16,       /* Unix write permission: group */
    kIXGRP  =   00010 << 16,       /* Unix execute permission: group */
    kIRWXO  =   00007 << 16,       /* Unix read, write, execute: other */
    kIROTH  =   00004 << 16,       /* Unix read permission: other */
    kIWOTH  =   00002 << 16,       /* Unix write permission: other */
    kIXOTH  =   00001 << 16        /* Unix execute permission: other */
} FILEATTRIBUTE <read=read_FILEATTRIBUTE>;

string read_FILEATTRIBUTE (local FILEATTRIBUTE &af) {
	local string s = "";
	local int commaNeeded = 0;
	local FILEATTRIBUTE i = 1;

	SPrintf (s, "0x%X: ", af);
	while (i < 	0xFFFFFF - 2)
	{
		if (af & i)
		{
			if (commaNeeded)
			{
                s += ", ";
            }
			s +=  EnumToString(i);
			commaNeeded = 1;
		}
		i = i << 1;
	}
	return s;
}

// Defintes the Data descriptor
typedef struct {
	SignatureTYPE ddSignature = { S_ZIPDATADESCR };
	uint ddCRC <format=hex>;
	uint ddCompressedSize;
	uint ddUncompressedSize;
} ZIPDATADESCR;

// Defines a file record
typedef struct {
	// Header for the file
	local int64 recPos = FTell();     // captured so the matching ZIPDIRENTRY can set deHeaderOffset
	SignatureTYPE frSignature = { S_ZIPFILERECORD };
	VERECORD frVersion;
	// frFlags is pinned to 0: kept away from Encrypted/StrongEncrypted/
	// DescriptorUsedMask so generation always takes the simple "plain
	// compressed data follows" branch below (those other branches have
	// their own multi-field sub-shapes the JSON doesn't constrain), and
	// away from FLAG_Utf8 since frFileName's bytes are arbitrary fuzzed
	// data, not necessarily valid UTF-8, and strict readers reject a
	// UTF-8-flagged name that isn't.
	FLAGTYPE frFlags = { 0 };
	// Pinned to STORED: frData below is written verbatim (no real deflate/
	// bzip2/etc. codec is implemented here), so declaring any other
	// COMPTYPE would make frUncompressedSize/frCrc -- which real archive
	// readers verify by actually decompressing -- meaningless. STORED is
	// the one COMPTYPE where "compressed" and "uncompressed" bytes are
	// defined to be identical, which is exactly what this template writes.
	COMPTYPE frCompression = { COMP_STORED };
	ushort  frFileTime;
	ushort  frFileDate;
	local int64 crcPos = FTell();
	uint     frCrc     <format=hex>;   // calculated_value: patched below from the actual compressed data
	uint     frCompressedSize <min=0, max=1024>;   // calculated_value in spirit: chosen up front, used directly below
	uint     frUncompressedSize = { frCompressedSize };   // STORED: uncompressed size == compressed size
	// min=1 (rather than 0): some real-world unzip implementations emit a
	// spurious "mismatching local/central filename" warning for a
	// genuinely empty entry name, even when the two copies agree exactly.
	ushort   frFileNameLength <min=1, max=32>;   // calculated_value in spirit: used directly as frFileName's bound
	ushort   frExtraFieldLength = { 0 };   // calculated_value: pinned to an empty (trivially self-consistent) extra-field list
	if( frFileNameLength > 0 )
	char     frFileName[ frFileNameLength ];

	// Compressed data: always the simple, non-encrypted, non-streaming case
	// (see frFlags above).
	SetBackColor( cNone );
	local int64 dataStart = FTell();
	uchar    frData[ frCompressedSize ];

	// frCrc is a calculated_value: patch it now that frData is known.
	local int64 recEnd = FTell();
	local uint32 crcVal = Checksum(CHECKSUM_CRC32, dataStart, frCompressedSize);
	local int evil = SetEvilBit(false);
	FSeek(crcPos);
	uint frCrc = { crcVal };
	SetEvilBit(evil);
	FSeek(recEnd);
} ZIPFILERECORD <read=ReadZIPFILERECORD>;

// Defines an entry in the directory table
typedef struct (int fileIdx) {
	SignatureTYPE deSignature = { S_ZIPDIRENTRY };
	VERECORD deVersionMadeBy;
	VERECORD deVersionToExtract;
	FLAGTYPE deFlags = { 0 };   // see frFlags above
	COMPTYPE deCompression = { record[fileIdx].frCompression };
	ushort  deFileTime;
	ushort  deFileDate;
	// deCrc/deCompressedSize/deUncompressedSize/deHeaderOffset are copied
	// straight from the matching ZIPFILERECORD instance so the central
	// directory and local header always agree, as real archive readers
	// require.
	uint     deCrc     = { record[fileIdx].frCrc } <format=hex>;
	uint     deCompressedSize = { record[fileIdx].frCompressedSize };
	uint     deUncompressedSize = { record[fileIdx].frUncompressedSize };
	// deFileNameLength/deFileName are copied byte-for-byte from the
	// matching ZIPFILERECORD's frFileNameLength/frFileName: real archive
	// readers (e.g. Python's zipfile) require the local header's and
	// central directory's filenames to match exactly.
	ushort   deFileNameLength = { record[fileIdx].frFileNameLength };
	ushort   deExtraFieldLength = { 0 };   // see frExtraFieldLength above
	ushort   deFileCommentLength <min=0, max=16>;
	ushort   deDiskNumberStart = { 0 };
	ushort   deInternalAttributes;
	FILEATTRIBUTE deExternalAttributes;
	uint     deHeaderOffset = { (uint)record[fileIdx].recPos };
	if( deFileNameLength > 0 )
		char     deFileName[ deFileNameLength ] = { record[fileIdx].frFileName };
	if( deFileCommentLength > 0 )
		uchar    deFileComment[ deFileCommentLength ];
} ZIPDIRENTRY <read=ReadZIPDIRENTRY>;

// Defines the digital signature
typedef struct {
	SignatureTYPE dsSignature = { S_ZIPDIGITALSIG };
	ushort   dsDataLength <min=0, max=32>;
	if( dsDataLength > 0 )
		uchar 	dsData[ dsDataLength ];
} ZIPDIGITALSIG;

// Zip64 end of central directory record
typedef struct {
	SignatureTYPE elr64Signature = { S_ZIP64ENDLOCATORRECORD };
	// calculated_value: pinned to 44 (the fully-populated fixed-field
	// record) instead of driving the original's increasing-threshold
	// conditional chain, so every field below is always present.
	int64       elr64DirectoryRecordSize = { 44 };
	VERECORD    elr64VersionMadeBy;
	VERECORD    elr64VersionToExtract;
	uint        el64DiskNumber = { 0 };
	uint        el64StartDiskNumber = { 0 };
	int64       el64EntriesOnDisk;
	int64       el64EntriesInDirectory;
	int64       el64DirectorySize;
	int64       el64DirectoryOffset;
} ZIP64ENDLOCATORRECORD;

//Zip64 end of central directory locator
typedef struct {
	SignatureTYPE elSignature = { S_ZIP64ENDLOCATOR };
	uint     elStartDiskNumber = { 0 };
	int64    elDirectoryOffset;
	uint     elEntriesInDirectory;
}  ZIP64ENDLOCATOR;

// Defines the end of central directory locator
typedef struct (int64 cdOffset, int64 cdSize, uint numEntries) {
	SignatureTYPE elSignature = { S_ZIPENDLOCATOR };
	ushort   elDiskNumber = { 0 };
	ushort   elStartDiskNumber = { 0 };
	// calculated_value: both entry counts are simply MAX_FILES, the fixed
	// number of ZIPDIRENTRYs actually written below.
	ushort   elEntriesOnDisk = { (ushort)numEntries };
	ushort   elEntriesInDirectory = { (ushort)numEntries };
	// calculated_value: derived from the actual central-directory span
	// captured while it was being written (no patch-back needed, since
	// this record comes after the central directory).
	uint     elDirectorySize = { (uint)cdSize };
	uint     elDirectoryOffset = { (uint)cdOffset };
	ushort   elCommentLength <min=0, max=32>;   // calculated_value in spirit: used directly as elComment's bound
	if( elCommentLength > 0 )
		char elComment[ elCommentLength ];
} ZIPENDLOCATOR;

//--------------------------------------------

// Custom read functions that allows the name of the
//  of the file to appear in the Template Results.

string ReadZIPFILERECORD( ZIPFILERECORD &file )
{
	if( exists( file.frFileName ) )
		return file.frFileName;
	else
		return "";
}

string ReadZIPDIRENTRY( ZIPDIRENTRY &entry )
{
	if( exists( entry.deFileName ) )
		return entry.deFileName;
	else
		return "";
}

//--------------------------------------------

// Define the file
LittleEndian();
local int evil0 = SetEvilBit(false);

// Declarative, fixed-count local-file-record section, replacing the
// original's single unordered `while(!FEof())` dispatch loop for this
// part of the archive: every ZIPFILERECORD is immediately followed by its
// matching ZIPDIRENTRY generation later, so there is no risk of a
// central-directory entry that doesn't agree with its local header.
local int MAX_FILES = 2;
local int i;
for (i = 0; i < MAX_FILES; i++)
{
	SetBackColor( cLtGray );
	ZIPFILERECORD record;
}

// Central directory: one ZIPDIRENTRY per ZIPFILERECORD above.
local int64 cdStartPos = FTell();
for (i = 0; i < MAX_FILES; i++)
{
	SetBackColor( cLtPurple );
	ZIPDIRENTRY dirEntry(i);
}
local int64 cdEndPos = FTell();
local int64 cdSizeVal = cdEndPos - cdStartPos;

// The optional trailer records (digital signature, ZIP64 EOCD record +
// locator) are deliberately never generated here: real-world readers (e.g.
// Python's zipfile) compute the central directory's start position as
// "EOCD file offset - size_cd - offset_cd" and treat any nonzero result as
// leftover bytes from a self-extracting-archive stub prepended to the
// whole file, not as legitimate trailer records between the central
// directory and the EOCD -- so any bytes generated here would silently
// break every archive. ZIPDIGITALSIG/ZIP64ENDLOCATORRECORD/ZIP64ENDLOCATOR
// keep their struct definitions above (and still parse correctly) for
// real-world files that do use them; this template's generator always
// emits ZIPENDLOCATOR immediately after the central directory instead.
SetBackColor( cLtYellow );
ZIPENDLOCATOR endLocator(cdStartPos, cdSizeVal, MAX_FILES);
SetEvilBit(evil0);
