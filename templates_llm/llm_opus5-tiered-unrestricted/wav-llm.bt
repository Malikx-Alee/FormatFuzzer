    case 10: SPrintf( s, "Delta Labs"); break;
    case 11: SPrintf( s, "Sound Comp."); break;
    case 12: SPrintf( s, "General Electro"); break;
    case 13: SPrintf( s, "Techmar"); break;
    case 14: SPrintf( s, "Matthews Research"); break;
    case 16: SPrintf( s, "Oberheim"); break;
    case 17: SPrintf( s, "PAIA"); break;
    case 18: SPrintf( s, "Simmons"); break;
    case 19: SPrintf( s, "DigiDesign"); break;
    case 20: SPrintf( s, "Fairlight"); break;
    case 21: SPrintf( s, "JL Cooper"); break;
    case 22: SPrintf( s, "Lowery"); break;
    case 23: SPrintf( s, "Lin"); break;
    case 24: SPrintf( s, "Emu"); break;
    case 27: SPrintf( s, "Peavey"); break;
    case 32: SPrintf( s, "Bon Tempi"); break;
    case 33: SPrintf( s, "S.I.E.L."); break;
    case 35: SPrintf( s, "SyntheAxe"); break;
    case 36: SPrintf( s, "Hohner"); break;
    case 37: SPrintf( s, "Crumar"); break;
    case 38: SPrintf( s, "Solton"); break;
    case 39: SPrintf( s, "Jellinghaus Ms"); break;
    case 40: SPrintf( s, "CTS"); break;
    case 41: SPrintf( s, "PPG"); break;
    case 47: SPrintf( s, "Elka"); break;
    case 54: SPrintf( s, "Cheetah"); break;
    case 62: SPrintf( s, "Waldorf"); break;
    case 64: SPrintf( s, "Kawai"); break;
    case 65: SPrintf( s, "Roland"); break;
    case 66: SPrintf( s, "Korg"); break;
    case 67: SPrintf( s, "Yamaha"); break;
    case 68: SPrintf( s, "Casio"); break;
    case 70: SPrintf( s, "Kamiya Studio"); break;
    case 71: SPrintf( s, "Akai"); break;
    case 72: SPrintf( s, "Victor"); break;
    case 75: SPrintf( s, "Fujitsu"); break;
    case 76: SPrintf( s, "Sony"); break;
    case 78: SPrintf( s, "Teac"); break;
    case 80: SPrintf( s, "Matsushita"); break;
    case 81: SPrintf( s, "Fostex"); break;
    case 82: SPrintf( s, "Zoom"); break;
    case 84: SPrintf( s, "Matsushita"); break;
    case 85: SPrintf( s, "Suzuki"); break;
    case 86: SPrintf( s, "Fuji Sound"); break;
    case 87: SPrintf( s, "Acoustic Technical Laboratory"); break;
    default: SPrintf( s, "Unknown"); break;
    }

SPrintf( sret, "Manufacturer: %s", s);

return sret;
}

//----------------------------------------------------------------------
typedef long SMPLLOOPS_Type <read=WAV_SMPL_Loop_Type>;

string
WAV_SMPL_Loop_Type( SMPLLOOPS_Type loop )
{
    string  s;

    switch( loop )
    {
        case 0 :
            SPrintf( s, "Loop: Forward (%u)", loop );
            break;

        case 1 :
            SPrintf( s, "Loop: Ping Pong (%u)", loop );
            break;

        case 2 :
            SPrintf( s, "Loop: Reverse (%u)", loop );
            break;

        case 3 :
            SPrintf( s, "Loop [reserved for future standard types] (%u)", loop );
            break;

        default:
            s = "Loop: <unknown>";
    }

    return s;
}

//----------------------------------------------------------------------
// SMPL Loop
typedef struct {
    // Tier C, bare: matching an identifier in the cue chunk reaches a reader's
    // cross-chunk resolution and missing one reaches the failure path, so this is
    // deliberately NOT derived from the cue chunk.
    SMPLLOOPS_Cue_ID     Cue_Point;

    // Tier B, exhaustive: the four traversal modes the original's own switch
    // distinguishes, including case 3, which it labels "reserved for future
    // standard types" and which is not dropped.  Values above 3 reach the
    // default arm printing "Loop: <unknown>", so they are generated too.
    local int32 lt_vals[0];
    lt_vals += 0; lt_vals += 0;
    lt_vals += 1; lt_vals += 1;
    lt_vals += 2; lt_vals += 2;
    lt_vals += 3; lt_vals += 3;
    lt_vals += 4; lt_vals += 255;
    local int evil_lt = SetEvilBit(IsParsing());
    SMPLLOOPS_Type       Type <values=lt_vals>;
    SetEvilBit(evil_lt);

    // Tier C, bare, all four: a start past the end, a start beyond the end and a
    // play count of zero -- the infinite-sustain case the original's display
    // function branches on -- are all accepted by every parser and all drive the
    // loop-validation branches.
    SMPLLOOPS_Start      Start;
    SMPLLOOPS_End        End;
    SMPLLOOPS_Fraction   Fraction;
    SMPLLOOPS_Play_Count Play_Count;

} SMPLLOOPS;

//----------------------------------------------------------------------
// Chunk SMPL
typedef struct {
    // Tier A fixed_value: the tag the switch at line 556 matches.
    local int evil_mid = SetEvilBit(IsParsing());
    char                     chunkID[4] = { "smpl" };
    SetEvilBit(evil_mid);

    // Tier A calculated_value: 36 + 24 * Num_Sample_Loops + Sampler_Data.  How
    // many loops to write is free (diversity_axes[9]) -- zero, one and several
    // take three different paths through a reader's loop list -- so the loop count
    // is what the value set varies.
    local int64 m_room = (int64)XTRA_BUDGET - (int64)used_xtra;
    local int32 ms_vals[0];
    ms_vals += 36; ms_vals += 36;                   // no loops at all
    if (m_room >= 68)  { ms_vals += 60; ms_vals += 60; }
    if (m_room >= 92)  { ms_vals += 84; }
    if (m_room >= 140) { ms_vals += 132; }
    if (m_room >= 240) { ms_vals += 228; }
    if (m_room >= 450) { ms_vals += 420; }
    local int evil_mcs = SetEvilBit(IsParsing());
    long                     chunkSize <values=ms_vals>;
    SetEvilBit(evil_mcs);

    local int64 m_sz = chunkSize;
    local int64 m_n  = (m_sz - 36) / 24;
    if (m_n < 0)
        m_n = 0;

    // Tier B: the fifty-five literals the original's switch compares against,
    // weighted by preferred_value [0,1,4,65,66,67,71].  completeness is "partial"
    // -- every other value is legal, reaches the switch's default arm at line 438
    // and is generated too.
    local int32 mf_vals[0];
    mf_vals += 0; mf_vals += 0; mf_vals += 0; mf_vals += 0;
    mf_vals += 1; mf_vals += 1; mf_vals += 4; mf_vals += 4;
    mf_vals += 65; mf_vals += 65; mf_vals += 66; mf_vals += 66;
    mf_vals += 67; mf_vals += 67; mf_vals += 71; mf_vals += 71;
    mf_vals += 2;  mf_vals += 3;  mf_vals += 5;  mf_vals += 6;
    mf_vals += 7;  mf_vals += 8;  mf_vals += 9;  mf_vals += 10;
    mf_vals += 11; mf_vals += 12; mf_vals += 13; mf_vals += 14;
    mf_vals += 16; mf_vals += 17; mf_vals += 18; mf_vals += 19;
    mf_vals += 20; mf_vals += 21; mf_vals += 22; mf_vals += 23;
    mf_vals += 24; mf_vals += 27; mf_vals += 32; mf_vals += 33;
    mf_vals += 35; mf_vals += 36; mf_vals += 37; mf_vals += 38;
    mf_vals += 39; mf_vals += 40; mf_vals += 41; mf_vals += 47;
    mf_vals += 54; mf_vals += 62; mf_vals += 64; mf_vals += 68;
    mf_vals += 70; mf_vals += 72; mf_vals += 75; mf_vals += 76;
    mf_vals += 78; mf_vals += 80; mf_vals += 81; mf_vals += 82;
    mf_vals += 84; mf_vals += 85; mf_vals += 86; mf_vals += 87;
    // the missing cases, which fall through to the default arm
    mf_vals += 15; mf_vals += 25; mf_vals += 26; mf_vals += 28;
    mf_vals += 34; mf_vals += 999; mf_vals += 65536;
    local int evil_mmf = SetEvilBit(IsParsing());
    SMPL_Manufacturer        Manufacturer <values=mf_vals>;
    SetEvilBit(evil_mmf);

    // Tier C, bare.
    SMPL_Product             Product; // Product code (Manufacture)

    // Tier C, bare: the original's comment at line 342 states the convention that
    // this is 1000000000 / dwSamplesPerSec, and dependency 25 records it as
    // advisory rather than a pin -- a mismatch parses and plays, and zero is the
    // value that makes a reader's rate arithmetic divide by zero.
    SMPL_Sample_Period       Sample_Period;

    // Tier C, bare: the 0..127 MIDI range is deliberately NOT a bound, since
    // values above it are the only way to reach a sampler's note clamping.
    SMPL_MIDI_Unity_Note     MIDI_Unity_Note;
    SMPL_MIDI_Pitch_Fraction MIDI_Pitch_Fraction;

    // Tier B, exhaustive: the five defined frame rates, all five preferred.  29 is
    // the drop-frame case whose time arithmetic differs from every other value,
    // and undefined values reach the default arm at line 364.
    local int32 sm_vals[0];
    sm_vals += 0;  sm_vals += 0;  sm_vals += 24; sm_vals += 24;
    sm_vals += 25; sm_vals += 25; sm_vals += 29; sm_vals += 29;
    sm_vals += 30; sm_vals += 30;
    sm_vals += 23; sm_vals += 60;
    local int evil_smp = SetEvilBit(IsParsing());
    SMPL_SMPTE               SMPTE <values=sm_vals>;
    SetEvilBit(evil_smp);

    // Tier C, bare: out-of-range components -- sixty-one seconds, thirty-five
    // frames at 24 fps -- are the only way to reach timecode validation.
    SMPL_SMPTE_Offset        SMPTE_Offset;

    // Tier A calculated_value: the array bound for loops[] below.
    local int evil_mnl = SetEvilBit(IsParsing());
    SMPL_SL                  Num_Sample_Loops = { (int32)m_n };
    SetEvilBit(evil_mnl);

    // Tier A calculated_value with a template_parse_requirement: the original
    // declares no array for the vendor data and goes from loops[] straight to the
    // pad byte, so a non-zero value here would leave that many bytes unconsumed
    // and desynchronise this parser even though it is legal WAV.
    local int evil_msd = SetEvilBit(IsParsing());
    SMPL_SD                  Sampler_Data = { 0 };
    SetEvilBit(evil_msd);

    SMPLLOOPS                loops[Num_Sample_Loops];

    have_smpl = 1;
    used_xtra += (uint32)(m_sz + 8);

     // Padding so the next chunk starts on an even byte
     // Tier C: the VALUE is free, the PRESENCE is structural.  FileSize() is only
     // consulted in the parse direction -- see skip_last_pad at the top of the file.
     local int m_pad_ok = 0;
     if( chunkSize & 1 )
     {
         if (IsParsing() == 0)
         {
             m_pad_ok = 1;
         }
         else if( FTell() < FileSize() )
         {
             m_pad_ok = 1;
         }
     }
     if( m_pad_ok )
         uchar padding;

} SMPLCHUNK;



//---------------------------------------------

// Define the headers
LittleEndian(); 
SetBackColor( cLtPurple );
WAVRIFFHEADER header;

// Check for valid header
if( header.groupID != "RIFF" || header.riffType != "WAVE" )
{
    Warning( "File is not a valid wave file. Template stopped." );
    return -1;
}

// Read the file as a set of chunks
local char tag[4];
local uint size;

// structure[0] first_element / structure[12] forbidden: nothing may precede the
// twelve-byte head, which is why it is declared outside the loop.
// structure[1] required + structure[2] ordering: exactly one format chunk, and it
// must come before the data chunk.  Every real writer puts it first, so the
// preferred set below starts as "fmt " alone and only grows afterwards.
local string pref_tag[0];
local string poss_tag[0];
local int64  t_left = 0;
local double eof_p  = 0.10;

// The continuation test is taken at the END of each pass, and in a different
// order per direction.  Generating, FEof() must not be consulted while the file
// still owes its data chunk, because FEof() latches the file size the moment it
// fires and nothing more could then be written.  Parsing, end of file has to end
// the loop whatever the file contains, or a WAVE form with no data chunk -- which
// structure[3] calls a legal case worth generating -- would read past the end.
local int keep_going = 1;

while( top_n < 64 && force_end == 0 && keep_going )
{
    // ---- walk the legal state machine (structure[2] ordering) --------------
    // pref_tag is what the format's state machine wants next and poss_tag is
    // everything that is legal here; ReadBytes draws from pref_tag with
    // probability p and from poss_tag otherwise, so p is the steering strength.
    // poss_tag has to contain EVERY tag this iteration may produce, because the
    // lookahead writes the four bytes the chunk's own pinned chunkID then has to
    // agree with -- a tag the chunk's own value set does not contain would leave
    // the generator no compatible value and it would fall back to random bytes.
    t_left = (int64)FILE_BUDGET - FTell();
    pref_tag = empty_str;
    eof_p = 0.10;
    // The unmodelled tags go in FIRST, as a whole-array assignment, because the
    // set has to be seeded before the state-dependent tags are appended one by
    // one.  They are scattered before and after the data chunk rather than
    // clustered, since a reader's post-audio chunk handling differs from its
    // pre-audio handling.
    if (have_fmt >= 1 && t_left >= 64 && used_unk + 16 < UNK_BUDGET)
    {
        poss_tag = unk_tags;
    }
    else
    {
        poss_tag = empty_str;
    }
    if (have_fmt == 0)
    {
        // nothing but the format chunk is useful yet: without it the original's
        // data chunk aborts at line 73 and every reader reports a file with no
        // format description.
        pref_tag += "fmt ";
        poss_tag += "fmt ";
    }
    else if (t_left < 64)
    {
        // the budget is spent; stop opening chunks
        pref_tag += "data";
        poss_tag += "data";
    }
    else
    {
        // structure[3] required "data", structure[8]/[10] cardinality for the
        // metadata and unmodelled chunks, structure[7] ordering for "fact".
        if (have_data == 0 && allow_nodata == 0)
        {
            // Real writers put the audio immediately after the format chunk, and
            // the fact chunk between them when the tag needs one; the metadata
            // chunks go afterwards.  Keeping the data chunk early is also what
            // leaves it the whole audio budget, so the audio-length ladder stays
            // broad rather than collapsing onto its smallest rungs.  WavPack's
            // riff.c loop BREAKS at the data chunk, so the chunks that reach its
            // parser at all are exactly the ones placed here.
            poss_tag = empty_str;
            pref_tag += "data"; pref_tag += "data"; pref_tag += "data";
            poss_tag += "data"; poss_tag += "data";
            poss_tag += "data"; poss_tag += "data";
            if (have_fact == 0 && used_xtra + 12 < XTRA_BUDGET)
            {
                // dependency 14 and structure[7]: the spec requires a fact chunk
                // for every format other than PCM, conventionally before the
                // audio; most readers tolerate its absence, which is itself a
                // distinct path, so it is possible rather than certain.
                if (fmt_tag != 1)
                {
                    pref_tag += "fact";
                }
                poss_tag += "fact";
            }
            if (have_fmt == 1 && top_n < 4)
            {
                // structure[1] says exactly one format chunk is valid; a SECOND
                // one before the data chunk is still legal to write and is the
                // only way to reach WavPack's `if (format_chunk++)` rejection at
                // cli/riff.c:142-145.  It publishes nothing, so the data chunk
                // still sizes itself from the first one.
                poss_tag += "fmt ";
            }
            if (used_unk + 16 < UNK_BUDGET)
            {
                // The unmodelled chunks that have to precede the audio to be seen
                // by riff.c at all: ds64 reaches its dedicated arm, the rest its
                // copy-and-continue branch.
                poss_tag += "ds64"; poss_tag += "ds64";
                poss_tag += "bext"; poss_tag += "inst"; poss_tag += "JUNK";
                poss_tag += "cset"; poss_tag += "id3 "; poss_tag += "iXML";
                poss_tag += "PAD "; poss_tag += "xxxx";
            }
        }
        else if (have_data > 0)
        {
            // a second data chunk is tolerated by readers and keeps either the
            // first or the last, which is a branch worth reaching occasionally
            poss_tag += "data";
        }
        if (have_fact == 0 && have_data > 0 && used_xtra + 12 < XTRA_BUDGET)
        {
            // the fact chunk also placed AFTER the audio, which the JSON notes is
            // still parsed but too late to help -- a separate path
            poss_tag += "fact";
        }
        if (have_cue == 0 && used_xtra + 40 < XTRA_BUDGET)
        {
            // Weighted up: the cue and sampler chunks are the only carriers of
            // CUEPOINT.fccChunk, SMPLLOOPS.Type, SMPLCHUNK.SMPTE and the
            // fifty-five-value Manufacturer set, and a Tier B set is only emitted
            // completely if its chunk appears often enough to draw from it.
            poss_tag += "cue "; poss_tag += "cue "; poss_tag += "cue ";
        }
        if (have_smpl == 0 && used_xtra + 48 < XTRA_BUDGET)
        {
            poss_tag += "smpl"; poss_tag += "smpl"; poss_tag += "smpl";
            poss_tag += "smpl"; poss_tag += "smpl"; poss_tag += "smpl";
        }
        if (used_list + 32 < LIST_BUDGET)
        {
            // Likewise for the twenty-six registered INFO tags and the four adtl
            // records, which only exist inside a LIST.
            poss_tag += "LIST"; poss_tag += "LIST"; poss_tag += "LIST";
            poss_tag += "LIST"; poss_tag += "LIST"; poss_tag += "LIST";
        }
        if (have_data == 1 && used_xtra + 48 >= XTRA_BUDGET && used_list + 32 >= LIST_BUDGET && used_unk + 16 >= UNK_BUDGET)
        {
            // every optional budget is spent; let the file end
            eof_p = 0.90;
            pref_tag += "data";
            poss_tag += "data";
        }
    }

    // Read the chunk tag 
    // p = 0.72: roughly seven draws in ten follow the state machine and the rest
    // come from everything else that is legal at this point.
    ReadBytes( tag, FTell(), 4, pref_tag, poss_tag, 0.72 );

    // See which chunk this is
    switch( tag )
    {
        case "fmt ":
            SetBackColor( cLtGray );
            FORMATCHUNK format;
            break;
        case "data":
            SetBackColor( cNone );
            DATACHUNK   data;
            break;
        case "fact":
            SetBackColor( cLtBlue );
            FACTCHUNK   fact;
            have_fact = 1;
            used_xtra += 12;
            break;
        case "cue ":
            SetBackColor( cLtGray );
            CUECHUNK    cue;
            have_cue = 1;
            break;
        case "smpl":
            SetBackColor( cLtGray );
            SMPLCHUNK    smpl;
            break;
        case "LIST":
            SetBackColor( cLtYellow );
            LISTCHUNK   list;
            break;
        default:
            // Unknown chunk
            // The original reads the size here purely to print a diagnostic.  In
            // the GENERATE direction that lookahead would write four random bytes
            // at the very offset UNKNOWNCHUNK.chunkSize occupies and leave its own
            // value set nothing compatible to pick, so the diagnostic is kept for
            // the direction it is meaningful in.
            if( IsParsing() )
            {
                size = ReadUInt( FTell()+4 );
                Printf( "Encountered unknown chunk '%s' of size %d at position %Ld.\n",
                    tag, size, FTell() );
            }
            SetBackColor( cNone );
            UNKNOWNCHUNK unknown;
            break;
    }

    used_total = (uint32)FTell();
    top_n++;

    keep_going = 0;
    if (IsParsing() == 0 && have_data == 0 && allow_nodata == 0)
    {
        keep_going = 1;
    }
    else if (!FEof( eof_p ))
    {
        keep_going = 1;
    }
}

// ---- Tier A calculated_value: hsize == FileSize() - 8 ----------------------
// structure[13] last_element: WAV has no trailer, so this field carries the whole
// burden of delimiting the container, and it can only be written once the chunk
// sequence has ended.  The guard is `field != computed`, which is false for a
// well-formed real file, so the parse direction never rewrites anything.
local int64 wav_end = FTell();
local int64 want_hsize = wav_end - 8;
local int64 hsize_now = header.hsize;
if (IsParsing() == 0 && hsize_now != want_hsize && want_hsize >= 4)
{
    FSeek(4);
    local int evil_hs2 = SetEvilBit(IsParsing());
    long hsize = { (int32)want_hsize };
    SetEvilBit(evil_hs2);
    FSeek(wav_end);
}
