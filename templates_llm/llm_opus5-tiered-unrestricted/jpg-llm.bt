//------------------------------------------------
//--- 010 Editor v2.0 Binary Template
//
//      File: JPG.bt
//   Authors: Ibrahim Onaran
//    E-mail: onaran AT gmail DOT com
//   Version: 1.6.4
//   Purpose: Template for JPG image files. 
//  Category: Image
// File Mask: *.jpg,*.jpeg
//  ID Bytes: FF D8 FF
//   History: 
//   1.6.4 2018-12-20 Denis Anisimov: COMPSOS bug fixed.
//   1.6.3 2018-01-04 I Onaran: Changed author information.
//   1.6.2 2016-11-29 Bartosz Dziewonski: Search for end of file marker forwards rather than backwards.
//                    Data after the marker may contain bytes that look just like the marker itself.
//                    Also, use FindFirst() for better performance.
//   1.6.1 2016-10-18 Bartosz Dziewonski: Don't fail when garbage bytes are present
//                    between JPEG sections.
//   1.6   2016-10-18 SweetScape: Handle when end of file marker is not found.
//   1.5   2016-01-28 Pergamon: Added Sof3 support and set padded bytes color to silver.
//   1.4.1 2016-06-14 Bartosz Dziewonski: Don't fail when parsing IFD where the offset of data for
//                    final entry is before the structure offset.
//   1.4   2016-01-28 SweetScape: Updated header for repository submission, added open attribute.
//   1.3   2014-11-03 SweetScape: Fixed using FTell instead of Ftell. 
//   1.2   2012-10-04 dxp: Added JPEG-LS marker structure.
//   1.1   2009-03-14 Kuang-che Wu: Fix parse fail if encounter unknown APP1,
//                    fix uShort typo,
//                    parse inlined EXIF data correctly,
//                    recognize more sections and fields, especially EXIF tags, GPS tags, and CIFF tags
//                    and many improvements.
//   1.0   Mor FTP:   Initial release.
//
// This is a detailed JPEG File analysis.
// Features
//  1. Huffmann and quantization tables.
//  2. Exif (APP1) information including jpeg and other thubnail images
//  3. SOS, SOF0, JIFF and APP0 sections
//
// Note : This code doesn't parse all known sections. The reson is the application sections
//  contain camera specific information and this information sometimes is not public or
//  related to the camera and not important for image display softwares.
//
// New Features: Parses MakerNote for casio qv-r62
//
// references:
// JPEG		http://www.w3.org/Graphics/JPEG/itu-t81.pdf
// JFIF		http://www.w3.org/Graphics/JPEG/jfif3.pdf
// EXIF		http://www.exif.org/Exif2-2.PDF
// CIFF		http://xyrion.org/ciff/CIFFspecV1R04.pdf
// exiftool	http://www.sno.phy.queensu.ca/~phil/exiftool/
// JPEG-LS	http://www.itu.int/rec/T-REC-T.87-199806-I/en
//--------------------------------------

//=== REWRITE NOTE ============================================================
// Generative rewrite of templates_originals/jpg-orig.bt, driven by
// llm_learned_specification/opus5-tiered/llm_reterived_constraints_jpg-llm_opus5-tiered.json.
// Every original typedef, field name, field order, enum and comment is kept;
// the additions are marked ADDED and each names the decoder branch it reaches.
// The measured decoder is libjpeg-turbo 3.2.0 driven as `djpeg <file>`, which
// is the same decoder every measured_gate in the JSON was established against.
//
// TIER DISCIPLINE
//   Tier A  pinned inside SetEvilBit(IsParsing()).  The guard must be
//     IsParsing() and not false: while GENERATING the two are identical, so no
//     Tier A field ever takes the 1/128 out-of-set value; while PARSING it is
//     the only escape that lets a computed field accept a real file's own
//     number.  With a literal false this template parses none of the files in
//     testcases/jpg.
//   Tier B  the complete valid_values set, weighted by preferred_value, and
//     NOT guarded, so the evil bit still reaches each decoder rejection path
//     ("Bogus DHT index", "Unsupported JPEG data precision", ...).
//   Tier C  bare.  No value set, no <min=>, no <max=>.
//
// PLAN-THEN-EMIT
//   JPEG is written strictly in order and every szSection covers only the body
//   that follows it, so nothing needs backpatching.  What DOES need deciding up
//   front is the frame/scan plan, because the scan's byte count is a function
//   of the frame geometry, the sampling factors, the scan's component count,
//   the restart interval and the Huffman tables - all of which are emitted in
//   earlier segments.  jpg_plan() below makes every one of those choices once,
//   then each segment emits its part of it, and the entropy-coded segment is
//   built from the result.  Nothing is narrowed to suit a precomputed payload:
//   the payload is rebuilt for whatever geometry was drawn.
//
// OUTPUT BUDGET - the only size-control mechanism
//   JpegFileEnd = FileSize() is the original's own line.  In the parse
//   direction it is the real file size; in the generate direction FormatFuzzer
//   draws it uniformly from [current, MAX_FILE_SIZE] and then forbids writing
//   past it, which makes it exactly the running budget the JSON's output_budget
//   rules ask for (96 KB of marker segments, scaled to the 64 KB the runtime
//   allows).  Segments are added while the budget lasts; the entropy-coded
//   segment is truncated at a byte boundary if what remains cannot hold it,
//   which libjpeg reports as "premature end of data segment" and still decodes.
//   No dimension, component count, sampling factor, table size or restart
//   interval is ever capped to control size.
//=============================================================================

// Tier C fields and the per-call-site lookahead sets below must not be pulled
// onto values ffcompile mined from the template's own literals.
const local byte   ReadByteInitValues[0];
const local ubyte  ReadUByteInitValues[0];
const local ushort ReadUShortInitValues[0];
const local uint   ReadUIntInitValues[0];
const local string ReadBytesInitValues[0];

// set left to right for both endian
LittleEndian(); BitfieldLeftToRight();
BigEndian(); BitfieldLeftToRight();

local quad JpegFileEnd = 0;
local int colorId = 0;
local int colorSelect = 0;
local DWORD clr = 0;
local DWORD jetMap[6*3] = { // blue, red green
	0x0000cc,0x0000ff,0x0033ff,0x0066ff,0x0099ff,0x00ccff,
	0x00ffff,0x33ffcc,0x66ff99,0x99ff66,0xccff33,0xffff00,
	0xffcc00,0xff9900,0xff6600,0xff3300,0xff0000,0xcc0000
};
local char CameraMake[32];
local char CameraModel[40];

local string stack_IFD_dirtype = "";

enum IFD_dirtype {
	IFD_TYPE_EXIF = 1,
	IFD_TYPE_GEOTAG,
	IFD_TYPE_CASIO_QV_R62,
};

// ------------------------------------------------------------
// helper functions
void Stack_push(string &s, int x)
{
	s += (char)x;
}

void Stack_pop(string &s)
{
	s = SubStr(s, 0, Strlen(s) - 1);
}

int Stack_top(string &s)
{
	return s[Strlen(s) - 1];
}

string ReadStringN(int64 pos, int n)
{
	local uchar s[n];
	ReadBytes(s, pos, n);
	return s;
}

// ------------------------------------------------------------

void ChangeColor(byte bChangeColor) {
	if(bChangeColor == 1) {colorSelect++; colorId = 0;}
	clr = jetMap[(colorSelect%3)*6+(colorId%6)];
	SetBackColor(clr);
	//Printf("clrIdx = [%d %d], RGB(%d,%d,%d)\n",colorSelect,colorId,(clr>>16),(clr>>8)&0x00FF,clr&0x0000FF);
	colorId++;
}

// ------------------------------------------------------------
// JPEG
typedef enum <WORD> tagID
{
	M_SOF0  = 0xFFC0, // Start Of Frame N
	M_SOF1,// N indicates which compression process
	M_SOF2,// Only SOF0-SOF2 are now in common use
	M_SOF3,
	M_DHT, //Huffman Table
	M_SOF5,
	M_SOF6,
	M_SOF7,
	M_JPG,
	M_SOF9,
	M_SOF10,
	M_SOF11,
	M_DAC = 0xffcc,
	M_SOF13,
	M_SOF14,
	M_SOF15,
	M_RST0 = 0xffd0,
	M_RST1, M_RST2, M_RST3, M_RST4, M_RST5, M_RST6, M_RST7,
	M_SOI = 0xFFD8, // Start Of Image
	M_EOI,// End Of Image
	M_SOS,// Start Of Scan (begins compressed data)
	M_DQT,
	M_DNL,
	M_DRI,
	M_DHP,
	M_EXP,
	M_APP0 = 0xFFE0, // Jfif marker
	M_APP1,// Exif marker
	M_APP2,
	M_APP3,
	M_APP4,
	M_APP5,
	M_APP6,
	M_APP7,
	M_APP8,
	M_APP9,
	M_APP10,
	M_APP11,
	M_APP12,
	M_APP13,
	M_APP14,
	M_APP15,
	M_JPG0 = 0xfff0,
	M_JPG1, M_JPG2, M_JPG3, M_JPG4, M_JPG5, M_JPG6, M_JPGLS,
	M_JPG8, M_JPG9, M_JPG10, M_JPG11, M_JPG12, M_JPG13, M_JPG14, M_JPG15,
	M_COMM = 0xFFFE  // Comment
} M_ID <format=hex>;


