//------------------------------------------------
//--- 010 Editor v1.2 Binary Template
//
//      File: AVI.bt
//   Authors: Blaine Lefebvre [bl], Elias Bachaalany [eb]
//   Version: 1.2
//   Purpose: Parse an AVI movie file.
//  Category: Video
// File Mask: *.avi
//  ID Bytes: 52 49 46 46 [+4] 41 56 49 20 //RIFF????AVI 
//   History: 
//   1.2   2016-01-27 SweetScape: Updated header for repository submission, added coloring for header.
//   1.1   2006-10-02 eb: Added BITMAPINFO and WAVEFORMATEX proper strfHEADER recognition,
//                      Fixed 'idx1' parsing.
//   1.0   bl: Initial release.
//
//   --- Rewritten as a GENERATIVE FormatFuzzer specification -------------------
//   Every struct, field name, field order and dispatch of the 010 original is
//   kept.  What is added is (a) the value sets the tiered constraint set calls
//   for, (b) the chunk-length arithmetic that turns the passive parser into a
//   generator, and (c) one well-formed payload emitter per codec variant, which
//   is where all of a video decoder's coverage lives.
//
//   Tier A fields are pinned inside a SetEvilBit(IsParsing()) guard: identical
//   to SetEvilBit(false) while generating, but it leaves a real file's own value
//   reachable while parsing, which is what keeps the parse direction working.
//   Tier B fields carry their complete valid_values set, with preferred values
//   repeated inside the set because file_string()/file_integer() draw uniformly
//   from the vector - repetition IS the preferred/possible weighting.
//   Tier C fields are declared bare: no value set, no <min=>, no <max=>.
//------------------------------------------------

LittleEndian();

/* ===========================================================================
 * Output budget (structure[].output_budget).
 *
 * The constraint set budgets the movi list to about 4 MB.  FormatFuzzer's
 * engine caps a generated file at MAX_FILE_SIZE = 65536 and the decision
 * stream at MAX_RAND_SIZE = 131072, so 4 MB is unreachable by the engine
 * rather than by choice.  FILE_BUDGET is the engine's ceiling with room for
 * the trailing index; DEC_BUDGET is the decision-stream ceiling, which binds
 * first for the reference-bitstream codecs because those are emitted byte by
 * byte (2 decision bytes each) where pixel data is emitted as a string
 * (1 decision byte each).
 *
 * NOTHING below bounds a dimension, a depth, a codec, a channel count, a
 * sample rate or a frame count directly.  The budget is spent by the movi
 * list's own length, which is the format's own free size axis.
 * =========================================================================== */
const uint32 FILE_BUDGET = 58000;
const uint32 DEC_BUDGET  = 104000;
const uint32 JUNK_BUDGET = 20000;    /* JUNKHEADER.data is the designated filler */
const uint32 HDRL_BUDGET = 12000;    /* one strl list per stream, ~76 bytes each */

/* running totals - see each use site */
local uint32 file_used = 0;
local uint32 dec_used  = 0;
local uint32 junk_used = 0;
local uint32 hdrl_used = 0;

/* ===========================================================================
 * Geometry and size arithmetic.
 *
 * Every one of these takes its inputs as PARAMETERS, never as fields, so that
 * ffcompile's value miner - which installs the literals of any
 * `field == literal` comparison as that field's global known_values - cannot
 * reach biWidth, biHeight, biBitCount, biCompression, nChannels,
 * wBitsPerSample or wFormatTag through them.  Those are the diversity axes.
 * =========================================================================== */

/* ceil(a/d) for positive a, d */
int64 CeilDiv(int64 a, int64 d)
{
    if (d <= 0)
        return 0;
    return (a + d - 1) / d;
}

/* BITMAPINFOHEADER.biHeight is declared uint32 by the original, but Windows
 * defines it as a signed LONG and a negative value means top-down row order
 * (TEMPLATE SIGNEDNESS, recorded on the constraint).  Recover the magnitude. */
int64 AbsHeight(uint32 h)
{
    local int64 v = h;
    if (v > 2147483647)
        v = 4294967296 - v;
    return v;
}

/* Row stride of an uncompressed DIB: padded to a 4-byte boundary exactly as in
 * a standalone BMP.  ((biWidth * biBitCount + 31) / 32) * 4 */
int64 RowBytes(int64 w, int64 bits)
{
    if (w <= 0 || bits <= 0 || w > 2000000 || bits > 32)
        return 0;
    return ((w * bits + 31) / 32) * 4;
}

/* The exact byte count a BI_RGB / BI_BITFIELDS frame must carry.  This is the
 * product of the three free geometry fields and is the constraint set's
 * central rule: the payload is computed from the geometry, never the other
 * way round.  0 means "not expressible", which the caller turns into a choice
 * of codec, never into a smaller dimension. */
int64 RawBytes(uint32 w, uint32 h, uint16 bits)
{
    local int64 rb = RowBytes(w, bits);
    local int64 hh = AbsHeight(h);
    if (rb <= 0 || hh <= 0 || rb > 4000000 || hh > 4000000)
        return 0;
    return rb * hh;
}

/* A bound on every geometry-derived payload this template can emit: the widest
 * raw fourcc below is 4 bytes per pixel. */
int64 GeoBound(uint32 w, uint32 h)
{
    local int64 ww = w;
    local int64 hh = AbsHeight(h);
    if (ww <= 0 || hh <= 0 || ww > 4000000 || hh > 4000000)
        return 0;
    if (ww * hh > 200000000)
        return 0;
    return 4 * ww * hh + 64;
}

/* msvideo1 and MJPG both cost O(w*h) but with a small constant: four bytes per
 * 4x4 block, and two entropy bits per 8x8 block respectively. */
int64 BlockBound(uint32 w, uint32 h)
{
    local int64 ww = w;
    local int64 hh = AbsHeight(h);
    if (ww <= 0 || hh <= 0 || ww > 4000000 || hh > 4000000)
        return 0;
    if (ww * hh > 200000000)
        return 0;
    return 4 * CeilDiv(ww, 4) * CeilDiv(hh, 4) + 64;
}

uint32 Cap(uint32 want, uint32 room)
{
    if (want > room)
        return room;
    return want;
}

/* ===========================================================================
 * BITMAPINFOHEADER.biCompression -> payload emitter.
 *
 * The constraint set records biCompression as the single highest-leverage
 * field in AVI (eight decoders from one DWORD) with completeness "partial",
 * and says an unlisted fourcc is still legal to emit.  The dispatch below is
 * what gives every value in the set a payload the decoder will accept:
 *
 *   kind 1  BI_RGB / BI_BITFIELDS   exact ((w*bpp+31)/32)*4*|h| DIB rows
 *   kind 2  BI_RLE8 / BI_RLE4       a real Microsoft RLE stream
 *   kind 3  MJPG / mjpg             a complete JPEG, sized from the geometry
 *   kind 4  MSVC / CRAM             Microsoft Video 1, four bytes per 4x4 block
 *   kind 5  cvid                    a Cinepak frame header with zero strips
 *   kind 6  raw fourcc              exact av_image_get_buffer_size() product
 *   kind 7  reference bitstream     one real frame for the codec (ref_pool)
 *   kind 0  anything else           free bytes - the no-decoder path
 * =========================================================================== */

/* The fourccs the measured target maps to AV_CODEC_ID_RAWVIDEO, with the exact
 * byte count each pixel format needs.  Each one is a DIFFERENT pix_fmt, and so
 * a different input path through the scaler that feeds the output encoder -
 * which is where libswscale's coverage comes from.  Every formula below was
 * verified against the measured target at 16x16, 7x5 and 20x9. */
int64 RawTagBytes(uint32 comp, int64 w, int64 h)
{
    if (w <= 0 || h <= 0 || w > 100000 || h > 100000)
        return 0;
    switch (comp)
    {
        /* yuv420p */
        case 0x30323449: /* I420 */
        case 0x56555949: /* IYUV */
        case 0x32315659: /* YV12 */
        case 0x3032344A: /* J420 - yuvj420p */
            return w * h + 2 * CeilDiv(w, 2) * CeilDiv(h, 2);
        /* nv12 / nv21 - same byte count, different plane layout */
        case 0x3231564E: /* NV12 */
        case 0x3132564E: /* NV21 */
            return w * h + 2 * CeilDiv(w, 2) * CeilDiv(h, 2);
        /* yuv422p */
        case 0x42323459: /* Y42B */
        case 0x32323450: /* P422 */
        case 0x32323449: /* I422 */
        case 0x3232344A: /* J422 - yuvj422p */
        case 0x36315659: /* YV16 */
            return w * h + 2 * CeilDiv(w, 2) * h;
        /* yuv410p */
        case 0x39565559: /* YUV9 */
        case 0x30313449: /* I410 */
            return w * h + 2 * CeilDiv(w, 4) * CeilDiv(h, 4);
        /* yuv411p */
        case 0x42313459: /* Y41B */
        case 0x31313449: /* I411 */
            return w * h + 2 * CeilDiv(w, 4) * h;
        /* yuv440p */
        case 0x30343449: /* I440 */
        case 0x3034344A: /* J440 - yuvj440p */
            return w * h + 2 * w * CeilDiv(h, 2);
        /* yuv444p */
        case 0x34343449: /* I444 */
        case 0x3434344A: /* J444 - yuvj444p */
        case 0x34325659: /* YV24 */
            return 3 * w * h;
        /* yuva420p / yuva422p - the alpha plane adds a full w*h */
        case 0x41303449: /* I40A */
            return 2 * w * h + 2 * CeilDiv(w, 2) * CeilDiv(h, 2);
        case 0x41323449: /* I42A */
            return 2 * w * h + 2 * CeilDiv(w, 2) * h;
        /* gray8 and pal8 - one byte per pixel, no row padding */
        case 0x30303859: /* Y800 */
        case 0x20203859: /* "Y8  " */
        case 0x59455247: /* GREY */
        case 0x32424752: /* RGB2 - pal8 */
            return w * h;
        /* two bytes per pixel, packed */
        case 0x32595559: /* YUY2  - yuyv422  */
        case 0x59565955: /* UYVY  - uyvy422  */
        case 0x35315652: /* RV15  - rgb555le */
        case 0x36315652: /* RV16  - rgb565le */
            return 2 * w * h;
        /* three bytes per pixel */
        case 0x34325652: /* RV24 - rgb24 */
            return 3 * w * h;
        /* four bytes per pixel */
        case 0x41424752: /* RGBA */
        case 0x41524742: /* BGRA */
        case 0x52474241: /* ABGR */
        case 0x56555941: /* AYUV - vuya */
        case 0x32335652: /* RV32 */
            return 4 * w * h;
        /* cljr is not rawvideo, but its frame is a fixed-rate one byte per
         * pixel of packed YUV and every byte value is legal, so its payload is
         * a product of the free geometry exactly as a raw format's is. */
        case 0x524A4C43: /* CLJR */
            return w * h;
    }
    return 0;
}

/* Index into ref_pool for a video fourcc, or -1.  Several fourccs share one
 * bitstream where they share a decoder: the five MPEG-4 Part 2 tags all take
 * the same Simple-Profile I-VOP, and both H.264 tags the same Annex-B IDR. */
int VidRef(uint32 comp)
{
    switch (comp)
    {
        case 0x44495658: /* XVID */
        case 0x58564944: /* DIVX */
        case 0x30355844: /* DX50 */
        case 0x34504D46: /* FMP4 */
        case 0x5634504D: /* MP4V */  return 0;   /* mpeg4videodec  */
        case 0x34363248: /* H264 */
        case 0x34363268: /* h264 */  return 1;   /* h264dec        */
        case 0x3167706D: /* mpg1 */  return 2;   /* mpeg12dec v1   */
        case 0x3267706D: /* mpg2 */  return 3;   /* mpeg12dec v2   */
        case 0x3234504D: /* MP42 */  return 4;   /* msmpeg4v2      */
        case 0x3334504D: /* MP43 */  return 5;   /* msmpeg4v3      */
        case 0x31564D57: /* WMV1 */  return 6;   /* msmpeg4v1/wmv1 */
        case 0x32564D57: /* WMV2 */  return 7;   /* wmv2dec        */
        case 0x33363248: /* H263 */  return 8;   /* h263dec        */
        case 0x31564C46: /* FLV1 */  return 9;   /* flvdec         */
        case 0x534C4A4D: /* MJLS */  return 10;  /* jpeglsdec      */
        case 0x474E504D: /* MPNG */  return 11;  /* pngdec         */
        case 0x20616774: /* "tga " */ return 12; /* targa          */
        case 0x31717673: /* svq1 */  return 13;  /* svq1dec        */
        case 0x56424D5A: /* ZMBV */  return 14;  /* zmbv           */
        case 0x574F4E53: /* SNOW */  return 15;  /* snowdec        */
        case 0x31565341: /* ASV1 */  return 16;  /* asvdec v1      */
        case 0x32565341: /* ASV2 */  return 17;  /* asvdec v2      */
        case 0x30385056: /* VP80 */
        case 0x20385056: /* "VP8 " */ return 19; /* vp8            */
        case 0x30395056: /* VP90 */  return 20;  /* vp9            */
    }
    return -1;
}

/* Index into ref_pool for an audio format tag, or -1. */
int AudRef(uint16 tag)
{
    switch (tag)
    {
        case 0x00FF: return 21;   /* aacdec                                  */
        case 0x0050: return 22;   /* mpegaudiodec layer II                   */
        case 0x0055: return 23;   /* mpegaudiodec layer III                  */
        case 0x2000: return 24;   /* ac3dec                                  */
        case 0xFFFE: return 25;   /* WAVE_FORMAT_EXTENSIBLE carrying E-AC-3   */
        case 0x0160: return 26;   /* wmadec v1                               */
        case 0x0161: return 27;   /* wmadec v2                               */
        case 0xF1AC: return 28;   /* flacdec                                 */
        case 0xA109: return 29;   /* speexdec                                */
    }
    return -1;
}

int VidKind(uint32 comp)
{
    if (comp == 0 || comp == 3)
        return 1;                                   /* BI_RGB / BI_BITFIELDS */
    if (comp == 1 || comp == 2)
        return 2;                                   /* BI_RLE8 / BI_RLE4     */
    if (comp == 0x47504A4D || comp == 0x67706A6D)
        return 3;                                   /* MJPG / mjpg           */
    if (comp == 0x4356534D || comp == 0x4D415243)
        return 4;                                   /* MSVC / CRAM           */
    if (comp == 0x64697663)
        return 5;                                   /* cvid                  */
    if (VidRef(comp) >= 0)
        return 7;
    if (RawTagBytes(comp, 16, 16) > 0)
        return 6;
    return 0;
}

int AudKind(uint16 tag)
{
    if (tag == 0x0002)
        return 2;                                   /* adpcm_ms block        */
    if (tag == 0x0011)
        return 3;                                   /* adpcm_ima_wav block   */
    if (AudRef(tag) >= 0)
        return 4;                                   /* reference bitstream   */
    return 1;                                       /* free bytes * blockalign */
}

/* WAVEFORMATEX.nBlockAlign, Tier A calculated_value: "nChannels *
 * wBitsPerSample / 8 for PCM; the codec's fixed frame size for the
 * block-oriented formats such as ADPCM and GSM".  Measured, GSM 6.10 with a
 * block align that did not match its codec was refused outright, so the
 * block codecs get their own size.  nChannels and wBitsPerSample stay bare -
 * this reads them, it does not constrain them. */
uint32 AudBlock(uint16 tag, uint16 ch, uint16 bps, uint32 refba)
{
    if (refba > 0)
        return refba;                               /* the reference frame's own block */
    if (tag == 0x0002 || tag == 0x0011)
        return 256;                                 /* one ADPCM block                 */
    if (tag == 0x0031 || tag == 0x0040 || tag == 0x0045)
        return 65;                                  /* GSM 6.10 / G.726                */
    if (tag == 0x0022)
        return 32;                                  /* DSP TrueSpeech                  */
    if (tag == 0x0020 || tag == 0x028F || tag == 0x0200 || tag == 0x0006 || tag == 0x0007)
        return 1;                                   /* byte-oriented, no block         */
    local uint32 b = bps / 8;
    local uint32 c = ch;
    if (b == 0)
        b = 1;
    if (c == 0)
        c = 1;
    if (b * c > 65535)
        return 65535;                               /* the field is a WORD             */
    return b * c;
}

/* The codec-specific extradata length a format tag needs, which is what
 * WAVEFORMATEX.cbSize (Tier A) must state.  Dependency: WAVE_FORMAT_EXTENSIBLE
 * requires 22 bytes - valid bits, a channel mask and a format GUID. */
uint32 AudExtra(uint16 tag, uint32 reflen)
{
    if (tag == 0xFFFE)
        return 22;
    if (reflen > 0)
        return reflen;
    if (tag == 0x0002)
        return 32;                                  /* wSamplesPerBlock + 7 coef pairs */
    if (tag == 0x0011)
        return 2;                                   /* wSamplesPerBlock                */
    if (tag == 0x0031 || tag == 0x0022 || tag == 0x0040)
        return 2;
    return 0;
}

/* ===========================================================================
 * BITMAPINFOHEADER.biCompression - Tier B, enumerated_values, completeness
 * "partial".  All 29 values the constraint set lists are present, plus
 * 18 further registered fourccs that each reach a decoder the listed set
 * leaves unreachable and 30 further rawvideo fourccs that each select a
 * different pixel format, and so a different conversion path in the scaler
 * that feeds the output encoder.  preferred_value [0, 1, 2, MJPG, MSVC, cvid]
 * is expressed by repeating those values inside the set, because the engine
 * draws uniformly from the vector.
 *
 * Three sets, not one.  A BI_RGB or raw-fourcc frame is an exact product of
 * the three FREE geometry fields, so for a geometry whose product does not fit
 * in the engine's 64 KB file the value is simply unsatisfiable: dependency 3
 * then has no legal payload.  The alternative to choosing a codec whose frame
 * IS expressible would be clamping biWidth, biHeight or biBitCount, which is
 * the one mistake the whole strategy exists to prevent.  Every value still
 * appears in part of the corpus, because the geometry that excludes it is
 * itself free.  comp_all is used when the product fits, comp_mid when only the
 * O(w*h/16) codecs fit, comp_fix when neither does.
 * =========================================================================== */
local uint32 comp_all[] = {
    0, 0, 0, 0, 0, 0, 1, 1,
    1, 2, 2, 2, 3, 1196444237, 1196444237, 1196444237,
    1735420525, 1129730893, 1129730893, 1129730893, 1296126531, 1684633187, 1684633187, 1684633187,
    1145656920, 1482049860, 808802372, 877677894, 1446269005, 875967048, 875967080, 842225225,
    825513545, 808801865, 540561494, 808996950, 1431914056, 827737670, 1196575829, 844715353,
    1498831189, 808596553, 842094169, 1094862674, 828862573, 845639789, 842289229, 859066445,
    827739479, 844516695, 859189832, 827739206, 1397508685, 1196314701, 543254388, 829519475,
    1447185754, 1464815187, 827740993, 844518209, 1380600899, 809062486, 1448433993, 808596554,
    1110586457, 842150992, 842150985, 842150986, 909203033, 961959257, 808531017, 1110520921,
    825308233, 808727625, 808727626, 875836489, 875836490, 875714137, 1093678153, 1093809225,
    808466521, 538982489, 1497715271, 843204434, 842094158, 825382478, 892425810, 909203026,
    875714130, 842225234, 1095911234, 1380401729
};

local uint32 comp_mid[] = {
    1, 1, 1, 2, 2, 2, 1196444237, 1196444237,
    1196444237, 1735420525, 1129730893, 1129730893, 1129730893, 1296126531, 1684633187, 1684633187,
    1684633187, 1145656920, 1482049860, 808802372, 877677894, 1446269005, 875967048, 875967080,
    842225225, 825513545, 808801865, 540561494, 808996950, 1431914056, 827737670, 1196575829,
    828862573, 845639789, 842289229, 859066445, 827739479, 844516695, 859189832, 827739206,
    1397508685, 1196314701, 543254388, 829519475, 1447185754, 1464815187, 827740993, 844518209,
    1380600899, 809062486
};

local uint32 comp_fix[] = {
    1, 1, 1, 2, 2, 2, 1684633187, 1684633187,
    1684633187, 1145656920, 1482049860, 808802372, 877677894, 1446269005, 875967048, 875967080,
    842225225, 825513545, 808801865, 540561494, 808996950, 1431914056, 827737670, 1196575829,
    828862573, 845639789, 842289229, 859066445, 827739479, 844516695, 859189832, 827739206,
    1397508685, 1196314701, 543254388, 829519475, 1447185754, 1464815187, 827740993, 844518209,
    1380600899, 809062486
};


/* BITMAPINFOHEADER.biBitCount - Tier B, exhaustive, preferred [8,16,24,32].
 * Measured, 1/4/8 give pal8, 16 rgb555le, 24 bgr24, 32 bgra - four different
 * pixel unpacking paths and four different scaler input formats.  0 is legal
 * when biCompression names a codec that carries its own depth and 2 is the
 * Windows CE variant; both stay in the set. */
local uint16 bitcount_values[] = {
    0, 1, 2, 4, 8, 8, 8, 16, 16, 16, 24, 24, 24, 32, 32, 32
};


/* WAVEFORMATEX.wFormatTag - Tier B, exhaustive for the WAVE_FORMAT catalogue,
 * preferred [1,2,3,6,7,17,85].  Measured, seven distinct audio decoders come
 * out of this one WORD.  The 7 added tags each name a further decoder the
 * listed set leaves unreachable (AAC, WMA v1, G.722, FLAC, Speex, Creative
 * ADPCM, Duck DK4 ADPCM).  Tags with no decoder in the target are kept: the
 * container still parses them and ff_get_wav_header still runs. */
local uint16 wformat_values[] = {
    0, 1, 1, 1, 1, 2, 2, 2, 3, 3,
    3, 6, 6, 6, 7, 7, 7, 16, 17, 17,
    17, 32, 34, 49, 50, 64, 69, 80, 85, 85,
    85, 105, 112, 353, 354, 355, 8192, 8193, 65534, 65535,
    255, 352, 655, 61868, 41225, 512, 98
};


/* MainAVIHeader.dwFlags - Tier B, bitmask_constraint, valid_bits 0x00030934.
 * AVIF_HASINDEX 0x10, AVIF_MUSTUSEINDEX 0x20, AVIF_ISINTERLEAVED 0x100,
 * AVIF_TRUSTCKTYPE 0x800, AVIF_WASCAPTUREFILE 0x10000, AVIF_COPYRIGHTED
 * 0x20000.  Measured never a gate, so single bits, combinations, the full
 * union and all-bits-set are all emitted - AVIF_MUSTUSEINDEX in particular
 * changes a strict reader's whole strategy. */
local uint32 mainflags_values[] = {
    0, 16, 16, 32, 48, 48, 256, 272, 2048, 2064, 65536, 131072,
    304, 2096, 65552, 131088, 196608, 198961, 4294967295, 2352
};

/* AVIStreamHeader.dwFlags - Tier B, bitmask_constraint, valid_bits 0x00010001.
 * AVISF_DISABLED 0x1, AVISF_VIDEO_PALCHANGES 0x10000 - the second is what
 * makes a "##pc" palette-change chunk in the movi list meaningful, so it
 * pairs with genericblock.id below. */
local uint32 strflags_values[] = {
    0, 0, 0, 1, 65536, 65536, 65537, 4294967295
};

/* AVIINDEXENTRY.dwFlags - Tier B, bitmask_constraint, valid_bits 0x00100011.
 * AVIIF_LIST 0x1, AVIIF_KEYFRAME 0x10, AVIIF_NO_TIME 0x100000.  A file whose
 * entries all lack AVIIF_KEYFRAME forces a reader down its non-seekable path,
 * so 0 stays in the set. */
local uint32 idxflags_values[] = {
    16, 16, 16, 0, 1, 17, 1048576, 1048593, 4294967295
};

/* ===========================================================================
 * Per-stream record, filled as each strl list is emitted and read back by the
 * movi list.  MainAVIHeader.dwStreams is NOT this count - that field is Tier C
 * and stays bare; measured, ffmpeg ignores it entirely and counts the strl
 * lists it actually finds, so the real stream count is a free structural
 * choice and this is just how the generator remembers it.
 * =========================================================================== */
local uint32 n_str     = 0;
local uint32 want_str  = 1;
local uint32 st_type[0];     /* 1 = vids, 2 = auds, 3 = txts/mids           */
local uint32 st_kind[0];     /* payload emitter: VidKind() / AudKind()       */
local uint32 st_comp[0];     /* biCompression or wFormatTag                  */
local uint32 st_w[0];
local uint32 st_h[0];
local uint32 st_bits[0];
local uint32 st_ba[0];       /* nBlockAlign, for the audio payload unit      */
local uint32 st_ch[0];       /* nChannels, for the ADPCM block header        */
local uint32 st_ref[0];      /* ref_pool index, or 0                         */
local uint32 st_pal[0];      /* 1 when AVISF_VIDEO_PALCHANGES is set         */
local uint32 cur_strh_flags = 0;  /* AVIStreamHeader.dwFlags of the strl being emitted */

/* chunk-tree bookkeeping - every length field is computed from the bytes
 * actually emitted, working outwards (structure rule "requires"). */
local int64  pos_root_len = 0;
local int64  pos_hdrl_len = 0;
local int64  hdrl_body    = 0;
local int64  hdrl_end     = 0;
local int64  movi_type    = 0;
local uint32 have_hdrl    = 0;
local uint32 have_movi    = 0;
local uint32 have_idx     = 0;
local uint32 want_list    = 0;
local uint32 n_idx        = 0;
local uint32 idx_off[0];
local uint32 idx_len[0];
local double eof_p        = 0.01;
local char   nheader[4];

/* The space one media chunk may occupy.  This is the engine's file ceiling,
 * not a bound on any field - see the note on comp_all/comp_mid/comp_fix. */
local uint32 frame_room = 44000;

/* genericblock.id - Tier C, and dependency 14: "the two leading digits are the
 * zero-based index of the stream the chunk belongs to, and the two-character
 * suffix must match that stream's type - db or dc for vids, wb for auds, pc
 * for a palette change".  Derived from the stream index, never fixed, so a
 * two-stream file routes its chunks to the right streams; and the suffix is a
 * SET, not a value, so "db", "dc", "wb", "pc" and "tx" all occur. */
local string cid_db[] = { "00db","01db","02db","03db","04db","05db","06db","07db" };
local string cid_dc[] = { "00dc","01dc","02dc","03dc","04dc","05dc","06dc","07dc" };
local string cid_wb[] = { "00wb","01wb","02wb","03wb","04wb","05wb","06wb","07wb" };
local string cid_pc[] = { "00pc","01pc","02pc","03pc","04pc","05pc","06pc","07pc" };
local string cid_tx[] = { "00tx","01tx","02tx","03tx","04tx","05tx","06tx","07tx" };

/* ===========================================================================
 * Payload length arithmetic.  Each of these mirrors exactly what the matching
 * emitter below writes, because genericblock.datalen is declared BEFORE the
 * payload and has to state the length up front.
 * =========================================================================== */

/* Microsoft RLE: how many complete rows fit, and the resulting byte count.
 * Per row: ceil(w/255) [count][index] pairs then [00][00] end-of-line; the
 * stream closes with [00][01] end-of-bitmap.  An RLE frame that stops early is
 * still a valid frame - the decoder simply leaves the rest of the picture
 * untouched - so this is well-formed for ANY geometry, which is why BI_RLE8
 * and BI_RLE4 stay in comp_fix. */
int64 MsrleRows(int64 w, int64 h, int64 room)
{
    if (w <= 0 || h <= 0)
        return 0;
    local int64 per = 2 * CeilDiv(w, 255) + 2;
    local int64 maxr = (room - 2) / per;
    if (maxr < 0)
        maxr = 0;
    if (maxr > h)
        maxr = h;
    if (maxr > 4096)
        maxr = 4096;
    return maxr;
}

int64 MsrleBytes(int64 w, int64 h, int64 room)
{
    return MsrleRows(w, h, room) * (2 * CeilDiv(w, 255) + 2) + 2;
}

/* A complete baseline JPEG for an MJPG frame, sized from the free geometry.
 *   SOI 2 + DQT 69 + SOF0 (10 + 3*nc) + two DHT 44 + SOS (8 + 2*nc)
 *   + entropy ceil(blocks/4) + EOI 2
 * The entropy segment is two bits per 8x8 block: the DC difference coded with
 * a one-code DC table and an end-of-block from a one-code AC table, so every
 * byte is zero except the final pad - no 0xFF can appear and no byte stuffing
 * is ever needed. */
int64 JpegBytes(int64 w, int64 h, int64 nc)
{
    if (w <= 0 || h <= 0)
        return 0;
    local int64 blocks = CeilDiv(w, 8) * CeilDiv(h, 8) * nc;
    return 135 + 5 * nc + CeilDiv(blocks, 4);
}

/* Microsoft Video 1: four bytes for every 4x4 block - a 16-bit all-zero flag
 * word (every pixel takes colour A) followed by the two colour bytes. */
int64 Msv1Bytes(int64 w, int64 h)
{
    if (w <= 0 || h <= 0)
        return 0;
    return 4 * CeilDiv(w, 4) * CeilDiv(h, 4);
}

/* ===========================================================================
 * Reference codec bitstream pool - the payload emitters for the codecs whose
 * frames cannot be written in closed form from the geometry.
 *
 * One real key frame per codec and, where the codec is inter-coded, the delta
 * frame that follows it, plus the codec configuration that belongs in
 * strfHEADER_BIH.exData / strfHEADER_WAVE.exData (dependency 6).  Each one was
 * checked to decode in the measured target at a DECLARED geometry that
 * disagrees with the frame - these codecs carry their own dimensions, channel
 * count and sample rate in the bitstream - so biWidth, biHeight, biBitCount,
 * nChannels, nSamplesPerSec and wBitsPerSample all stay free.  That is the
 * difference between this and pinning a dimension to fit a fixed payload.
 *
 * index  decoder reached                      sizes
 *    0  mpeg4videodec  (XVID DIVX DX50 FMP4 MP4V) extradata   0  frames 48 + 8
 *    1  h264dec        (H264 h264)          extradata   0  frames 46
 *    2  mpeg12dec v1   (mpg1)               extradata   0  frames 38 + 15
 *    3  mpeg12dec v2   (mpg2)               extradata   0  frames 57 + 24
 *    4  msmpeg4v2      (MP42)               extradata   0  frames 8 + 2
 *    5  msmpeg4v3      (MP43)               extradata   0  frames 10 + 2
 *    6  msmpeg4v1/wmv1 (WMV1)               extradata   0  frames 10 + 2
 *    7  wmv2dec        (WMV2)               extradata   4  frames 8 + 3
 *    8  h263dec        (H263)               extradata   0  frames 21 + 14
 *    9  flvdec         (FLV1)               extradata   0  frames 14 + 8
 *   10  jpeglsdec      (MJLS)               extradata   0  frames 49
 *   11  pngdec         (MPNG)               extradata   0  frames 94
 *   12  targa          (tga )               extradata   0  frames 108
 *   13  svq1dec        (svq1)               extradata  22  frames 16 + 12
 *   14  zmbv           (ZMBV)               extradata   0  frames 27 + 10
 *   15  snowdec        (SNOW)               extradata   0  frames 32 + 11
 *   16  asvdec v1      (ASV1)               extradata   8  frames 12
 *   17  asvdec v2      (ASV2)               extradata   8  frames 12
 *   18  (unused: cljr is emitted from its geometry instead)
 *   19  vp8            (VP80 VP8 )          extradata   0  frames 31 + 17
 *   20  vp9            (VP90)               extradata   0  frames 28 + 15
 *   21  aacdec         (0x00FF)             extradata   6  frames 21 + 4
 *   22  mpegaudio L2   (0x0050)             extradata  22  frames 288
 *   23  mpegaudio L3   (0x0055)             extradata  12  frames 72
 *   24  ac3dec         (0x2000)             extradata   0  frames 192
 *   25  eac3 in EXTENSIBLE (0xFFFE)         extradata  22  frames 192
 *   26  wmadec v1      (0x0160)             extradata   4  frames 256
 *   27  wmadec v2      (0x0161)             extradata  10  frames 256
 *   28  flacdec        (0xF1AC)             extradata  34  frames 11 + 12
 *   29  speexdec       (0xA109)             extradata  80  frames 62 + 62
 * =========================================================================== */

