            str_stts entry[entry_count];
            break;
        case "stsc":
            // mp4box.entry_count, Tier A.  str_stsc.samples_per_chunk is Tier C and
            // stays BARE: the chunk layout the chunk offsets are computed from is read
            // back from the values FormatFuzzer actually drew, which is why the stsc box
            // is emitted before the stco or co64 box that depends on it.
            local int _cn = 1;
            if (g_tr_ns[_trk] > 3) _cn = 1 + rnd(3);
            local int evil_cv = SetEvilBit(IsParsing());
            byte version = { 0 } <name="Version">;
            uchar flag[3] = { g_zero3[0] } <open=suppress, name="Flags">;
            if (IsParsing()) { uint32 entry_count; }
            else             { uint32 entry_count = { (uint32)_cn }; }
