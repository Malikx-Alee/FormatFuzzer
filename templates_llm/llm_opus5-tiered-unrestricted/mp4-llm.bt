                    fix_add(FTell(), chunk_rel(_trk, _oi + 1), 4);
                    local int evil_o1 = SetEvilBit(IsParsing());
                    uint32 chunk_offset = { 0 };
                    SetEvilBit(evil_o1);
                }
            }
            break;
        case "co64":
            local int evil_qv = SetEvilBit(IsParsing());
            byte version = { 0 } <name="Version">;
            uchar flag[3] = { g_zero3[0] } <open=suppress, name="Flags">;
            if (IsParsing()) { uint32 entry_count; }
            else             { uint32 entry_count = { (uint32)g_tr_nchunk[_trk] }; }
            SetEvilBit(evil_qv);
            if (IsParsing())
            {
                uint64 chunk_offset[entry_count];
            }
            else
            {
                local int _qi = 0;
                for (_qi = 0; _qi < entry_count; _qi++)
                {
                    fix_add(FTell(), chunk_rel(_trk, _qi + 1), 8);
                    local int evil_q1 = SetEvilBit(IsParsing());
