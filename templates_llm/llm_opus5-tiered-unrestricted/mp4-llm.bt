                uint32 reserved <name="Reserved">;
                uint64 duration64 <name="Duration", comment="Duration of the media in movie time scale units (specified in mvhd box)">;
            }
            uint64 reserved2 <name="Reserved">;
            uint16 layer <name="Layer">;
            uint16 alt_group <name="Alternate Group">;
            fp16 volume <name="Volume">;
            uint16 reserved3 <name="Reserved">;
            matrix matrix_structure <name="Matrix Structure">;
            // mp4box.width and mp4box.height are Tier C diversity axes: BARE
            fp32 width <name="Track Width">;
            fp32 height <name="Track Height">;
            if (IsParsing() == 0)
            {
                // dependency 16: a fragment's trackID has to name a track that exists,
                // so the identifier the bare field drew is recorded here rather than
                // the field being pinned
                if (_trk >= 0 && _trk < 8) { g_tid[_trk] = track_id; }
                stir(track_id);
                stir(layer);
                stir(alt_group);
                stir(reserved3);
            }
            break;
        case "vmhd":
            local int evil_wv = SetEvilBit(IsParsing());
            byte version = { 0 } <name="Version">;
            SetEvilBit(evil_wv);
            vmhd_flags flags <name="Flags">;
            // mp4box.graphics_mode, Tier B, dependency 24: nine compositing modes, two
            // of which are the only ones that make the opcolor meaningful
            local int evil_gm = SetEvilBit(IsParsing());
            qtgfxmode graphics_mode = { qtgCopy, qtgCopy, qtgDitherCopy, qtgBlend,
                                        qtgTransparent, qtgStraightAlpha,
                                        qtgPremulWhiteAlpha, qtgPremulBlackAlpha,
                                        qtgStraightAlphaBlend, qtgComposition } <name="Graphics Mode">;
            SetEvilBit(evil_gm);
            qtopcolor opcolor <name="Opcolor", open=suppress>;
            break;
        //--------------------------------------------------------------------------
        // Added by the rewrite.  Each arm names the decoder branch it reaches.
        //--------------------------------------------------------------------------
        case "hmhd":
            if (IsParsing())
            {
                // the original switch did not name this type, so parsing
                // keeps its skip-by-size exactly (hint media header)
                FSkip(contentsize);
            }
            else
            {
                // dependency 10/11 sibling: the hint media header a 'hint' track requires
                local int evil_mh = SetEvilBit(IsParsing());
                byte version = { 0 } <name="Version">;
                byte flags[3] <open=suppress, name="Flags">;
                SetEvilBit(evil_mh);
                uint16 maxPDUsize;
                uint16 avgPDUsize;
                uint32 maxbitrate;
                uint32 avgbitrate;
                uint32 reserved;
            }
            break;
        case "nmhd":
            if (IsParsing())
            {
                // the original switch did not name this type, so parsing
                // keeps its skip-by-size exactly (null media header)
                FSkip(contentsize);
            }
            else
            {
                // the null media header a metadata, subtitle or timecode track carries
                local int evil_nh = SetEvilBit(IsParsing());
                byte version = { 0 } <name="Version">;
                byte flags[3] <open=suppress, name="Flags">;
                SetEvilBit(evil_nh);
            }
            break;
        case "dref":
            if (IsParsing())
            {
                // the original switch did not name this type, so parsing
                // keeps its skip-by-size exactly (data reference box)
                FSkip(contentsize);
            }
            else
            {
                // structure rule 12: the data reference table the sample entries'
                // data_reference_index points into.  A self-contained 'url ' entry whose
                // flags are 1 is what every writer produces.
                local int evil_dr = SetEvilBit(IsParsing());
                byte version = { 0 } <name="Version">;
                byte flags[3] <open=suppress, name="Flags">;
                // structure rule 12: at least one entry.  A reader refuses an empty data
                // reference table outright, so zero is not in the set.
                uint32 entry_count = { 1, 1, 1, 1, 2, 2, 3 };
                SetEvilBit(evil_dr);
                local int _di = 0;
                for (_di = 0; _di < entry_count; _di++)
                {
                    struct
                    {
                        local int evil_de = SetEvilBit(IsParsing());
                        uint32 size = { 12 };
                        if (IsParsing() == 0) { g_want[0] = "url "; }
                        fcc_fill(5);
                        fourcc type;
                        byte version = { 0 };
                        byte flags_hi = { 0 };
                        byte flags_mid = { 0 };
                        // a self-contained entry, which is what every writer produces
                        byte flags_low = { 1, 1, 1, 0 };
                        SetEvilBit(evil_de);
                    } dref_entry;
                }
            }
            break;
        case "mdat":
            // meta.unnamed_payloads: the media bytes the sample tables address.  mdat is
            // not in the original switch and falls to the skip at the default arm, so the
            // parse direction is left exactly as it was and only the generator writes a
            // body here.
            if (IsParsing())
            {
                FSkip(contentsize);
            }
            else if (g_mdat_done == 0)
            {
                g_mdat_done = 1;
                g_mdat_body = FTell();
                local int _mt = 0;
                local int _mi = 0;
                local int64 _msz = 0;
                for (_mt = 0; _mt < g_ntracks; _mt++)
                {
                    need_track(_mt);
                    for (_mi = 0; _mi < g_tr_ns[_mt]; _mi++)
                    {
                        _msz = samp_size(_mt, _mi);
                        if (FTell() + _msz < 63000)
                        {
                            if (g_tr_kind[_mt] == 0 && _msz >= 5)
                            {
                                // AVCC length-prefixed access unit: the length field is
                                // lengthSizeMinusOne+1 = 4 bytes big-endian and the
                                // lengths sum exactly to the sample's stsz entry_size
                                local int evil_nl = SetEvilBit(IsParsing());
                                uint32 nal_length = { (uint32)(_msz - 4) };
                                ubyte nal_header <values=g_nal7>;
                                SetEvilBit(evil_nl);
                                if (_msz > 5) { byte nal_payload[_msz - 5]; }
                            }
                            else
                            {
                                // uncompressed video or PCM audio: every byte is free
                                byte sample_data[_msz];
                            }
                        }
                    }
                }
            }
            else
            {
                // a fragment's media data
                local int64 _fn = 8 + (int64)rnd(220);
                if (FTell() + _fn < 63000) { byte frag_data[_fn]; }
            }
            break;
        case "raw ":
        case "2vuy":
        case "yuv2":
        case "rgb ":
        case "avc1":
        case "hvc1":
        case "mp4v":
        case "av01":
        case "vp09":
        case "mp4s":
        case "rtp ":
        case "ZZZZ":
        case "tmcd":
        case "tx3g":
        case "text":
        case "c608":
        case "mp4a":
        case "ac-3":
        case "samr":
        case "Opus":
        case "twos":
        case "sowt":
        case "ulaw":
        case "alaw":
        case "in24":
            if (IsParsing())
            {
                // the original switch did not name this type, so parsing
                // keeps its skip-by-size exactly (sample entries)
                FSkip(contentsize);
            }
            else
            {
                // mp4box.entries, Tier A payload_wellformedness.  The framing is exact: six
                // zero reserved bytes, a non-zero data_reference_index, the shape the handler
                // type requires (dependencies 12 and 13), and the codec configuration box
                // nested inside this entry's own declared size.  Everything inside is free.
                local int evil_se = SetEvilBit(IsParsing());
                uchar reserved[6] = { g_zero6[0] } <open=suppress>;
                uint16 data_reference_index = { 1, 1, 1, 2 };
                SetEvilBit(evil_se);
                if (g_tr_hdl[_trk] == "soun")
                {
                    // AudioSampleEntry, 36 bytes before any nested box
                    // Version 0 is 36 bytes; the QuickTime version 1 form adds four
                    // 32-bit words and version 2 adds nine, and a reader reads exactly
                    // those, so the version is part of the framing, not free content.
                    local int evil_sv2 = SetEvilBit(IsParsing());
                    uint16 sound_version = { 0, 0, 0, 0, 0, 1, 1, 2 };
                    SetEvilBit(evil_sv2);
                    uint16 revision_level;
                    uint32 vendor;
                    uint16 channelcount;
                    uint16 samplesize;
                    uint16 compression_id;
                    uint16 packet_size;
                    uint32 samplerate;
                    if (sound_version == 1)
                    {
                        uint32 samples_per_packet;
                        uint32 bytes_per_packet;
                        uint32 bytes_per_frame;
                        uint32 bytes_per_sample;
                    }
                    else if (sound_version == 2)
                    {
                        local int evil_v2 = SetEvilBit(IsParsing());
                        uint32 sizeof_struct_only = { 72 };
                        SetEvilBit(evil_v2);
                        uint64 audio_sample_rate;
                        uint32 v2_channelcount;
                        local int evil_v3 = SetEvilBit(IsParsing());
                        uint32 always7F000000 = { 0x7F000000 };
                        SetEvilBit(evil_v3);
                        uint32 const_bits_per_channel;
                        uint32 format_specific_flags;
                        uint32 const_bytes_per_audio_packet;
                        uint32 const_lpcm_frames_per_audio_packet;
                    }
                }
                else if (g_tr_hdl[_trk] == "vide")
                {
                    // VisualSampleEntry, 86 bytes before any nested box.  The declared
                    // geometry here is payload content the JSON records as free, and for the
                    // uncompressed entries it is what the sample length is DERIVED from.
                    uint16 pre_defined;
                    uint16 reserved_v;
                    uint32 pre_defined2[3];
                    local int evil_wh = SetEvilBit(IsParsing());
                    uint16 sample_width  = { (uint16)g_tr_w[_trk] };
                    uint16 sample_height = { (uint16)g_tr_h[_trk] };
                    SetEvilBit(evil_wh);
                    uint32 horizresolution;
                    uint32 vertresolution;
                    uint32 reserved_v2;
                    uint16 frame_count;
                    byte compressorname[32];
                    local int evil_dp = SetEvilBit(IsParsing());
                    uint16 depth = { (uint16)g_tr_depth[_trk] };
                    SetEvilBit(evil_dp);
                    int16 pre_defined3;
                }
                else
                {
                    // every other handler type: the generic entry body a reader skips
                    local int64 _gn = (int64)rnd(20);
                    if (_gn > 0) { byte entry_body[_gn]; }
                }
                // the nested codec configuration and auxiliary boxes
                if (IsParsing() == 0)
                {
                    local int _ei2 = 0;
                    local int _ectx = 15;
                    if (g_tr_hdl[_trk] == "soun") _ectx = 16;
                    while (plan_child(_ectx, _ei2))
                    {
                        mp4box box <name="Box">;
                        _ei2 = _ei2 + 1;
                        g_trk = _trk;
                    }
                }
            }
            break;
        case "avcC":
            if (IsParsing())
            {
                // the original switch did not name this type, so parsing
                // keeps its skip-by-size exactly (AVC configuration record)
                FSkip(contentsize);
            }
            else
            {
                // ISO/IEC 14496-15 AVCDecoderConfigurationRecord: configurationVersion 1,
                // the three profile and level bytes, lengthSizeMinusOne 3, one SPS and one
                // PPS as uint16-length-prefixed payloads.  This is the extradata the H.264
                // decoder parses to initialise; a randomised body was measured to leave the
                // stream listed but decoding nothing.
                local int evil_ac = SetEvilBit(IsParsing());
                ubyte configurationVersion = { 1 };
                ubyte AVCProfileIndication = { 0x42, 0x42, 0x4d, 0x58, 0x64, 0x66, 0x6e };
                ubyte profile_compatibility = { 0xc0, 0xc0, 0xe0, 0x00, 0x40 };
                ubyte AVCLevelIndication = { 0x0a, 0x0a, 0x0b, 0x0c, 0x1e, 0x1f, 0x28, 0x33 };
                ubyte lengthSizeMinusOne = { 0xff };
                ubyte numOfSequenceParameterSets = { 0xe1 };
                uint16 sequenceParameterSetLength = { 22 };
                char sequenceParameterSetNALUnit[22] = { g_sps[0] };
                ubyte numOfPictureParameterSets = { 1 };
                uint16 pictureParameterSetLength = { 5 };
                char pictureParameterSetNALUnit[5] = { g_pps[0] };
                SetEvilBit(evil_ac);
            }
            break;
        case "hvcC":
            if (IsParsing())
            {
                // the original switch did not name this type, so parsing
                // keeps its skip-by-size exactly (HEVC configuration record)
                FSkip(contentsize);
            }
            else
            {
                // ISO/IEC 14496-15 HEVCDecoderConfigurationRecord header: enough framing for
                // the hvcC parser to run before it asks for parameter set arrays
                local int evil_hc = SetEvilBit(IsParsing());
                char hevc_config[23] = { g_hvcc[0] };
                ubyte numOfArrays = { 0 };
                SetEvilBit(evil_hc);
            }
            break;
        case "esds":
            if (IsParsing())
            {
                // the original switch did not name this type, so parsing
                // keeps its skip-by-size exactly (elementary stream descriptor)
                FSkip(contentsize);
            }
            else
            {
                // ISO/IEC 14496-1 elementary stream descriptor: the ES, DecoderConfig and
                // DecoderSpecificInfo tags a reader walks to find the object type and the
                // AudioSpecificConfig
                local int evil_es = SetEvilBit(IsParsing());
                byte version = { 0 } <name="Version">;
                byte flags[3] <open=suppress, name="Flags">;
                ubyte ES_DescrTag = { 0x03 };
                ubyte ES_length = { 0x19 };
                uint16 ES_ID = { 1 };
                ubyte ES_flags = { 0 };
                ubyte DecoderConfigDescrTag = { 0x04 };
                ubyte DCD_length = { 0x11 };
                // mp4box.entries diversity: the object type indication selects the decoder
                ubyte objectTypeIndication = { 0x40, 0x40, 0x40, 0x40, 0x67, 0x6b,
                                           0x20, 0x21, 0xa5, 0xdd, 0x69, 0xe1 };
                ubyte streamType = { 0x15, 0x15, 0x11 };
                byte bufferSizeDB[3];
                uint32 maxBitrate;
                uint32 avgBitrate;
                ubyte DecSpecificInfoTag = { 0x05 };
                ubyte DSI_length = { 2 };
                char audioSpecificConfig[2] = { g_asc[0] };
                ubyte SLConfigDescrTag = { 0x06 };
                ubyte SL_length = { 1 };
                ubyte SL_predefined = { 2 };
                SetEvilBit(evil_es);
            }
            break;
        case "av1C":
            if (IsParsing())
            {
                // the original switch did not name this type, so parsing
                // keeps its skip-by-size exactly (AV1 configuration record)
                FSkip(contentsize);
            }
            else
            {
                local int evil_a1 = SetEvilBit(IsParsing());
                ubyte av1_marker_version = { 0x81 };
                ubyte av1_profile_level = { 0x00, 0x04, 0x08 };
                ubyte av1_flags1 = { 0x0c, 0x00 };
                ubyte av1_flags2 = { 0x00 };
                SetEvilBit(evil_a1);
            }
            break;
        case "vpcC":
            if (IsParsing())
            {
                // the original switch did not name this type, so parsing
                // keeps its skip-by-size exactly (VP9 configuration record)
                FSkip(contentsize);
            }
            else
            {
                local int evil_v1 = SetEvilBit(IsParsing());
                byte version = { 1 } <name="Version">;
                byte flags[3] <open=suppress, name="Flags">;
                ubyte vp_profile = { 0, 1, 2, 3 };
                ubyte vp_level = { 10, 11, 20, 21, 30, 40, 50 };
                ubyte vp_bitdepth_chroma = { 0x80, 0x82, 0x88 };
                ubyte vp_colour_primaries = { 1, 2, 9 };
                ubyte vp_transfer = { 1, 2, 16 };
                ubyte vp_matrix_range = { 0x02, 0x00 };
                uint16 vp_codec_init_size = { 0 };
                SetEvilBit(evil_v1);
            }
            break;
        case "dac3":
            if (IsParsing())
            {
                // the original switch did not name this type, so parsing
                // keeps its skip-by-size exactly (AC-3 specific box)
                FSkip(contentsize);
            }
            else
            {
                local int evil_d3 = SetEvilBit(IsParsing());
                uchar ac3_info[3] = { g_zero3[0] };
                SetEvilBit(evil_d3);
            }
            break;
        case "damr":
            if (IsParsing())
            {
                // the original switch did not name this type, so parsing
                // keeps its skip-by-size exactly (AMR specific box)
                FSkip(contentsize);
            }
            else
            {
                local int evil_dm = SetEvilBit(IsParsing());
                uint32 amr_vendor = { 1297371986 };
                ubyte amr_decoder_version = { 0 };
                uint16 amr_mode_set = { 0x81ff, 0x0001 };
                ubyte amr_mode_change_period = { 0 };
                ubyte amr_frames_per_sample = { 1 };
                SetEvilBit(evil_dm);
            }
            break;
        case "dOps":
            if (IsParsing())
            {
                // the original switch did not name this type, so parsing
                // keeps its skip-by-size exactly (Opus specific box)
                FSkip(contentsize);
            }
            else
            {
                local int evil_do = SetEvilBit(IsParsing());
                ubyte opus_version = { 0 };
                ubyte opus_channels = { 1, 2 };
                uint16 opus_pre_skip = { 312 };
                uint32 opus_sample_rate = { 48000 };
                int16 opus_gain = { 0 };
                ubyte opus_mapping_family = { 0 };
                SetEvilBit(evil_do);
            }
            break;
        case "pasp":
            if (IsParsing())
            {
                // the original switch did not name this type, so parsing
                // keeps its skip-by-size exactly (pixel aspect ratio)
                FSkip(contentsize);
            }
            else
            {
                // the pixel aspect ratio box a reader uses to reconcile the sample entry's
                // geometry with the track's
                uint32 hSpacing;
                uint32 vSpacing;
            }
            break;
        case "colr":
            if (IsParsing())
            {
                // the original switch did not name this type, so parsing
                // keeps its skip-by-size exactly (colour information)
                FSkip(contentsize);
            }
            else
            {
                local int evil_cr = SetEvilBit(IsParsing());
                fcc_fill(5);
                if (IsParsing() == 0) { g_want[0] = "nclx"; }
                fourcc colour_type;
                uint16 colour_primaries = { 1, 5, 6, 9 };
                uint16 transfer_characteristics = { 1, 6, 16, 18 };
                uint16 matrix_coefficients = { 1, 5, 6, 9 };
                ubyte full_range_flag = { 0x00, 0x80 };
                SetEvilBit(evil_cr);
            }
            break;
        case "btrt":
            if (IsParsing())
            {
                // the original switch did not name this type, so parsing
                // keeps its skip-by-size exactly (bit rate box)
                FSkip(contentsize);
            }
            else
            {
                uint32 bufferSizeDB;
                uint32 maxBitrate;
                uint32 avgBitrate;
            }
            break;
        default:
            // structure rule 7: free, skip and wholly unregistered box types, which are
            // the only route into a reader's skip-by-size path
            if (IsParsing())
            {
                FSkip(contentsize);
            }
            else
            {
                local int64 _un = 0;
                local int _uk = rnd(10);
                local int _first = 0;
                if (startOffset == 0) _first = 1;
                if (_uk < 3)      _un = 0;
                else if (_uk < 7) _un = 1 + (int64)rnd(40);
                else if (_uk < 9) _un = 1 + (int64)rnd(400);
                else              _un = 1 + (int64)rnd(3000);
                if (_un > g_cap_free) _un = g_cap_free;
                if (FTell() + _un > g_cap_file) _un = 0;
                // a leading free box has to cover the reserved seed bytes at 12 and 13
                if (_first && _un < 10) _un = 10;
                if (_un > 0) { byte unknown[_un]; }
            }
            break;
    }

    // boxheader.size / boxheader.size64, Tier A calculated_value: the real total, now
    // that the body has been written.  Never an evil value.
    if (IsParsing() == 0)
    {
        g_trk = _trk;
        local int64 _eo = FTell();
        local int64 _bs = _eo - (int64)startOffset;
        local int evil_fx = SetEvilBit(IsParsing());
        if (_wide)
        {
            FSeek(startOffset + 8);
            uint64 size64 = { (uint64)_bs };
        }
        else
        {
            FSeek(startOffset);
            uint32 size = { (uint32)_bs };
        }
        SetEvilBit(evil_fx);
        FSeek(_eo);
    }
} mp4box <read=ReadBox, comment=BoxComment>;

// mp4box.chunk_offset, Tier A: rewritten here because an absolute file offset cannot be
// known until both moov and mdat have been laid out (dependency 19).
typedef struct
{
    local int _fi = 0;
    local int64 _fe = FTell();
    for (_fi = 0; _fi < g_nfix; _fi++)
    {
        FSeek(g_fix_pos[_fi]);
        local int evil_cf = SetEvilBit(IsParsing());
        if (g_fix_w[_fi] == 8)
        {
            uint64 chunk_offset = { (uint64)(g_mdat_body + g_fix_rel[_fi]) };
        }
        else
        {
            uint32 chunk_offset = { (uint32)(g_mdat_body + g_fix_rel[_fi]) };
        }
        SetEvilBit(evil_cf);
    }
    FSeek(_fe);
} mp4fixup <open=suppress>;

mp4_init();

if (IsParsing())
{
    while (FTell() < FileSize())
    {
        mp4box box <name="Box">;
    }
}
else
{
    mp4_plan();
    while (plan_top(g_topi))
    {
        mp4box box <name="Box">;
        g_topi = g_topi + 1;
        g_randused = g_randused + 60 + (FTell() - g_file_end);
        g_file_end = FTell();
    }
    mp4fixup fixups;
}
