            if (IsParsing())
            {
                str_stsc entry[entry_count];
            }
            else
            {
                local int _ci2 = 0;
                g_spc_n = 0;
                for (_ci2 = 0; _ci2 < entry_count; _ci2++)
                {
                    g_stsc_fc = _ci2 + 1;
                    str_stsc stsc_entry;
                    if (g_spc_n < 8)
                    {
                        g_spc_v[g_spc_n] = stsc_entry.samples_per_chunk;
                        if (g_spc_v[g_spc_n] < 1) g_spc_v[g_spc_n] = 1;
                        g_spc_n = g_spc_n + 1;
