        case "stss":
            local int _yn = 1 + rnd(4);
            if (_yn > g_tr_ns[_trk]) _yn = g_tr_ns[_trk];
            local int evil_yv = SetEvilBit(IsParsing());
            byte version = { 0 } <name="Version">;
            uchar flag[3] = { g_zero3[0] } <open=suppress, name="Flags">;
            if (IsParsing()) { uint32 entry_count; }
            else             { uint32 entry_count = { (uint32)_yn }; }
