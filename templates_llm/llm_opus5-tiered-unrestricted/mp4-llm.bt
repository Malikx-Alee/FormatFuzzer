            {
                uint64 create_time64 <name="Creation Time">;
                uint64 modify_time64 <name="Modification Time">;
                uint32 time_scale <name="Time Scale", comment="Number of media time units per second">;
                uint64 duration64 <name="Duration", comment="Duration of the media in media time scale units">;
            }
            mp4lang language <name="Language">;
            uint16 quality <name="Quality">;
            if (IsParsing() == 0)
            {
                stir(time_scale);
                stir(quality);
