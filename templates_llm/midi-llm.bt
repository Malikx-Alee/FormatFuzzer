//------------------------------------------------
//--- 010 Editor Binary Template
//
//      File: MIDI.bt
//   Authors: Jack Andersen
//   Version: 2.0 (FormatFuzzer generation-optimized)
//   Purpose: Generate Standard MIDI Files (SMF).
//  Category: Audio
// File Mask: *.mid
//  ID Bytes: 4D 54 68 64 //MThd
//
// FormatFuzzer modifications (derived from
// results_ai/midi-orig/llm_reterived_constraints_midi-orig_opus4.7.json):
//
// The original template is a passive parser whose MidiMessage logic relies on
// running status, FSeek rewinds and break-terminated DeltaTime reads. Driven by
// a fuzzer that picks status/length/delta bytes randomly it never produces a
// parseable event stream, so every output is rejected.
//
// This generation version emits a complete, self-consistent SMF whose structure
// mirrors a real sequencer:
//   * MThd header: magic "MThd" (fixed), section length 6 (fixed), format 1
//     (enum), ntracks = the actual number of MTrk chunks (calculated), tickdiv
//     in [1,32767] (range);
//   * one or more MTrk chunks, each a well-formed event stream - set-tempo and
//     time-signature meta events, a program change, a run of note-on/note-off
//     pairs, and a terminating End-of-Track meta event;
//   * every MTrk section length is COMPUTED from the bytes actually written;
//   * all status bytes have the high bit set (0x80-0xFF) and all data bytes are
//     held in 0x00-0x7F, so the running-status/data-byte rules always hold.
// Fuzzable: track count, tickdiv, tempo, program, and the note pitches/velocities.
//
//   History:
//   2.0   2026-06-24 FormatFuzzer generation-optimization pass.
//   1.2   2016-05-17 J Andersen: Correctly interpret unset status-bit as repeat message.
//   1.0   J Andersen: Initial release.
//------------------------------------------------

BigEndian();                        // MIDI is big-endian
local int evil = SetEvilBit(false); // honour the pinned structural layout

// A note-on / note-off pair on channel 0. Data bytes are constrained to the
// MIDI data range 0x00-0x7F so they can never be mistaken for status bytes.
typedef struct {
    ubyte d_on   = { 0 };               // delta-time 0 (VLQ, 1 byte)
    ubyte s_on   = { 0x90 };            // Note On, channel 0 (status, high bit set)
    ubyte note   <min=0, max=127>;      // key number (data byte)
    ubyte vel    <min=1, max=127>;      // velocity   (data byte)
    ubyte d_off  = { 0x30 };            // delta-time 48 ticks (VLQ, 1 byte)
    ubyte s_off  = { 0x80 };            // Note Off, channel 0
    ubyte note_o <min=0, max=127>;      // key number
    ubyte vel_o  = { 0x40 };            // release velocity
} NOTE_PAIR;

// One MTrk chunk. The section length is patched to the real event-bytes size.
typedef struct {
    char  m_magic[4] = { "MTrk" };      // fixed track magic
    local int64 lenPos = FTell();
    uint  m_seclen;                     // patched below (calculated_value)
    local int64 evStart = FTell();

    SetBackColor( cLtGreen );
    // --- Set Tempo meta event:  00 FF 51 03 tt tt tt ---
    ubyte d_tempo = { 0 };
    ubyte st_tempo = { 0xFF };           // meta-event status
    ubyte mt_tempo = { 0x51 };           // META_TEMPO
    ubyte ml_tempo = { 3 };              // length 3
    ubyte tempo0;                        // 24-bit microseconds/quarter-note
    ubyte tempo1;
    ubyte tempo2;

    // --- Time Signature meta event:  00 FF 58 04 nn dd cc bb ---
    ubyte d_ts  = { 0 };
    ubyte st_ts = { 0xFF };
    ubyte mt_ts = { 0x58 };              // META_TIME_SIGNATURE
    ubyte ml_ts = { 4 };
    ubyte ts_num = { 4 };                // numerator
    ubyte ts_den = { 2 };                // denominator (2^2 = 4)
    ubyte ts_cpc = { 24 };               // MIDI clocks per metronome click
    ubyte ts_32  = { 8 };                // 32nd notes per quarter

    // --- Program Change:  00 C0 pp ---
    ubyte d_pc = { 0 };
    ubyte s_pc = { 0xC0 };               // Program Change, channel 0
    ubyte pc_prog <min=0, max=127>;      // instrument (data byte)

    // --- A short run of notes ---
    SetBackColor( cLtAqua );
    NOTE_PAIR notes[4];

    // --- End of Track meta event:  00 FF 2F 00 ---
    SetBackColor( cLtYellow );
    ubyte d_eot  = { 0 };
    ubyte st_eot = { 0xFF };
    ubyte mt_eot = { 0x2F };             // META_END_OF_TRACK
    ubyte ml_eot = { 0 };

    // --- Patch the section length to the real number of event bytes ---
    local int64 evEnd = FTell();
    local uint slen = evEnd - evStart;
    FSeek( lenPos );
    uint m_seclen = { slen };
    FSeek( evEnd );
    SetBackColor( cNone );
} MidiTrack <optimize=false>;

// MThd header.
typedef struct {
    char m_magic[4] = { "MThd" };        // fixed header magic
    uint m_seclen   = { 6 };             // fixed header length
    short m_format  = { 1 };             // SMF format 1 (one or more tracks)
    short m_ntracks;                     // set to the real track count below
    short m_tickdiv <min=24, max=960>;   // ticks per quarter note (in [1,32767])
} MidiHeader;

// ---------------------------------------------------------------------------
// MAIN
// ---------------------------------------------------------------------------
SetBackColor( cLtGray );
MidiHeader header;

// Decide how many tracks to emit (derived from the fuzzable tickdiv), then make
// the header's m_ntracks field agree with the real count (calculated_value).
local short nt = 1 + (header.m_tickdiv % 3);  // 1..3 tracks

// Patch m_ntracks (offset 10: 4 magic + 4 seclen + 2 format) to the real count.
local int64 hpos = FTell();
FSeek( 10 );
short m_ntracks = { nt };
FSeek( hpos );

MidiTrack tracks[ nt ] <optimize=false>;

SetEvilBit( evil );
