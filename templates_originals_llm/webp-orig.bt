//------------------------------------------------
//--- 010 Editor v14.0 Binary Template
//
//      File: Webp.bt
//   Authors: HearHellacopters
//   Version: 1.1 (FormatFuzzer generation-optimized)
//   Purpose: Webp image format.
//  Category: Image
// File Mask: *.webp
//  ID Bytes: 52 49 46 46
//
// FormatFuzzer modifications (derived from
// results_ai/webp-orig/llm_reterived_constraints_webp-orig_opus4.7.json):
//  - Pin HEADER.Magic to "RIFF" and HEADER.Payload to "WEBP"
//  - Restrict HEADER.FormatStr / VP8X.ExtFormatTest to {"VP8 ","VP8L","VP8X"}
//  - Pin chunk FourCCs (VP8 , VP8L, VP8X, ICCP, ALPH, ANIM/ANIF, EXIF, XMP )
//  - Pin VP8.start_code to 0x2A019D (2752925) and key_frame bit to 0
//  - Pin VP8L.signature to 0x2F and version_number to 0
//  - Pin VP8X reserved bits (Rsv, R, Rsv2, Rsv3) to 0 and ReadSize to 10
//  - Bound chunk sizes so the generator emits compact, well-formed WebPs
//  - Patch the outer RIFF ReadSize from the final file position
//   History:
//   1.1   2026-06-17 FormatFuzzer generation-optimization pass.
//   1.0   2023-09-28 HearHellacopters: Initial release.
//------------------------------------------------

LittleEndian();

typedef struct VP8 {
        char Magic[4] = { "VP8 " };
        int ChunkSize <min=10, max=4096>;
        local int read_size = 0;
        BitfieldDisablePadding();
        // frame_tag bit 0 must be 0 for a keyframe (only valid VP8 frame in WebP).
        // Pin bit 0 = 0 by constraining frame_tag to even values (bit0 clear).
        local int frame_tag_vals[] = { 0x000000, 0x000002, 0x000010, 0x000012 };
        int frame_tag : 24 <values=frame_tag_vals>;
        read_size += 3;
        local int key_frame = frame_tag & 0x1;
        local int version = (frame_tag >> 1) & 0x7;
        local int show_frame = (frame_tag >> 4) & 0x1;
        local int first_part_size = (frame_tag >> 5) & 0x7FFFF;
        // start_code = 0x9D 0x01 0x2A in stream order; little-endian 24-bit = 0x2A019D = 2752925.
        local int start_code_vals[] = { 0x2A019D };
        int start_code : 24 <values=start_code_vals, comment="must be 2752925">;
        int horizontal_size_code : 16;
        local int width = horizontal_size_code & 0x3FFF;
        local int horizontal_scale = horizontal_size_code >> 14;
        int vertical_size_code : 16;
        local int height = vertical_size_code & 0x3FFF;
        local int vertical_scale = vertical_size_code >> 14;
        BitfieldEnablePadding();
        read_size += 7;
        byte data[ChunkSize - read_size];
}VP8Data <open=true>;

typedef struct VP8L {
        char Magic[4] = { "VP8L" };
        int ReadSize <min=10, max=4096>;
        local int read_size = 0;
        byte signature = { 0x2F } <comment="must be 47">;
        read_size += 1;
        BitfieldDisablePadding();
        int ReadWidth : 14;
        local int width = ReadWidth+1;
        int ReadHeight : 14;
        local int height = ReadHeight+1;
        byte alpha_is_used : 1;
        // version_number must be 0 in the current WebP lossless spec.
        local byte version_number_vals[] = { 0 };
        byte version_number : 3 <values=version_number_vals>;
        BitfieldEnablePadding();
        read_size += 4;
        byte data[ReadSize - read_size];
}VP8LData <open=true>;

typedef struct VP8X {
    char Magic[4] = { "VP8X" };
    // Per the WebP spec the VP8X chunk payload is always 10 bytes.
    int ReadSize = { 10 };
    BigEndian();
    // Rsv (2 high bits) and R (low bit) are reserved and must be 0.
    local byte zero_bits[] = { 0 };
    byte Rsv: 2 <name="Reserved", values=zero_bits>;
    byte I: 1 <name="ICC profile">;
    byte L: 1 <name="Alpha">;
    byte E: 1 <name="Exif">;
    byte X: 1 <name="XMP">;
    byte A: 1 <name="Animation">;
    byte R: 1 <name="Reserved", values=zero_bits>;
    BitfieldDisablePadding();
    LittleEndian();
    // Rsv2 is a 24-bit reserved field; must be 0.
    local int rsv2_vals[] = { 0 };
    int Rsv2 :24 <values=rsv2_vals>;
    int ReadWidth :24<hidden=true>;
    int ReadHeight :24<hidden=true>;
    local int width = ReadWidth +1;
    local int height = ReadHeight +1;
    BitfieldEnablePadding();
    if(I)
    {
        char ICCP[4] = { "ICCP" };
        int ICCPChunkSize <min=1, max=1024>;
        byte ICCPData[ICCPChunkSize];
    }
    if(L)
    {
        char ALPH[4] = { "ALPH" };
        int ALPHChunkSize <min=1, max=1024>;
        byte ALPHData[ALPHChunkSize];
    }
    if(A)
    {
        // Animation chunk FourCC: must be "ANIM" (global) or "ANIF" (frame).
        // Both values are offered for generation, but the branch is selected
        // with a single-char test (ANI[3]) rather than two whole-string "=="
        // comparisons, which would make the generator collect exactly two
        // string values and emit an ambiguous char_array_class constructor.
        char ANI[4] = { "ANIM", "ANIF" };
        int ANIChunkSize <min=16, max=1024>;
        if(ANI[3] != 'F')   // "ANIM" - global animation parameters
        {
            uint BGColor;
            ushort LoopCount;
            byte ANIMData[ANIChunkSize - 6];
        }
        else                // "ANIF" - per-frame animation data
        {
            BitfieldDisablePadding();
            int FrameX :24;
            int FrameY :24;
            int ReadFrameWidth :24<hidden=true>;
            int ReadFrameHeight :24<hidden=true>;
            local int Framewidth = ReadFrameWidth +1;
            local int Frameheight = ReadFrameHeight +1;
            int Duration :24;
            // Rsv3 (6 bits) is reserved; must be 0.
            local byte rsv3_vals[] = { 0 };
            byte Rsv3:6 <values=rsv3_vals>;
            byte B: 1<name="Blending">;
            byte D: 1<name="Disposal">;
            BitfieldEnablePadding();
            byte ANIFData[ANIChunkSize - 16];
        }

    }
    // Embedded bitstream FourCC: must be "VP8 " (lossy) or "VP8L" (lossless).
    // Both values are offered, but the branch is selected with a single-char
    // test (ExtFormatTest[3]) rather than two whole-string "==" comparisons,
    // which would make the generator emit an ambiguous char_array_class
    // constructor. The embedded chunk's own Magic re-pins the same FourCC.
    char ExtFormatTest[4] = { "VP8 ", "VP8L" };
    FSkip(-4);
    if(ExtFormatTest[3] != 'L')   // "VP8 " - lossy
    {
        VP8Data Data<open=true>;
    }
    else                          // "VP8L" - lossless
    {
        VP8LData Data<open=true>;
    }
    if(E)
    {
        char EXIF[4] = { "EXIF" };
        int EXIFChunkSize <min=1, max=1024>;
        byte EXIFData[EXIFChunkSize];
    }
    if(X)
    {
        char XMP[4] = { "XMP " };
        int XMPChunkSize <min=1, max=1024>;
        byte XMPMetaData[XMPChunkSize];
    }

}VP8XData <open=true>;


struct HEADER {
    // RIFF container signature - fixed_value per constraints JSON.
    char Magic[4] = { "RIFF" };
    // ReadSize is patched to (file size - 8) after generation; see fixup below.
    int ReadSize<hidden=true>;
    local int FileSize = ReadSize+8;
    // RIFF form type - must be "WEBP".
    char Payload[4] = { "WEBP" };
    // Sub-format FourCC discriminator; restricted to the three valid values.
    char FormatStr[4] = { "VP8 ", "VP8L", "VP8X" };
    FSkip(-4);
    if(FormatStr == "VP8 "){
        local string format = "Lossy";
        VP8Data VP8data<open=true>;
    } else
    if(FormatStr == "VP8L"){
        local string format = "Lossless";
        VP8LData VP8Ldata<open=true>;
    } else
    if(FormatStr == "VP8X"){
        local string format = "Extended";
        VP8XData VP8Xdata<open=true>;
    }
}Header <open=true>;

// Declarative RIFF ReadSize fixup: rewrite the size field at offset 4 to
// (final_file_size - 8) so the container length always matches the payload.
local int64 _webp_end = FTell();
FSeek(4);
local int _webp_evil = SetEvilBit(false);
int ReadSize = { (int)(_webp_end - 8) };
SetEvilBit(_webp_evil);
FSeek(_webp_end);