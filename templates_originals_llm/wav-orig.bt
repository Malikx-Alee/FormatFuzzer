//------------------------------------------------
//--- 010 Editor v2.0 Binary Template
//
//      File: WAV.bt
//    Author: SweetScape Software, Paulo Max Gil I Reis
//   Version: 1.3 (FormatFuzzer generation-optimized)
//   Purpose: Parse and generate WAV audio files.
//  Category: Audio
// File Mask: *.wav
//  ID Bytes: 52 49 46 46 [+4] 57 41 56 45 //RIFF????WAVE
//
// FormatFuzzer modifications (derived from
// results_ai/wav-orig/llm_reterived_constraints_wav-orig_opus4.7.json):
//  - Hardcode WAVRIFFHEADER.groupID/riffType ("RIFF"/"WAVE") and every
//    chunk's 4-byte chunkID as fixed_value anchors.
//  - WAVRIFFHEADER.hsize is a calculated_value: patched at the very end
//    (via FSeek + SetEvilBit(false)) to FileSize()-8 once the whole file
//    has actually been written.
//  - FORMATCHUNK.wFormatTag/dwSamplesPerSec/wBitsPerSample are typed with
//    their enumerated_values sets; wChannels gets its range_constraint
//    [1, 8]. wFormatTag drops ADPCM (2) and EXTENSIBLE (65534): both need
//    extra bytes (a coefficient table, and a 22-byte cbSize/validBits/
//    channelMask/SubFormat-GUID block) that this fixed-field struct never
//    writes, so keeping them would claim a shape the template can't build
//    (the 18/40-byte chunkSize shapes the JSON also lists follow from the
//    same gap). wBitsPerSample's set is further narrowed by wFormatTag
//    (IEEE_FLOAT forced to 32, A-law/mu-law forced to 8) so those two tags
//    always produce a codec-valid header; PCM/DVI_IMA_ADPCM keep the full
//    {8,16,24,32} set. FORMATCHUNK.chunkSize is a calculated_value: it is
//    emitted as a placeholder and patched to the actual number of bytes
//    written for the chunk body (16, or 20 when the DVI_IMA_ADPCM extra
//    fields are present).
//  - FORMATCHUNK.dwAvgBytesPerSec/wBlockAlign are calculated_value fields.
//    Both live on the wire BEFORE wBitsPerSample (the value they depend
//    on), so they are written as placeholders and patched declaratively
//    once wBitsPerSample is known (dwAvgBytesPerSec = dwSamplesPerSec *
//    wBlockAlign, wBlockAlign = wChannels * wBitsPerSample / 8).
//  - DATACHUNK.chunkSize is a calculated_value in the JSON, but since it
//    already appears before the sample data it bounds, it is simply
//    generated as a real range-constrained field and used directly as the
//    array bound -- always self-consistent by construction, no patch-back
//    needed.
//  - FACTCHUNK.chunkSize (not itself an array bound in this template) is
//    likewise patched to the true body size (4 bytes) so a real reader
//    that trusts chunkSize to skip the chunk stays aligned.
//  - CUECHUNK/SMPLCHUNK's internal count fields (dwCuePoints,
//    Num_Sample_Loops) are range-constrained to keep their point/loop
//    arrays fuzzer-friendly instead of an unbounded 32-bit count, and both
//    chunks' own chunkSize is patched the same way as FACTCHUNK.
//  - LISTCHUNK's imperative `while (FTell()-pos < chunkSize)` byte-budget
//    loop -- which requires chunkSize to be known before its subchunks are
//    generated, and is exactly the kind of "consumption" loop that doesn't
//    generate well -- is replaced with a bounded declarative `for` loop
//    over a fixed MAX_SUBCHUNKS, after which chunkSize is patched to the
//    actual bytes written (same declarative-length idiom as the other
//    chunks). LISTSUBCHUNK.chunkSize keeps a small range_constraint so its
//    own listData[] array stays small.
//  - The main `while(!FEof())` chunk-dispatch loop, which relied on a raw
//    ReadBytes() tag peek with no ordering guarantees, is replaced with a
//    declarative ReadBytes(tag, pos, len, preferred[], possible[]) loop
//    (the same FormatFuzzer idiom used in the PNG/7z templates) that
//    enforces "fmt must come first" and removes each singleton chunk type
//    from the possible set once it has been emitted, so generated files
//    always have a valid, non-repeating chunk ordering with `fmt ` first.
//   History:
//   1.3   2026-07-26 FormatFuzzer generation-optimization pass.
//   1.2   2020-02-04 Paulo Max: Improved to correct parsing of DVI ADPCM and fix some issues in subchunk list parsing.
//   1.1   2015-10-05 SweetScape: Updated header for repository submission.
//   1.0   SweetScape: Initial release.
//
// More information available at:
//  https://en.wikipedia.org/wiki/WAV
//------------------------------------------------

// Record whether we have found a format chunk yet
local int haveValidFormat = false;

//-----------------------------------
// Define structures used in WAV files

// Stores the file header information
typedef struct
{
    char   groupID[4] = { "RIFF" };
    local int64 hsizePos = FTell();
    long   hsize;          // calculated_value: patched to FileSize()-8 at the end
    char   riffType[4] = { "WAVE" };
} WAVRIFFHEADER;

// Stores the format information for the file
typedef struct {
    char           chunkID[4] = { "fmt " };
    local int64 chunkStart = FTell();
    long           chunkSize;   // calculated_value: patched below
    local int64 pos = FTell();
    // EXTENSIBLE (65534) and ADPCM (2) are dropped from the
    // enumerated_values set: real WAVEFORMATEXTENSIBLE needs a 22-byte
    // cbSize/validBits/channelMask/SubFormat-GUID extension, and real
    // MS-ADPCM (2) needs a coefficient table sized off cbSize -- neither
    // extra shape is modelled by this struct (only DVI_IMA_ADPCM's simpler
    // wcbsize+wSamplesPerBlock extension is), so keeping them would (like
    // PCAP's ARP/IPv6) produce a tag that claims a shape this struct never
    // actually writes.
    unsigned short wFormatTag = { 1, 3, 6, 7, 17 };
    unsigned short wChannels <min=1, max=8>;
    unsigned long  dwSamplesPerSec = { 8000, 11025, 16000, 22050, 32000, 44100, 48000, 88200, 96000, 176400, 192000 };
    local int64 avgBytesPos = FTell();
    unsigned long  dwAvgBytesPerSec;  // calculated_value: patched below
    local int64 blockAlignPos = FTell();
    unsigned short wBlockAlign;       // calculated_value: patched below
    // wBitsPerSample's enumerated_values set is further narrowed by the
    // already-known wFormatTag (mirroring the PNG template's bit-depth
    // switch on color_type): IEEE_FLOAT is always 32-bit, A-law/mu-law are
    // always 8-bit companded samples, and PCM/DVI_IMA_ADPCM keep the full
    // JSON set. This keeps the two straightforward cases codec-valid; DVI
    // IMA ADPCM's own block-size math (which depends on wSamplesPerBlock
    // in a way this parser never modelled even before this pass) is out of
    // scope here, so a real decoder may still reject its payload even
    // though the container stays structurally well-formed.
    switch (wFormatTag) {
        case 3:
            unsigned short wBitsPerSample = { 32 };
            break;
        case 6:
        case 7:
            unsigned short wBitsPerSample = { 8 };
            break;
        default:
            unsigned short wBitsPerSample = { 8, 16, 24, 32 };
            break;
    }
    if (wFormatTag == 17) //DVI IMA ADPCM
    {
        unsigned short wcbsize = { 2 };  // fixed: byte count of the wSamplesPerBlock extension that follows
        unsigned short wSamplesPerBlock <min=1, max=8192>;
    }

    // Mark that we have found a valid format chunk
    haveValidFormat = true;

    // Patch the calculated fields now that wChannels/wBitsPerSample/
    // dwSamplesPerSec are all known.
    local int64 fmtEnd = FTell();
    local uint16 blockAlignVal = wChannels * wBitsPerSample / 8;
    local uint32 avgBytesVal = dwSamplesPerSec * blockAlignVal;
    local int evil = SetEvilBit(false);
    FSeek(blockAlignPos);
    unsigned short wBlockAlign = { blockAlignVal };
    FSeek(avgBytesPos);
    unsigned long  dwAvgBytesPerSec = { avgBytesVal };
    FSeek(chunkStart);
    long chunkSize = { (int)(fmtEnd - pos) };
    SetEvilBit(evil);
    FSeek(fmtEnd);

    // Padding so the next chunk starts on an even byte
    if( chunkSize & 1 )
        uchar padding;
} FORMATCHUNK;

// Stores the actual wave data
typedef struct
{
    char           chunkID[4] = { "data" };
    long           chunkSize <min=0, max=4096>;   // calculated_value in spirit: chosen up front, used directly below

    // Test if we have a valid format
    if( !haveValidFormat )
    {
        Warning( "File contains no valid WAVE format chunk." );
        return -1;
    }

    // Parse the samples of the data
    if( ((format.wBitsPerSample != 8) && (format.wBitsPerSample != 16) && (format.wBitsPerSample != 32))
        || format.wBlockAlign == 0 || (chunkSize % (int)format.wBlockAlign != 0) )
    {
        // Unsupported storage method used
        unsigned char  waveformData[chunkSize];
    }
    else if( (format.wChannels == 1) && (format.wBitsPerSample == 8) )
    {
        // Define an array of 8-bit samples - common case
        uchar samples[ chunkSize ];
    }
    else if( (format.wChannels == 1) && (format.wBitsPerSample == 16) )
    {
        // Define an array of 16-bit samples - common case
        short samples[ chunkSize/2 ];
    }
    else if( (format.wChannels == 1) && (format.wBitsPerSample == 32) )
    {
        // Define an array of 32-bit samples - common case
        int samples[ chunkSize/4 ];
    }
    else
    {
        // Define general case sample
        struct SAMPLES {
            if( format.wBitsPerSample == 8 )
                 uchar channels[ format.wChannels ];
            else if( format.wBitsPerSample == 16 )
                 short channels[ format.wChannels ];
            else if( format.wBitsPerSample == 32 )
                 int   channels[ format.wChannels ];
        } samples[ chunkSize / (int)format.wBlockAlign ];
    }

    // Padding so the next chunk starts on an even byte
    if( (chunkSize & 1) && (FTell() < FileSize()) )
        uchar padding;
} DATACHUNK;

// Stores the size of the wave after decompression
typedef struct
{
    char           chunkID[4] = { "fact" };
    local int64 chunkStart = FTell();
    long           chunkSize;    // calculated_value: patched below
    local int64 pos = FTell();
    unsigned long  uncompressedSize;

    local int evil = SetEvilBit(false);
    local int64 chunkEnd = FTell();
    FSeek(chunkStart);
    long chunkSize = { (int)(chunkEnd - pos) };
    SetEvilBit(evil);
    FSeek(chunkEnd);
} FACTCHUNK;

// Stores a list of cue points or markers to points in the data
typedef struct {
    long    dwIdentifier;
    long    dwPosition;
    char    fccChunk[4];
    long    dwChunkStart;
    long    dwBlockStart;
    long    dwSampleOffset;
} CUEPOINT;

typedef struct {
    char      chunkID[4] = { "cue " };
    local int64 chunkStart = FTell();
    long      chunkSize;   // calculated_value: patched below
    local int pos = FTell();
    long      dwCuePoints <min=0, max=8>;
    CUEPOINT  points[dwCuePoints];

    local int evil = SetEvilBit(false);
    local int64 chunkEnd = FTell();
    FSeek(chunkStart);
    long chunkSize = { (int)(chunkEnd - pos) };
    SetEvilBit(evil);
    FSeek(chunkEnd);
} CUECHUNK;

// Define a list chunk with a set of subchunks
typedef struct {
    char      chunkID[4];
    long      chunkSize <min=0, max=64>;
    char      listData[chunkSize];

    // Padding so the next chunk starts on an even byte
    if( (chunkSize & 1) && (FTell() < FileSize()) )
        uchar padding;
} LISTSUBCHUNK;

typedef struct {
    char      chunkID[4] = { "LIST" };
    local int64 chunkStart = FTell();
    long      chunkSize;    // calculated_value: patched below
    local quad pos = FTell();
    char      chunkType[4] = { "INFO" };

    // Bounded fuzzer-friendly subchunk list, replacing the original
    // `while (FTell()-pos < chunkSize)` byte-budget consumption loop (which
    // needs chunkSize to be known up front) with a small fixed count.
    local int MAX_SUBCHUNKS = 2;
    local int i;
    for (i = 0; i < MAX_SUBCHUNKS; i++)
        LISTSUBCHUNK subchunk;

    local int evil = SetEvilBit(false);
    local int64 chunkEnd = FTell();
    FSeek(chunkStart);
    long chunkSize = { (int)(chunkEnd - pos) };
    SetEvilBit(evil);
    FSeek(chunkEnd);

    // Padding so the next chunk starts on an even byte
    if( (chunkSize & 1) && (FTell() < FileSize()) )
        uchar padding;
} LISTCHUNK;

// A chunk which could not be identified
typedef struct {
    char      chunkID[4];
    long      chunkSize <min=0, max=64>;
    uchar     unknownData[chunkSize];

    // Padding so the next chunk starts on an even byte
    if( (chunkSize & 1) && (FTell() < FileSize()) )
        uchar padding;
} UNKNOWNCHUNK;

//---------------------------------------------
// SMPL / SMPL Loop
//---------------------------------------------

typedef long SMPLLOOPS_Cue_ID <read=WAV_SMPLLOOPS_Cue_ID>;

string
WAV_SMPLLOOPS_Cue_ID( SMPLLOOPS_Cue_ID cid )
{
    string  sret;
    SPrintf( sret, "Cue Point ID: %u", cid );

return sret;
}

//---------------------------------------------

typedef long SMPLLOOPS_Play_Count <read=WAV_SMPLLOOPS_Play_Count>;

string
WAV_SMPLLOOPS_Play_Count( SMPLLOOPS_Play_Count pc )
{
    string  sret;

    if (pc==0)
    {
        SPrintf( sret, " Infinite Sustain Loop (%u)", pc );
    }
    else
    {
        SPrintf( sret, "Play Count: %u", pc );
    }

return sret;
}


//---------------------------------------------
typedef long SMPLLOOPS_Start <read=WAV_SMPLLOOPS_Start>;

string
WAV_SMPLLOOPS_Start( SMPLLOOPS_Start st )
{
    string  sret;
    SPrintf( sret, "Loop Start at %u byte offset", st );

return sret;
}

