//------------------------------------------------
//--- 010 Editor v8.0 Binary Template
//
//      File: MP4.bt  (FormatFuzzer generation-optimized)
//   Purpose: Generate ISO Base Media (MP4/MOV) files.
//  Category: Video
// File Mask: *.mp4
//  ID Bytes: [4] 66 74 79 70 //....ftyp
//
// FormatFuzzer modifications (derived from
// results_ai/mp4-orig/llm_reterived_constraints_mp4-orig_opus4.7.json):
//
// The original template is a passive box-walker that trusts every box size and
// type. A fuzzer driving it emits broken sizes that run off the end of the
// buffer, so nothing it produces is a parseable MP4.
//
// This generation version emits a complete, self-consistent ISO-BMFF file with
// the full mandatory box tree for a single video track:
//   ftyp
//   moov ( mvhd, trak ( tkhd, mdia ( mdhd, hdlr, minf ( vmhd, dinf(dref),
//          stbl(stsd, stts, stsc, stsz, stco) ) ) ) )
//   mdat
// Every box 'size' is COMPUTED from the bytes actually written (each box writes
// a placeholder size, then patches it once its contents are complete); all box
// type FourCCs and the ftyp brands are pinned. Fuzzable: the movie/track
// timescale and duration and the visual width/height.
//------------------------------------------------

BigEndian();                          // ISO-BMFF is big-endian
local int evil = SetEvilBit(false);   // honour the pinned structural layout

// ===========================================================================
// ftyp
// ===========================================================================
local int64 ftypStart = FTell();
uint  ftypSize;                       // patched
char  ftypType[4]   = { "ftyp" };
char  majorBrand[4] = { "isom" };
uint  minorVersion  = { 0x200 };
char  compat0[4]    = { "isom" };
char  compat1[4]    = { "iso2" };
char  compat2[4]    = { "mp41" };
local int64 ftypEnd = FTell();
local uint ftypSizeVal = ftypEnd - ftypStart;
FSeek( ftypStart ); uint ftypSize = { ftypSizeVal }; FSeek( ftypEnd );

// Movie-wide timing (fuzzable, but kept self-consistent everywhere).
local uint TIMESCALE = 1000;
local uint DURATION  = 1000;          // 1 second

// ===========================================================================
// moov
// ===========================================================================
local int64 moovStart = FTell();
uint  moovSize;                       // patched
char  moovType[4] = { "moov" };

// ---- mvhd (movie header, version 0) ----
local int64 mvhdStart = FTell();
uint  mvhdSize;
char  mvhdType[4]   = { "mvhd" };
uint  mvhd_verflags = { 0 };
uint  mvhd_ctime    = { 0 };
uint  mvhd_mtime    = { 0 };
uint  mvhd_timescale = { TIMESCALE };
uint  mvhd_duration  = { DURATION };
uint  mvhd_rate     = { 0x00010000 };  // 1.0
ushort mvhd_volume  = { 0x0100 };      // 1.0
ushort mvhd_reserved = { 0 };
uint  mvhd_reserved2_0 = { 0 };
uint  mvhd_reserved2_1 = { 0 };
// unity matrix
uint  mvhd_m0 = { 0x00010000 }; uint mvhd_m1 = { 0 };          uint mvhd_m2 = { 0 };
uint  mvhd_m3 = { 0 };          uint mvhd_m4 = { 0x00010000 }; uint mvhd_m5 = { 0 };
uint  mvhd_m6 = { 0 };          uint mvhd_m7 = { 0 };          uint mvhd_m8 = { 0x40000000 };
uint  mvhd_pre0 = { 0 }; uint mvhd_pre1 = { 0 }; uint mvhd_pre2 = { 0 };
uint  mvhd_pre3 = { 0 }; uint mvhd_pre4 = { 0 }; uint mvhd_pre5 = { 0 };
uint  mvhd_next_track = { 2 };
local int64 mvhdEnd = FTell();
local uint mvhdSizeVal = mvhdEnd - mvhdStart;
FSeek( mvhdStart ); uint mvhdSize = { mvhdSizeVal }; FSeek( mvhdEnd );

// ---- trak ----
local int64 trakStart = FTell();
uint  trakSize;
char  trakType[4] = { "trak" };

// ---- tkhd (track header, version 0, flags = enabled|inMovie|inPreview) ----
local int64 tkhdStart = FTell();
uint  tkhdSize;
char  tkhdType[4]   = { "tkhd" };
uint  tkhd_verflags = { 0x00000007 };
uint  tkhd_ctime    = { 0 };
uint  tkhd_mtime    = { 0 };
uint  tkhd_track_id = { 1 };
uint  tkhd_reserved = { 0 };
uint  tkhd_duration = { DURATION };
uint  tkhd_reserved2_0 = { 0 };
uint  tkhd_reserved2_1 = { 0 };
ushort tkhd_layer   = { 0 };
ushort tkhd_altgroup = { 0 };
ushort tkhd_volume  = { 0 };           // 0 for video
ushort tkhd_reserved3 = { 0 };
uint  tkhd_m0 = { 0x00010000 }; uint tkhd_m1 = { 0 };          uint tkhd_m2 = { 0 };
uint  tkhd_m3 = { 0 };          uint tkhd_m4 = { 0x00010000 }; uint tkhd_m5 = { 0 };
uint  tkhd_m6 = { 0 };          uint tkhd_m7 = { 0 };          uint tkhd_m8 = { 0x40000000 };
ushort vWidth  <min=16, max=64>;       // fuzzable display width (integer part)
ushort vW_frac = { 0 };
ushort vHeight <min=16, max=64>;       // fuzzable display height
ushort vH_frac = { 0 };
local ushort imgW = vWidth;
local ushort imgH = vHeight;
local int64 tkhdEnd = FTell();
local uint tkhdSizeVal = tkhdEnd - tkhdStart;
FSeek( tkhdStart ); uint tkhdSize = { tkhdSizeVal }; FSeek( tkhdEnd );

// ---- mdia ----
local int64 mdiaStart = FTell();
uint  mdiaSize;
char  mdiaType[4] = { "mdia" };

// ---- mdhd (media header, version 0) ----
local int64 mdhdStart = FTell();
uint  mdhdSize;
char  mdhdType[4]   = { "mdhd" };
uint  mdhd_verflags = { 0 };
uint  mdhd_ctime    = { 0 };
uint  mdhd_mtime    = { 0 };
uint  mdhd_timescale = { TIMESCALE };
uint  mdhd_duration  = { DURATION };
ushort mdhd_language = { 0x55C4 };     // 'und'
ushort mdhd_predefined = { 0 };
local int64 mdhdEnd = FTell();
local uint mdhdSizeVal = mdhdEnd - mdhdStart;
FSeek( mdhdStart ); uint mdhdSize = { mdhdSizeVal }; FSeek( mdhdEnd );

// ---- hdlr (handler reference, 'vide') ----
local int64 hdlrStart = FTell();
uint  hdlrSize;
char  hdlrType[4]   = { "hdlr" };
uint  hdlr_verflags = { 0 };
uint  hdlr_predefined = { 0 };
char  hdlr_handler[4] = { "vide" };
uint  hdlr_reserved0 = { 0 };
uint  hdlr_reserved1 = { 0 };
uint  hdlr_reserved2 = { 0 };
char  hdlr_name[12] = { "VideoHandler" };
ubyte hdlr_name_nul = { 0 };
local int64 hdlrEnd = FTell();
local uint hdlrSizeVal = hdlrEnd - hdlrStart;
FSeek( hdlrStart ); uint hdlrSize = { hdlrSizeVal }; FSeek( hdlrEnd );

// ---- minf ----
local int64 minfStart = FTell();
uint  minfSize;
char  minfType[4] = { "minf" };

// ---- vmhd (video media header) ----
local int64 vmhdStart = FTell();
uint  vmhdSize;
char  vmhdType[4]   = { "vmhd" };
uint  vmhd_verflags = { 0x00000001 };
ushort vmhd_graphicsmode = { 0 };
ushort vmhd_op0 = { 0 };
ushort vmhd_op1 = { 0 };
ushort vmhd_op2 = { 0 };
local int64 vmhdEnd = FTell();
local uint vmhdSizeVal = vmhdEnd - vmhdStart;
FSeek( vmhdStart ); uint vmhdSize = { vmhdSizeVal }; FSeek( vmhdEnd );

// ---- dinf -> dref -> url ----
local int64 dinfStart = FTell();
uint  dinfSize;
char  dinfType[4] = { "dinf" };
local int64 drefStart = FTell();
uint  drefSize;
char  drefType[4]   = { "dref" };
uint  dref_verflags = { 0 };
uint  dref_entrycount = { 1 };
uint  url_size      = { 12 };
char  url_type[4]   = { "url " };
uint  url_verflags  = { 0x00000001 };  // self-contained, no URL string
local int64 drefEnd = FTell();
local uint drefSizeVal = drefEnd - drefStart;
FSeek( drefStart ); uint drefSize = { drefSizeVal }; FSeek( drefEnd );
local int64 dinfEnd = FTell();
local uint dinfSizeVal = dinfEnd - dinfStart;
FSeek( dinfStart ); uint dinfSize = { dinfSizeVal }; FSeek( dinfEnd );

// ---- stbl ----
local int64 stblStart = FTell();
uint  stblSize;
char  stblType[4] = { "stbl" };

// ---- stsd -> one VisualSampleEntry ('mp4v') ----
local int64 stsdStart = FTell();
uint  stsdSize;
char  stsdType[4]   = { "stsd" };
uint  stsd_verflags = { 0 };
uint  stsd_entrycount = { 1 };
local int64 vseStart = FTell();
uint  vseSize;
char  vseType[4]    = { "mp4v" };
ubyte vse_reserved[6];                 // = 0 (raw bytes, default 0 under evil-off)
ushort vse_dataref  = { 1 };
ushort vse_predefined0 = { 0 };
ushort vse_reserved2   = { 0 };
uint  vse_predefined1_0 = { 0 };
uint  vse_predefined1_1 = { 0 };
uint  vse_predefined1_2 = { 0 };
ushort vse_width    = { imgW };
ushort vse_height   = { imgH };
uint  vse_hres      = { 0x00480000 };  // 72 dpi
uint  vse_vres      = { 0x00480000 };
uint  vse_reserved3 = { 0 };
ushort vse_framecount = { 1 };
ubyte vse_compressorname[32];          // = 0
ushort vse_depth    = { 0x0018 };      // 24-bit colour
short  vse_predefined2 = { -1 };
local int64 vseEnd = FTell();
local uint vseSizeVal = vseEnd - vseStart;
FSeek( vseStart ); uint vseSize = { vseSizeVal }; FSeek( vseEnd );
local int64 stsdEnd = FTell();
local uint stsdSizeVal = stsdEnd - stsdStart;
FSeek( stsdStart ); uint stsdSize = { stsdSizeVal }; FSeek( stsdEnd );

// ---- stts / stsc / stsz / stco (empty sample tables) ----
local int64 sttsStart = FTell();
uint  sttsSize;
char  sttsType[4]   = { "stts" };
uint  stts_verflags = { 0 };
uint  stts_entrycount = { 0 };
local int64 sttsEnd = FTell();
local uint sttsSizeVal = sttsEnd - sttsStart;
FSeek( sttsStart ); uint sttsSize = { sttsSizeVal }; FSeek( sttsEnd );

local int64 stscStart = FTell();
uint  stscSize;
char  stscType[4]   = { "stsc" };
uint  stsc_verflags = { 0 };
uint  stsc_entrycount = { 0 };
local int64 stscEnd = FTell();
local uint stscSizeVal = stscEnd - stscStart;
FSeek( stscStart ); uint stscSize = { stscSizeVal }; FSeek( stscEnd );

local int64 stszStart = FTell();
uint  stszSize;
char  stszType[4]   = { "stsz" };
uint  stsz_verflags = { 0 };
uint  stsz_samplesize = { 0 };
uint  stsz_samplecount = { 0 };
local int64 stszEnd = FTell();
local uint stszSizeVal = stszEnd - stszStart;
FSeek( stszStart ); uint stszSize = { stszSizeVal }; FSeek( stszEnd );

local int64 stcoStart = FTell();
uint  stcoSize;
char  stcoType[4]   = { "stco" };
uint  stco_verflags = { 0 };
uint  stco_entrycount = { 0 };
local int64 stcoEnd = FTell();
local uint stcoSizeVal = stcoEnd - stcoStart;
FSeek( stcoStart ); uint stcoSize = { stcoSizeVal }; FSeek( stcoEnd );

// ---- close stbl, minf, mdia, trak, moov ----
local int64 p;
p = FTell(); local uint stblSizeVal = p - stblStart; FSeek( stblStart ); uint stblSize = { stblSizeVal }; FSeek( p );
p = FTell(); local uint minfSizeVal = p - minfStart; FSeek( minfStart ); uint minfSize = { minfSizeVal }; FSeek( p );
p = FTell(); local uint mdiaSizeVal = p - mdiaStart; FSeek( mdiaStart ); uint mdiaSize = { mdiaSizeVal }; FSeek( p );
p = FTell(); local uint trakSizeVal = p - trakStart; FSeek( trakStart ); uint trakSize = { trakSizeVal }; FSeek( p );
p = FTell(); local uint moovSizeVal = p - moovStart; FSeek( moovStart ); uint moovSize = { moovSizeVal }; FSeek( p );

// ===========================================================================
// mdat (media data; empty since the sample tables reference no samples)
// ===========================================================================
local int64 mdatStart = FTell();
uint  mdatSize;
char  mdatType[4] = { "mdat" };
local int64 mdatEnd = FTell();
local uint mdatSizeVal = mdatEnd - mdatStart;
FSeek( mdatStart ); uint mdatSize = { mdatSizeVal }; FSeek( mdatEnd );

SetEvilBit( evil );
