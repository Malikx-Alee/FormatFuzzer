//  ID Bytes: 53 51 4C 69 74 65 20 66 6F 72 6D 61 74 20 33 00 // SQLite format 3
//
// FormatFuzzer modifications (derived from
// results_ai/sqlite-orig/llm_reterived_constraints_sqlite-orig_opus4.7.json):
//  - Hardcode the 16-byte "SQLite format 3\0" magic as four pinned uint32 fields
//  - Replace page_size with SQLITE_PAGE_SIZE enum {1, 512, 1024, ..., 32768}
//  - Replace write_version/read_version with SQLITE_FILE_FORMAT enum {1, 2}
//  - Pin max_index_embed=64, min_index_embed=32, min_table_embed=32
//  - Constrain schema_file_format to [1..4]
//  - Replace text_encoding inline enum with typed SQLITE_TEXT_ENCODING
//  - Pin reserved[20] to all zeros via per-uint32 fixed assignments
//   History:
//   0.4   2026-06-16 FormatFuzzer generation-optimization pass.
//   0.3   2016-03-30 Andrew McRae: Updated header for repo
//   0.2   2016-01-18 Andrew McRae: Updated header for repo
//   0.1   2015-09-07 Andrew McRae: Initial revision
//------------------------------------------------

BigEndian();

// Power-of-two page sizes; value 1 represents 65536 bytes (SQLite convention).
typedef enum <ushort> {
    PS_64K = 1,
    PS_512 = 512,
    PS_1K  = 1024,
    PS_2K  = 2048,
    PS_4K  = 4096,
    PS_8K  = 8192,
    PS_16K = 16384,
    PS_32K = 32768
} SQLITE_PAGE_SIZE;

typedef enum <ubyte> {
    FF_LEGACY = 1,
    FF_WAL    = 2
} SQLITE_FILE_FORMAT;

typedef enum <uint> {
    UTF8    = 1,
    UTF16LE = 2,
    UTF16BE = 3
} SQLITE_TEXT_ENCODING;

typedef struct {
    SetBackColor( cLtBlue );
    // 0-15: 16-byte ASCII magic "SQLite format 3\0" pinned as four uint32 BE words.
    uint32 magic0 = { 0x53514C69 } <format=hex>; // "SQLi"
    uint32 magic1 = { 0x74652066 } <format=hex>; // "te f"
    uint32 magic2 = { 0x6F726D61 } <format=hex>; // "orma"
    uint32 magic3 = { 0x74203300 } <format=hex>; // "t 3\0"

    SQLITE_PAGE_SIZE page_size;                  // 16-17
    SQLITE_FILE_FORMAT write_version;            // 18
    SQLITE_FILE_FORMAT read_version;             // 19
    ubyte unused_page_space = { 0 };             // 20: normally 0
    ubyte max_index_embed   = { 64 };            // 21: must be 64
    ubyte min_index_embed   = { 32 };            // 22: must be 32
    ubyte min_table_embed   = { 32 };            // 23: must be 32

    uint change_count;                           // 24-27
    uint database_size;                          // 28-31
    uint freelist_trunk_page;                    // 32-35
    uint db_free_pages;                          // 36-39
    uint schema_cookie;                          // 40-43
    uint schema_file_format <min=1, max=4>;      // 44-47
    uint page_cache_size;                        // 48-51
    uint top_root_page;                          // 52-55
    SQLITE_TEXT_ENCODING text_encoding;          // 56-59
    uint user_version;                           // 60-63
    uint inc_vacuum;                             // 64-67
    uint application_id;                         // 68-71
    // 72-91: 20 reserved bytes pinned to zero (five uint32 BE words).
    uint32 reserved0 = { 0x00000000 } <format=hex>;
    uint32 reserved1 = { 0x00000000 } <format=hex>;
    uint32 reserved2 = { 0x00000000 } <format=hex>;
    uint32 reserved3 = { 0x00000000 } <format=hex>;
    uint32 reserved4 = { 0x00000000 } <format=hex>;
    uint version_valid_for;                      // 92-95
    uint sqlite_version_number;                  // 96-99
} DB_HEADER;

DB_HEADER db_h;